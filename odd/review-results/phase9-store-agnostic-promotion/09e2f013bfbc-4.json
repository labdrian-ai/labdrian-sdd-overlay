        "proof_refs": [
          "cmd_mcp.go:cards = nil; newEngramSource(store, cards)",
          "support_test.go:engram.NewSource(store, nil)"
        ]
      },
      {
        "id": "F2",
        "severity": "WARNING",
        "location": "longterm-mem/cmd/longterm-mem/app.go:98-112",
        "claim": "memorycardForLineage, and the inline copy in mcpPromote, treats only errors.Is(err, fs.ErrNotExist) as 'no memorycard database'. If memorycard.Open reports a missing database in any other way (for example a sqlite 'unable to open database file' error), then sync, promote and the MCP promote tool now refuse with exitEngramUnavailable or an error on machines with no memorycard. These commands worked on such machines before this change. Even when ErrNotExist is honoured, a present but unopenable memorycard database now blocks Engram-only sync and promote, which previously did not touch memorycard.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "app.go:case errors.Is(err, fs.ErrNotExist): return nil, exitOK",
          "app.go:return nil, a.refuse(err, exitEngramUnavailable)",
          "cmd_mcp.go:default: return mcpserver.PromoteOutcome{}, openErr"
        ]
      }
