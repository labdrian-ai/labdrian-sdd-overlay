        "severity": "WARNING",
        "location": "engine/runtime/labdrian-runtime-parity-plugin.mjs:483-488",
        "claim": "The engine's answer is now dropped silently when event.prompt is not a record or its text is not a string. Previously the answer was stored in session.promptLines and reached the model through the system prompt regardless of the prompt's shape. Nothing is logged or noted when the answer is dropped, so a UserPromptSubmit warning or context can vanish while the hook reports success. The prompt text sent to the engine is computed before this guard, so the two may come from different sources. An empty prompt text also yields a message that begins with a blank gap (\"\\n\\n...\").",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "engine/runtime/labdrian-runtime-parity-plugin.mjs:485-488"
        ]
      },
