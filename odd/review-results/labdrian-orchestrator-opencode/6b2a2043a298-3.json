    "findings": [
      {
        "id": "F1",
        "severity": "WARNING",
        "location": "engine/runtime/labdrian-runtime-parity-plugin.mjs:407",
        "claim": "The SessionStart answer is cached for the whole session as a promise, including a failed answer. If the engine times out or errors on the first model call, the session never retries and never gets its memory block; the guard context stays missing for the rest of the session. The 'not running' note is claimed only once, so later model calls get nothing. The cached note is also not the same as a prompt note: a failure claimed in promptSubmitted is stored in session.promptLines and re-pushed on every model call until the next prompt, so the 'told once' claim does not hold. A rejected promise would also be cached and rethrown every call, swallowed silently by the guard.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "engine/runtime/labdrian-runtime-parity-plugin.mjs:407",
          "engine/runtime/labdrian-runtime-parity-plugin.mjs:393-400"
        ]
      },
      {
        "id": "F2",
        "severity": "SUGGESTION",
        "location": "engine/runtime/labdrian-runtime-parity-plugin.mjs:367-369",
        "claim": "The session envelope uses process.cwd() as cwd, not the session's own directory. In a multi-project OpenCode process the engine could bind the wrong workflow, memory block or stop-hook repository for a session. The sessions map is also never pruned.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "engine/runtime/labdrian-runtime-parity-plugin.mjs:367-369"
        ]
      }
