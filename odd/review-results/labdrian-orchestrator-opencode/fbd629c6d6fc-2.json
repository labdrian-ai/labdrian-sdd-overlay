    "findings": [
      {
        "id": "F1",
        "severity": "SUGGESTION",
        "location": "engine/settings/codegraph_prompt.go:47-57",
        "claim": "The wrapper is matched only by exact string for the current hookCommand. If the engine binary path changes between installs, the old wrapper is neither detected by status (reported as 'no codegraph entry') nor restored by uninstall-hooks, and a later codegraph reinstall's bare entry gets a second wrapper, so the notification skip is configured twice. The old wrapper still falls back to codegraph when its binary is gone, so the harm is limited to a stale entry left behind.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "engine/settings/codegraph_prompt.go:47-57",
          "engine/settings/codegraph_prompt.go:22-25"
        ]
      }
    ],
    "evidence": [
      "Read the whole diff. The rewrite logic in rewriteCodegraphPrompt handles in-place replacement, removal of a bare entry beside a wrapper, and removal of an emptied entry correctly.",
      "In removeHooks, restoreCodegraphPrompt runs before the family removal loop, so a family matching on the engine binary path cannot remove the wrapper first.",
      "No change-caused regression was found for settings with no codegraph entry."
    ]
  }
