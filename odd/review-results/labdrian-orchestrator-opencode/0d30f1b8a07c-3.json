    "findings": [
      {
        "id": "F1",
        "severity": "WARNING",
        "location": "longterm-mem/internal/register/opencode.go:62-69",
        "claim": "Migration of the 1.x entry runs after jsonInstall has already overwritten the install-state record with the v2 fingerprint. If the legacy removal fails (I/O or splice error), register returns an error but the record that proved ownership of an older-binary 1.x entry is gone. A retry can then only match by canonical equality with the current binary's 1.x entry, so a 1.x entry written by an earlier binary path is never migrated and stays as an orphan.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "longterm-mem/internal/register/opencode.go:62-69",
          "longterm-mem/internal/register/opencode.go:58-61"
        ]
      },
      {
        "id": "F2",
        "severity": "WARNING",
        "location": "longterm-mem/internal/register/unregister.go:60-63",
        "claim": "unregister removes the recorded 1.x entry before jsonUninstall runs. If jsonUninstall then fails (for example, a foreign or untagged v2 entry is a conflict), the 1.x entry has already been deleted while the install-state record stays, so the operation is partial and not atomic. A failed unregister has changed the config.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "longterm-mem/internal/register/unregister.go:60-63"
        ]
      },
      {
        "id": "F3",
        "severity": "SUGGESTION",
        "location": "engine/runtime/longtermmem_config.go:103-109",
        "claim": "When the v2 entry is absent, the observer falls back to a 1.x mcp.longterm-mem. A foreign 1.x entry, which OpenCode v2 does not read, is then reported as a present non-owned entry (a foreign conflict) even though nothing registers in the v2 location. A stale owned 1.x entry for a different binary path is also reported as foreign rather than as migratable.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "engine/runtime/longtermmem_config.go:103-109"
        ]
      }
