        "id": "F2",
        "severity": "WARNING",
        "location": "engine/runtime/ownerrules.go:42-44",
        "claim": "Every locateOverlay failure with a blank OverlayDir (including a whitespace-only value, or a failure that is not 'no checkout') is mapped to ErrNoOverlayCheckout. Install then reports restart_required with only a note instead of partial. Previously such a case, such as a whitespace-only LABDRIAN_OVERLAY_DIR, may have been reported as an error; the config comment says the value is 'not trimmed or judged'. This can hide a misconfiguration.",
        "evidence_class": "inferential",
        "causal_disposition": "introduced",
        "proof_refs": [
          "engine/runtime/ownerrules.go:42-44"
        ]
      },
