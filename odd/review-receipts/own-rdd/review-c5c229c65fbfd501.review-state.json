              {
                "id": "R3-001",
                "lens": "reliability",
                "location": "engine/review/fsstore/held_linux.go:36-59",
                "severity": "WARNING",
                "claim": "Lock on linux is a flock on a directory fd opened O_RDONLY; flock is advisory and only serializes callers that also call Lock. Create called from non-blocking Verify paths (or from record) does not take the lock, so concurrent record runs are not serialized with verify. This is within the stated scope (verify vs verify), so it is only a note. Also, on filesystems where flock is unsupported (some NFS configurations) the error is returned and verify of a blocking verdict fails closed rather than degrading, which is acceptable but untested.",
                "proof_refs": [
                  "engine/review/fsstore/held_linux.go:36-59"
                ],
                "evidence_class": "inferential",
                "causal_disposition": "introduced"
              },
