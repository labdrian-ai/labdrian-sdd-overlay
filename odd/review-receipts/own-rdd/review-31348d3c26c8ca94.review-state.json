            "findings": [
              {
                "id": "R2-ordering-doc",
                "lens": "readability",
                "location": "engine/reviewresult/wire.go:115-125",
                "severity": "WARNING",
                "claim": "The package comment and README say Parse applies its rules in a fixed order and reports the first one broken. checkShape walks the findings one at a time and returns ErrMissingID for a finding with no id as soon as it reaches it. A later finding that has an unknown member (rule 3) or a null member (rule 2) is therefore never reached. The reply is refused as ErrMissingID, a rule the documented order puts after those. Refusal is still deterministic, but the documented ordering does not match the code, and a maintainer who relies on it when adding a rule will be misled. The fix is to document the exception, or to check the id after all shape checks have run.",
                "proof_refs": [
                  "engine/reviewresult/wire.go:115-125",
                  "engine/reviewresult/reviewresult.go:9-35"
                ],
                "evidence_class": "deterministic",
                "causal_disposition": "introduced"
              }
            ],
            "evidence": [
              "Read the full patch of all 17 manifest paths.",
              "Checked the documented rule order in reviewresult.go and odd/review-results/README.md against the control flow of wire.go and rules.go.",
              "Found no dead or duplicated logic that hides a defect. The strictObject/object/require split in wire.go is slightly redundant but correct."
            ]
          }
        }
