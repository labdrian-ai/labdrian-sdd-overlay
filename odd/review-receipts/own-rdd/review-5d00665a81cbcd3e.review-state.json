            "lens": "review-resilience",
            "findings": [
              {
                "id": "R4-001",
                "lens": "resilience",
                "location": "engine/review/fsstore/fsstore.go:213-213",
                "severity": "WARNING",
                "claim": "Read opens the file with os.Open, which blocks on a FIFO swapped in between Lstat and Open (a race window). The SameFile check only runs after Open returns, so a hostile checkout that swaps in a FIFO could hang the verifier indefinitely. Narrow race and requires local write access to the results directory, so this is only a hardening note (O_NONBLOCK or O_NOFOLLOW would close it).",
                "proof_refs": [
                  "engine/review/fsstore/fsstore.go:213"
                ],
                "evidence_class": "inferential",
                "causal_disposition": "introduced"
              }
            ],
            "evidence": [
              "Reviewed all 5 changed paths in full. Read is bounded by review.MaxStoredBytes via LimitReader, so memory use is capped; missing-file, non-regular-file, oversize and changed-directory cases all return typed errors without partial bytes. Read is idempotent and side-effect free, so retries are safe. The only resilience concern is the small Lstat-to-Open race with a FIFO, which needs local write access to the results directory."
            ]
          }
        }
