            "findings": [
              {
                "id": "R4-001",
                "lens": "resilience",
                "location": "engine/review/app/service.go:112-132",
                "severity": "WARNING",
                "claim": "store retries on ErrExists up to 16 times, each time re-listing the directory with no backoff. Under heavy contention it could return ErrNoFreeNumber after the reply was validated, losing the reviewer's reply. The retry is bounded and safe (Create is atomic and never replaces), so this is a minor degradation risk, not a defect.",
                "proof_refs": [
                  "engine/review/app/service.go:112-132"
                ]
              },
              {
                "id": "R4-002",
                "lens": "resilience",
                "location": "engine/review/app/service.go:47-52",
                "severity": "WARNING",
                "claim": "Bind checks worktree state and then calls AddWorktree non-atomically. Two concurrent binds of the same head can both see the path absent, and the loser's AddWorktree fails with a raw git error rather than falling back to reuse. The failure is clean (no corruption) and a rerun reuses the worktree, so it is a minor retry-safety gap.",
                "proof_refs": [
                  "engine/review/app/service.go:47-52"
                ]
              }
            ],
            "evidence": [
              "Read all six changed paths. The package is new, so no baseline behavior regresses.",
              "Record validates before the first write and Create is atomic and never replaces a file, so a refused or failed reply leaves no partial file.",
              "Bind makes the worktree only after the candidate is bound, so a candidate that cannot be bound leaves no directory behind.",
              "Failures from git and the store are wrapped with %w, so the cause stays visible. The tests cover these paths.",
              "No BLOCKER or CRITICAL production failure mode was found."
            ]
          }
        }
