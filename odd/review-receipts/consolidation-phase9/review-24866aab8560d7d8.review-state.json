            "lens": "review-resilience",
            "findings": [
              {
                "id": "R4-001",
                "lens": "resilience",
                "location": "engine/reviewreceipt/service.go:243-246",
                "severity": "WARNING",
                "claim": "In the ambiguous-change hook path, an unreadable or malformed odd/review-receipts folder now makes the hook deny with an error. Previously the hook did not depend on that folder. The error only occurs when a receipt is persisted under no change, which was already a deny at the baseline, so it only changes the denial message and does not turn an allow into a deny. Features() also lists every directory, so a stray directory with an unsafe name (for example one with trailing whitespace) makes the check return an error before any valid feature is considered. The effect is a denial with a different reason, not a new block.",
                "proof_refs": [
                  "engine/reviewreceipt/service.go:243-246",
                  "engine/reviewreceipt/fsstore/store.go:268-284"
                ],
                "evidence_class": "inferential",
                "causal_disposition": "introduced"
              }
            ],
            "evidence": [
              "Checked the new capture --feature path and the Destination plumbing. Writes stay atomic, idempotent and never overwrite a differing file.",
              "Checked that the feature name is validated before any sink access. Both flags together are refused before the service is built.",
              "Checked the hook. The single-change and zero-change branches never call Features(). The multi-change branch lists feature folders only after the per-change check fails. Every failure there is a denial, so the hook fails closed.",
              "No BLOCKER or CRITICAL resilience regression found for state that was valid at the baseline."
            ]
          }
        }
