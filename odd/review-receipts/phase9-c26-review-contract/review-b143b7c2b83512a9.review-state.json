            "lens": "review-risk",
            "findings": [
              {
                "id": "R1-001",
                "lens": "risk",
                "location": "engine/review/app/launch.go:126-127",
                "severity": "WARNING",
                "claim": "The re-ask uses a fenced block sized to the longest backtick run in the quoted refusal, which mitigates prompt-injection via fence escape. However, the quoted refusal is truncated to 1024 bytes after the fence length is computed from the truncated text, so this is consistent; residual risk is only that the refusal may echo candidate content that the model treats as evidence, which the system prompt explicitly addresses. No reachable exploit shown.",
                "proof_refs": [
                  "engine/review/app/launch.go:126-127",
                  "engine/review/claudeprint/claudeprint.go:32-35"
                ]
              }
            ],
            "evidence": [
              "Reviewed all 17 changed paths. The change removes reading of the deployed Claude agent file (no more filesystem reads from the Claude root), replaces it with an embedded preamble and compile-time schema constant, so the attack surface for untrusted file content is reduced.",
              "The re-ask path now fences the quoted refusal with a fence longer than any backtick run in it, preventing the echoed reply from closing the fence and injecting instructions; a test covers this.",
              "The claude process still runs with --tools empty, dontAsk permission mode, no setting sources and strict MCP config, unchanged from baseline.",
              "The bench script change only alters the brief text built from jq with --arg, which safely quotes values; no new shell injection.",
              "No secrets, dependency changes, or authorization logic are touched."
            ]
          }
        }
