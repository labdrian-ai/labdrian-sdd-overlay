            "lens": "review-reliability",
            "findings": [
              {
                "id": "R3-empty-location-reask",
                "lens": "reliability",
                "location": "engine/review/app/launch.go:103-107",
                "severity": "SUGGESTION",
                "claim": "ErrInvalidLocation is added to shapeRefusals, so a bad location triggers one re-ask. This is covered by a launch test. The re-ask quotes the refusal, which includes the offending location, so the reviewer can fix it. Nothing is broken. One small gap remains: the launch test only checks the re-ask path where the second reply is valid. No test shows that a second reply with a bad location is refused without a third ask. That behavior comes from the existing two-attempt logic, so the risk is low.",
                "proof_refs": [
                  "engine/review/app/launch_test.go:191-207",
                  "engine/review/app/launch.go:103-107"
                ]
              }
            ],
            "evidence": [
              "Record calls Parse, then CheckLocations. A refusal is wrapped in ReplyRefusedError, so the exit-2 path is the same as for other refused replies. record_test.go and review_test.go cover this.",
              "CheckLocations is kept out of Parse, so stored results with a bad location stay readable by verify and check. engine/cmd/review_check_test.go and engine/reviewresult/rules_test.go cover this.",
              "The location regexp matches the reviewer schema pattern, and the table-driven tests cover the line, range, zero, open range, no path and empty cases.",
              "The README, usage.sh and usage.go text changes match the new behavior."
            ]
          }
