# ---------------------------------------------------------------------------

cmd_gadu_generate() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    die "engine binary not found at $ENGINE_BINARY; run 'overlay install-hooks' first"
  fi
  exec env OVERLAY_DIR="$OVERLAY_DIR" "$ENGINE_BINARY" gadu-generate "$@"
}

# ---------------------------------------------------------------------------
# longterm-mem (D4, D13, R-014/R-015)
# ---------------------------------------------------------------------------

# engine_stale_diagnosis prints the sentence a reader cannot reconstruct on
# their own: that an unknown flag / unknown subcommand error coming OUT OF THE
# ENGINE is this staleness and not an overlay bug. That mistaken reading, not
# the staleness itself, is what made the original incident expensive, so every
# operator-facing report of a stale binary uses this one text.
#
# It names 'doctor --fix' as the remedy, not 'install-hooks': the repair the
# reader wants here is the engine binary, not a rewrite of settings.json.
engine_stale_diagnosis() {
  printf '%s' "engine binary at $ENGINE_BINARY is STALE — older than the engine source at $ENGINE_SRC, so it may not understand the flags and subcommands this overlay passes it. If a command fails with an unknown flag or unknown subcommand error from the engine, that is this staleness, not an overlay bug. Rebuild it with 'overlay doctor --fix'."
}

# engine_binary_is_stale answers whether any Go source under $ENGINE_SRC is
# NEWER than $ENGINE_BINARY, i.e. whether the compiled artifact predates the
# source that defines it.
#
# The signal is mtime, not a recorded git revision, because mtime catches BOTH
# a repository update (git stamps the files it writes) and an uncommitted
# local edit during development; a recorded revision catches only the first.
#
# go.mod and go.sum count as source: a dependency bump changes behaviour as
# surely as a source edit does.
#
# The find expression is deliberately plain POSIX. `-newer` is portable, but
# `-print -quit` is GNU-only, and this script goes out of its way to stay
# macOS-safe (see the mkdir-not-flock reasoning in the install-tracking lock),
# so the "stop at the first hit" job goes to head instead.
engine_binary_is_stale() {
  [[ -d "$ENGINE_SRC" ]] || return 1
  # The listing is captured whole rather than piped into `head -n 1`, for the
  # reason this file already records twice elsewhere ("Pre-build tar listing
  # once to avoid SIGPIPE issues with set -euo pipefail"): under pipefail a
  # `find | head` whose output exceeds the pipe buffer leaves find killed by
  # SIGPIPE and the substitution exiting 141, which errexit turns into an
  # abort at any call site that is not a condition. Today the only call site
  # IS a condition, so the hazard is latent -- and a fixture-sized source tree
  # never reaches the buffer, so no test can catch it either. Both of those
  # are reasons to write it safely now rather than to rely on staying lucky.
  # An engine source tree is small; reading all of it costs nothing.
  local newer
  newer="$(
    find "$ENGINE_SRC" -type f \
      \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) \
      -newer "$ENGINE_BINARY" -print 2>/dev/null
  )"
  [[ -n "$newer" ]]
}

# ensure_engine_binary builds $ENGINE_BINARY on demand if it is missing,
# mirroring the existing cmd_uninstall_hooks fallback above — cmd_longterm_mem
# needs the same binary to invoke 'engine runtime --component longterm-mem'.
#
# It also rebuilds when the binary is merely OUT OF DATE. Building only on
# absence is what let a fast-forwarded repository keep running an eleven-day-old
# engine against new expectations, until an overlay command died with
# `unknown flag "--component"` — which reads as an overlay bug and is a binary
# that predates the subcommand.
#
# This is the ONLY place that check lives, and it must stay that way. Every
# path that needs the engine already calls ensure_engine_binary, so one
# mechanism covers them all; adding the same check to self-update or apply
# would be two mechanisms to drift apart, not one safety net plus a backup.
#
# WHEN STALE AND NOT REBUILDABLE the function WARNS AND CONTINUES, which is a
# deliberate departure from the absent-binary path immediately above it:
#   - an absent binary means nothing can run at all, so dying is the only
#     option there;
#   - a stale binary may well serve the command at hand perfectly, and
#     refusing would brick every overlay command for a user whose Go toolchain
#     disappeared;
#   - what made this defect expensive was never the staleness itself, it was
#     that the resulting failure looked like an overlay bug. So the warning
#     names the staleness, PREDICTS the symptom (an unknown flag or unknown
#     subcommand error coming out of the engine is this, not a bug), and says
#     how to fix it.
# That loud, diagnosed warning is NOT the silent skip this repository keeps
# removing — a skip that reads as a pass is. Do not "tighten" this into a hard
# failure without understanding that trade.
ensure_engine_binary() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    command -v go >/dev/null 2>&1 || die "engine binary not found at $ENGINE_BINARY and go is not installed; cannot continue"
    [[ -d "$ENGINE_SRC" ]] || die "engine source not found at $ENGINE_SRC"
    info "Engine binary not found; building..."
    mkdir -p "$(dirname "$ENGINE_BINARY")"
    (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/) \
      || die "go build failed for the engine binary"
    return 0
  fi

  engine_binary_is_stale || return 0

  local stale_warning="the engine binary at $ENGINE_BINARY is OLDER than the engine source at $ENGINE_SRC, so it may not understand the flags and subcommands this overlay passes it. If a command below fails with an unknown flag or unknown subcommand error from the engine, that is this staleness, not an overlay bug. Fix it with 'overlay install-hooks', or by installing a Go toolchain so the overlay can rebuild the engine itself."

  if ! command -v go >/dev/null 2>&1; then
    warn "Engine binary is stale and go is not installed: $stale_warning"
    return 0
  fi

  info "Engine binary is out of date; rebuilding..."
  if ! (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/); then
    warn "Engine binary is stale and the rebuild failed: $stale_warning"
    return 0
  fi
}

# longtermmem_installed_targets_known <line> answers whether <line> names a
# target THIS BUILD can actually install longterm-mem for. It gates the
# WRITE side only (longtermmem_installed_targets_add): this entrypoint
# refuses to record a target it cannot install for.
#
# It is deliberately NOT the read-side filter. See
# longtermmem_target_name_is_wellformed below for why those are two
# different questions.
longtermmem_installed_targets_known() {
  local candidate="${1:-}" known
  for known in "${!TARGET_PATHS[@]}"; do
    if [[ "$candidate" == "$known" ]]; then
      return 0
    fi
  done
  return 1
}

# longtermmem_target_name_is_wellformed <line> answers whether <line> is a
# plausible target NAME — a short bare word — regardless of whether this
# build knows that name.
#
# This is the read-side filter, and the distinction it draws is the whole
# safety property of the tracking file. The file is read as EVIDENCE, not as
# text: a non-empty read is what keeps longtermmem_maybe_remove_binary from
# deleting a binary a still-installed runtime depends on. So the reader has
# to sort its input into two piles that are NOT the same pile:
#
#   GARBAGE — a NUL byte, an unterminated partial line, a token that is not
#   a bare word. None of these can have been written by this script (every
#   write here is one newline-terminated bare word), so none is install
#   state. Dropping them is what keeps a hand edit or a torn write from
#   wedging the guard permanently, with no way to clear it short of deleting
#   the file by hand.
#
#   A WELL-FORMED NAME THIS BUILD DOES NOT KNOW — "zed", say. This looks
#   exactly like something this script wrote, because the likeliest way it
#   got there is that a NEWER build wrote it: one that installs for a
#   runtime this build has never heard of. That runtime is running the
#   SHARED binary right now. Dropping it reads "nothing is installed" and
#   deletes the binary out from under a live runtime — the exact failure the
#   guard exists to prevent, arrived at through the mechanism meant to
#   prevent it.
#
# So garbage is droppable and an unknown name is not. Only the first pile is
# provably not install state; the second is install state this build cannot
# interpret, and the safe reading of "I do not understand this" is to leave
# the shared binary alone.
#
# The 64-byte cap is part of "bare word": a target name is a short
# identifier, and without a bound a long run of alphanumerics inside a
# binary file would read as a name and hold the guard closed forever.
longtermmem_target_name_is_wellformed() {
  local candidate="${1:-}"
  [[ "$candidate" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

# longtermmem_installed_targets_read prints the currently tracked installed
# targets (see LONGTERM_MEM_INSTALLED_TARGETS above), one per line, sorted
# and deduplicated; empty output when none are tracked or the file does not
# exist yet.
#
# It emits every WELL-FORMED name, known to this build or not, and drops
# only garbage — see longtermmem_target_name_is_wellformed for why those are
# different answers. Callers use the result as "is anything still
# installed", never as "here is a target to act on"; the one place a name is
# acted on (add) validates it against TARGET_PATHS itself.
#
# Two details are load-bearing and neither is obvious:
#
#   NUL bytes are translated to \001 before the loop rather than left to
#   bash. A bash variable CANNOT hold a NUL, so `read` silently drops it —
#   which would turn "\0zed", provably a torn write, into "zed", a name that
#   holds the guard closed forever. \001 cannot appear in a bare word, so
#   the name check rejects the line for the right reason.
#
#   An unterminated final line is DROPPED, not kept. Every write here is
#   newline-terminated, so trailing bytes with no newline are a partial
#   write — a name still being written, not a name. The previous loop's
#   `|| [[ -n "$line" ]]` kept it.
#
# Deduplication happens HERE rather than on write, which is what lets the
# write side be a single atomic append instead of a read-modify-write.
longtermmem_installed_targets_read() {
  [[ -f "$LONGTERM_MEM_INSTALLED_TARGETS" ]] || return 0

  # A file that EXISTS but cannot be READ is the third pile, and it belongs
  # with the unknown name, not with the garbage: it may well list every
  # runtime still depending on the shared binary, and a permission error
  # says nothing either way. So it reports FAILURE rather than emptiness —
  # every caller below distinguishes the two, because "I could not look" and
  # "I looked and there is nothing" lead to opposite actions on a shared
  # binary. (The read goes through a process substitution, whose failure a
  # redirect's would not: without this the loop just sees EOF.)
  if [[ ! -r "$LONGTERM_MEM_INSTALLED_TARGETS" ]]; then
    warn "longterm-mem: $LONGTERM_MEM_INSTALLED_TARGETS exists but cannot be read; refusing to read it as empty install state"
    return 1
  fi

  local line read_status
  while true; do
    read_status=0
    IFS= read -r line || read_status=$?
    if [[ "$read_status" -ne 0 ]]; then
      # EOF. Anything `read` left in $line arrived without a terminating
      # newline: a partial write, never install state.
      break
    fi
    if longtermmem_target_name_is_wellformed "$line"; then
      printf '%s\n' "$line"
    fi
  done < <(LC_ALL=C tr '\000' '\001' < "$LONGTERM_MEM_INSTALLED_TARGETS") | sort -u
  return 0
}

# longtermmem_installed_targets_add <target> records <target> as installed
# (idempotent).
#
# The record is appended, never rewritten. A read-modify-write through a
# single FIXED shared temporary path — which is what this used to do — is
# the worst of both worlds under two concurrent overlay runs: both truncate
# the same staging file, so one run's `mv` can publish the other run's
# half-written content, or fail outright because the other already renamed
# it away. A short O_APPEND write is atomic, so two runs recording DIFFERENT
# targets at the same time both land, with no lock and no staging file at
# all.
#
# The "already recorded" check is what keeps the file from growing by one
# line per apply run; a duplicate can still appear if two runs append the
# same target at once, and longtermmem_installed_targets_read collapses it.
longtermmem_installed_targets_add() {
  local target="$1"
  longtermmem_installed_targets_known "$target" \
    || die "longterm-mem: refusing to record an unknown install target: $target"

  local dir
  dir="$(dirname "$LONGTERM_MEM_INSTALLED_TARGETS")"
  mkdir -p "$dir" || die "longterm-mem: could not create $dir"

  # The lock covers the READ as well as the write. An append is atomic on its
  # own, but the "already recorded" check below is not: it reads, decides, and
  # only then appends, and a concurrent REWRITE (remove, or the guard's
  # cleanup) landing in that window publishes state that never saw this
  # append. Locking only the append would reproduce the exact lost update it
  # is meant to fix.
  longtermmem_targets_lock_acquire
  trap 'longtermmem_targets_lock_release' RETURN

  # An unreadable tracking file makes the "already recorded" check below
  # meaningless: it would answer "not recorded" and append a duplicate to a
  # file it cannot see. Say so instead of appending blind.
  local tracked
  tracked="$(longtermmem_installed_targets_read)" \
    || die "longterm-mem: could not read $LONGTERM_MEM_INSTALLED_TARGETS; refusing to record $target against install state that cannot be inspected"
  if [[ $'\n'"$tracked"$'\n' == *$'\n'"$target"$'\n'* ]]; then
    return 0
  fi

  printf '%s\n' "$target" >> "$LONGTERM_MEM_INSTALLED_TARGETS" \
    || die "longterm-mem: could not record $target in $LONGTERM_MEM_INSTALLED_TARGETS"
}

# longtermmem_installed_targets_remove <target> un-records <target>.
#
# Removal cannot be an append, so this one does stage and rename — through a
# PER-PROCESS mktemp in the SAME directory (the pattern the binary deploy
# below already uses), so the rename stays an atomic same-filesystem
# operation and two concurrent runs can no longer truncate each other's
# staging file.
#
# It rewrites from longtermmem_installed_targets_read, so a file that had
# picked up garbage is also compacted back to valid install state here.
#
# The read and the rename are ONE critical section, held under the
# installed-targets lock: this is a real read-modify-write, so a concurrent
# `add` landing between them used to be dropped outright. Concurrent overlay
# invocation is now answered rather than avoided — it is serialized.
longtermmem_installed_targets_remove() {
  local target="$1"
  [[ -f "$LONGTERM_MEM_INSTALLED_TARGETS" ]] || return 0

  local dir
  dir="$(dirname "$LONGTERM_MEM_INSTALLED_TARGETS")"
  mkdir -p "$dir" || die "longterm-mem: could not create $dir"

  longtermmem_targets_lock_acquire
  trap 'longtermmem_targets_lock_release' RETURN

  # Read BEFORE staging anything. This function rewrites the file from what
  # the reader returns, so a reader that answered "empty" for a file it could
  # not read would not merely misreport it — it would TRUNCATE it, destroying
  # the very state that keeps the binary-removal guard closed.
  local kept
  kept="$(longtermmem_installed_targets_read)" \
    || die "longterm-mem: could not read $LONGTERM_MEM_INSTALLED_TARGETS; refusing to rewrite it from a file that could not be inspected"

  local tmp
  tmp="$(mktemp "$dir/.installed-targets.XXXXXX")" \
    || die "longterm-mem: could not create a temporary file in $dir"

  local filter_exit=0
  printf '%s' "$kept" | grep -v -x -F -e "$target" > "$tmp" || filter_exit=$?
  # grep exits 1 when it selects nothing, which is the ordinary "that was
  # the last tracked target" case; anything above 1 is a real error.
  if [[ "$filter_exit" -gt 1 ]]; then
    rm -f "$tmp"
    die "longterm-mem: could not rewrite $LONGTERM_MEM_INSTALLED_TARGETS"
  fi

  mv "$tmp" "$LONGTERM_MEM_INSTALLED_TARGETS" || {
    rm -f "$tmp"
    die "longterm-mem: could not update $LONGTERM_MEM_INSTALLED_TARGETS"
  }
}

# longtermmem_maybe_remove_binary implements the R-014/D4 binary-removal
# guard (10b.5): the binary is removed ONLY when no install-state target
# remains tracked (i.e. a "--target all" uninstall, or the last remaining
# single-target uninstall, emptied the tracking file), or when --purge was
# passed. This is the dangerous half of the guard: getting it backwards
# would delete a binary a still-installed target depends on — proven by the
# negative test TestStatusUninstall_SkipBuildStep/UninstallSingleTarget...
# (uninstalling one target while another remains installed leaves the
# binary in place).
#
# Every way of NOT KNOWING what is installed leaves the binary alone, and
# there are three of them, only one of which is about the file's contents:
# no tracking file at all ($tracking_known, set by the caller), a tracking
# file that could not be read (below), and a line inside it that this build
# cannot interpret (longtermmem_target_name_is_wellformed). --purge is the
# single explicit override for all three.
longtermmem_maybe_remove_binary() {
  local purge="$1"

  # The third writer of the tracking file, and the easiest one to miss: it
  # reads the file and then DELETES it, which is a read-modify-write like any
  # other. Unserialized, a concurrent `add` landing between the two would be
  # erased along with the file, leaving a runtime registered against a binary
  # this call just removed.
  longtermmem_targets_lock_acquire
  trap 'longtermmem_targets_lock_release' RETURN

  local remaining readable=1
  remaining="$(longtermmem_installed_targets_read)" || readable=""

  if [[ -z "$readable" ]] && [[ -z "$purge" ]]; then
    warn "longterm-mem: the install tracking file could not be read, so whether any runtime still depends on the shared binary is unknown; leaving $LONGTERM_MEM_BINARY in place. Fix its permissions and re-run uninstall, or pass --purge to remove it anyway."
    return 0
  fi

  if [[ -n "$purge" ]] || { [[ -n "$tracking_known" ]] && [[ -z "$remaining" ]]; }; then
    if [[ -e "$LONGTERM_MEM_BINARY" ]]; then
      rm -f "$LONGTERM_MEM_BINARY"
      info "longterm-mem binary removed: $LONGTERM_MEM_BINARY"
    else
      info "longterm-mem binary already absent: $LONGTERM_MEM_BINARY"
    fi
    rm -f "$LONGTERM_MEM_INSTALLED_TARGETS"
  fi
}

# longtermmem_install_step runs cmd_apply's D13 "install once per apply
# invocation" step and reports whether it succeeded, printing the recovery
# line itself when it did not.
#
# The call is wrapped in a SUBSHELL deliberately. cmd_longterm_mem and the
# helpers it reaches report unrecoverable problems through `die` — the
# script-wide convention, used in dozens of places — and `die` exits the
# PROCESS. Invoked directly as `if ! cmd_longterm_mem install`, that took
# the entire apply run down with it, so the recovery line below, which
# exists precisely to explain a failed install, was unreachable for the
# likeliest failures: no go toolchain, no longterm-mem module, a failed
# build, an unresolvable --target, a missing engine binary.
#
# A subshell turns die's exit into an observable status at exactly this one
# call site, and it does so without rewriting `die` into a dual-mode
# "return when I am a callee" that every one of its call sites would then
# have to honour correctly. Nothing is lost to the subshell: every effect of
# this step lands on the filesystem, never in shell state the caller reads.
#
# Note that the subshell does NOT restore errexit inside the callee — bash
# suppresses it for the whole condition context either way — which is why
# the install path checks each of its own deploy steps explicitly.
longtermmem_install_step() {
  local target_arg="$1"
  local status=0
  ( cmd_longterm_mem install --target "$target_arg" ) || status=$?
  if [[ "$status" -ne 0 ]]; then
    warn "longterm-mem install FAILED after per-target state was already written: the MCP server is not installed. Target state now records a successful deploy, so re-running apply will NOT retry this step — run 'labdrian-overlay longterm-mem install --target $target_arg' directly."
  fi
  return "$status"
}

# cmd_longterm_mem implements 'longterm-mem install|status|uninstall
# [--target claude|opencode|codex|all] [--purge]' (D4, D13).
#
# install: go build the longterm-mem binary, copy it to the fixed path
# (LONGTERM_MEM_BINARY, R-015), then per target: 'longterm-mem register
# --target t --binary "$LONGTERM_MEM_BINARY"' (module-owned, writes the
# ownership-tagged MCP entry and its install-state.json record at the
# binary's own default state dir, D9), then 'engine runtime install
# --component longterm-mem --target t' to record and report per-runtime
# status. R-022's vault seeding is lazy (vaultreg.Resolve) and needs no
# separate call here -- the 'longterm-mem vaults seed' invocation this
# replaced named a subcommand that never existed and never will.
#
# The two overrides are NOT symmetrical, and conflating them is how this
# comment previously ended up justifying a flag with the other flag's
# reason:
#
#   --state-dir is deliberately NOT passed, here or on the unregister call
#   below, so that both resolve the SAME install-state.json — the module's
#   own default. --state-dir is what sets that file's location, so passing
#   it on one call and not the other is exactly how install and uninstall
#   come to disagree about where the ownership record lives (see the
#   unregister call's own comment for why that agreement is load-bearing).
#
#   --binary IS passed. It does not move install-state.json and so cannot
#   break that agreement; it sets the path written INTO each runtime's MCP
#   entry, which must be where the binary was actually just deployed. See
#   the call site for the full reason.
#
# status/uninstall skip the build step entirely (R-014 scenario 2) and only
# ever talk to the engine runtime lifecycle surface.
cmd_longterm_mem() {
  local subcmd="${1:-}"
  shift || true
  case "$subcmd" in
    install|status|uninstall) ;;
    *) die "Unknown longterm-mem subcommand: ${subcmd:-<none>}. Valid: install, status, uninstall" ;;
  esac

  local target_arg="all"
  local purge=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --purge)
        [[ "$subcmd" == "uninstall" ]] || die "--purge is only valid with 'uninstall'"
        purge=1
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  local targets
  targets="$(resolve_targets "$target_arg")"

  ensure_engine_binary

  if [[ "$subcmd" == "install" ]]; then
    command -v go >/dev/null 2>&1 || die "go is not installed; required to build longterm-mem"
    [[ -d "$LONGTERM_MEM_SRC" ]] || die "longterm-mem module not found at $LONGTERM_MEM_SRC"

    info "Building longterm-mem binary..."
    # Every step of the deploy below is checked EXPLICITLY rather than left
    # to 'set -e'. cmd_longterm_mem is reached from a condition context in
    # cmd_apply, and bash suppresses errexit for the whole of a function
    # called that way — an unchecked mkdir, mktemp, chmod or mv there
    # deploys nothing and still prints "binary deployed to".
    local binary_dir
    binary_dir="$(dirname "$LONGTERM_MEM_BINARY")"
    mkdir -p "$binary_dir" || die "could not create $binary_dir for the longterm-mem binary"
    local build_tmp
    build_tmp="$(mktemp "$binary_dir/.longterm-mem.build.XXXXXX")" \
      || die "could not create a temporary build file in $binary_dir"
    if ! (cd "$LONGTERM_MEM_SRC" && go build -o "$build_tmp" ./cmd/longterm-mem); then
      rm -f "$build_tmp"
      die "go build failed for longterm-mem; binary not deployed"
    fi
    chmod +x "$build_tmp" || {
      rm -f "$build_tmp"
      die "could not make $build_tmp executable; longterm-mem binary not deployed"
    }
    mv "$build_tmp" "$LONGTERM_MEM_BINARY" || {
      rm -f "$build_tmp"
      die "could not install the longterm-mem binary at $LONGTERM_MEM_BINARY; not deployed"
    }
    info "longterm-mem binary deployed to: $LONGTERM_MEM_BINARY"

    # install_failed marks a register outcome that neither registered $t nor
    # converged, so the caller (cmd_apply's recovery line) hears about it on
    # the exit code. A refusal and a version skew are NOT that: both are
    # states every re-run reproduces identically, so both converge.
    local install_failed=""

    # expanded_all mirrors cmd_register.go's OWN distinction, and it has to,
    # because this loop takes that distinction away from it: register's
    # "--target all" means "every runtime this machine has" and SKIPS a
    # runtime whose configuration file is absent, while a target named
    # explicitly is a different statement and fails. Expanding "all" here
    # and calling register once per target — which the per-target tracking
    # below needs — turns every runtime the machine does not have into a
    # named-target hard failure. Escalating those would fail the run on any
    # machine that does not run all three runtimes.
    #
    # So a hard failure is escalated only for a target the operator named,
    # which is exactly the case register itself escalates. Under "all" it is
    # still warned about, and $t is still not recorded as installed.
    local expanded_all=""
    [[ "$target_arg" == "all" ]] && expanded_all=1

    local t
    for t in $targets; do
      # No --state-dir here: this must resolve to the exact same
      # install-state.json the uninstall path below reads (see that call's
      # comment) — the module's own default (defaultRegisterStateDir(),
      # ~/.labdrian-overlay/longterm-mem, D9) is that single source of
      # truth, not $STATE_DIR.
      #
      # --binary IS passed, and must be: it is the path written INTO each
      # runtime's MCP entry, and $LONGTERM_MEM_BINARY (derived from
      # $STATE_DIR) is where the binary was just deployed. register's own
      # default resolves from $HOME instead, so under a $STATE_DIR override
      # it wrote entries naming a path nothing was ever deployed to. Under
      # the default $STATE_DIR the two values are identical, so this changes
      # no byte of an ordinary install.
      #
      # register's exit status is INSPECTED, not discarded (cmd_register.go:
      # 0 registered, 1 hard failure, 2 usage/version skew, 6 an untagged
      # same-named entry it refuses to touch, 8 a path it could not resolve
      # from the environment at all). 9 is the module's ninth published code
      # and is deliberately absent from that list: it is `doctor`'s verdict
      # ("the checks ran and a VAULT check FAILED", exitDoctorChecksFailed),
      # not a register outcome, and register never raises it. It is named
      # here so the next reader does not read this list as the module's whole
      # contract -- and so that if this entrypoint ever calls `doctor`, 9 gets
      # its own arm there rather than falling into a catch-all that would
      # report a failed vault check as a generic failure.
      #
      # Only 0 means this entrypoint actually
      # registered $t, and only 0 records $t as installed — recording a
      # target register refused would make the binary-removal guard hold the
      # shared binary hostage on behalf of a runtime that never had an entry
      # of ours.
      #
      # Every code the module names has its own arm below, because the
      # catch-all arm carries a story ("a runtime this machine does not
      # have") that is only true for exit 1. A code that falls through to it
      # is not merely reported vaguely — it is reported WRONG.
      local register_exit=0
      "$LONGTERM_MEM_BINARY" register --target "$t" --binary "$LONGTERM_MEM_BINARY" \
        || register_exit=$?

      # The engine record is rebuilt from OBSERVED state on every call and
      # never records an entry it cannot prove it wrote, so it runs for
      # every outcome above: after a refusal it is what reports $t's entry
      # as the unmanaged entry it is, and skipping it would leave a stale
      # record behind instead.
      "$ENGINE_BINARY" runtime install --component longterm-mem --target "$t" --state-dir "$STATE_DIR" \
        || warn "engine runtime install --component longterm-mem --target $t reported a non-supported status"

      case "$register_exit" in
        0)
          longtermmem_installed_targets_add "$t"
          ;;
        6)
          warn "longterm-mem register --target $t: refused — an entry exists that longterm-mem does not own, and it was left untouched. $t is NOT recorded as installed; remove that entry by hand and re-run install to register $t."
          ;;
        2)
          # Exit 2 fails the run for the exact reason exit 8 does, one arm
          # below: it is environment-independent, it reproduces identically
          # on every target (so --target all softens nothing here either),
          # and converging on it at exit 0 would report a component that
          # registered NOTHING as a clean install. The two codes differ only
          # in whose fault they name -- 8 the caller's environment, 2 this
          # binary's own vintage -- and neither difference is visible to a
          # script reading $?.
          #
          # Exit 6 above is deliberately NOT in this bucket: it is not a
          # failure to register but a machine state (a same-named entry this
          # overlay never wrote), the install did everything it is allowed to
          # do, and re-running changes nothing until a human removes that
          # entry. Failing the run there would make every install on such a
          # machine non-zero forever.
          warn "longterm-mem register --target $t: this binary does not accept the invocation (exit 2, version skew), so $t was not registered and is NOT recorded as installed. Not retried; every re-run reproduces this -- deploy a longterm-mem build whose register subcommand matches this overlay."
          install_failed=1
          ;;
        8)
          # register_paths.go separates 8 from 1 precisely so a caller can
          # tell "you forgot a flag / your environment is broken" from "your
          # ~/.claude.json is broken": nothing was attempted and nothing was
          # touched. It is therefore NOT softened under --target all the way
          # exit 1 is. Exit 1 under "all" is genuinely ambiguous with "this
          # machine does not run that runtime"; exit 8 is not ambiguous at
          # all — it is one environment fault that every target reproduces
          # identically, and converging on it at exit 0 would report a
          # completely uninstalled component as a clean run.
          warn "longterm-mem register --target $t: exit 8 — register could not resolve a path from the environment at all (no usable HOME means no runtime config root and no install-state.json directory), so nothing was attempted and $t is NOT recorded as installed. The fix is the environment, not the runtime: set HOME to a writable home directory and re-run install."
          install_failed=1
          ;;
        *)
          if [[ -n "$expanded_all" ]]; then
            warn "longterm-mem register --target $t failed (exit $register_exit); $t was not registered and is NOT recorded as installed. Not failing the run: --target all asks for the runtimes this machine has, and a runtime it does not have looks exactly like this from here."
          else
            warn "longterm-mem register --target $t failed (exit $register_exit); $t was not registered and is NOT recorded as installed"
            install_failed=1
          fi
          ;;
      esac
    done

    if [[ -n "$install_failed" ]]; then
      return 1
    fi
  elif [[ "$subcmd" == "status" ]]; then
    "$ENGINE_BINARY" runtime status --component longterm-mem --state-dir "$STATE_DIR" \
      || warn "engine runtime status --component longterm-mem reported a non-supported status"
  else
    local t
    # uninstall_failed tracks whether any target's unregister call returned
    # a status other than 0 (removed) or 6 (unmanaged) -- see the case
    # statement below. It is the guard that keeps a real failure (state dir
    # unreadable, a corrupted install-state.json, ...) from silently
    # clearing this run's tracking and letting the binary-removal branch
    # below fire for a target whose entry may still be sitting in its
    # runtime config.
    local uninstall_failed=""

    # Selective removal needs a usable binary. When it is absent or not
    # executable there is nothing for the operator to retry: every re-run
    # reproduces the same state, so treating it as a recoverable failure
    # would strand the engine record and the shared binary forever, with
    # --purge -- the one action that orphans the entries -- as the only
    # escape. Say plainly what could not be done, then converge.
    local unregister_usable=1
    if [[ ! -x "$LONGTERM_MEM_BINARY" ]]; then
      unregister_usable=""
      warn "longterm-mem: $LONGTERM_MEM_BINARY is missing or not executable, so the per-runtime MCP entries cannot be removed. Any entry longterm-mem installed stays in its runtime config -- remove it by hand, or reinstall and re-run uninstall."
    fi

    for t in $targets; do
      if [[ -z "$unregister_usable" ]]; then
        longtermmem_installed_targets_remove "$t"
        continue
      fi
      # unregister is module-owned, real per-runtime selective removal
      # (R-019, 12b.4/12b.5): it removes only $t's own ownership-tagged MCP
      # entry from $t's own runtime config, byte-preserving everything
      # else, and clears $t's own install-state.json record. It never
      # touches another target's entry or record, which is exactly what
      # makes the bash-level tracking removed below, and the binary guard
      # after it, safe to key off "$remaining" alone.
      #
      # No --state-dir here either: it MUST resolve to the exact same
      # install-state.json the install path above wrote to (register's own
      # default, D9) -- passing $STATE_DIR here was the CRITICAL-1 defect
      # (install and uninstall disagreeing on where install-state.json
      # lives, so uninstall could never find a record install actually
      # wrote, and reported every entry as unmanaged/exit 6 instead of
      # removing it).
      #
      # cmd_unregister.go's exit codes (0 removed, 1 hard failure, 2 usage,
      # 6 unmanaged, 8 a path it could not resolve from the environment at
      # all, 1 outranking 6) are inspected, not swallowed. 9 is not in that
      # set: it is `doctor`'s "a vault check FAILED" verdict and unregister
      # never raises it (see the register call's comment above). ONLY exit 0 means
      # "$t has nothing of ours left in its runtime config", and only exit 0
      # clears this target's tracking below.
      #
      # 6 used to clear it too, on the reasoning that "an unmanaged entry was
      # never ours to begin with". That reasoning describes the entry, not
      # the run: exit 6 says only that unregister DID NOT REMOVE the entry it
      # found, and unregister cannot tell "someone else's server that happens
      # to share our name" from "our own entry, after install-state.json was
      # lost or restored from a backup that predates the install". Clearing
      # tracking on the second shape frees the guard below to delete the
      # SHARED BINARY while our MCP entries still sit in every runtime config
      # -- orphaned entries pointing at a binary that no longer exists, which
      # is the single state this tracking file exists to prevent. So 6 keeps
      # $t tracked; --purge stays the explicit way out.
      #
      # 2 is the same shape and the same hazard, and is nonetheless treated
      # the other way, for the reason its own arm gives: exit 6 leaves a
      # recovery open (fix the entry by hand, or let `register` adopt it
      # back) while exit 2 leaves none, because the tool that would perform
      # the recovery is the thing that is broken.
      #
      # 8 gets its own arm for the same reason it does on the install side:
      # it lands in the same bucket as the catch-all, but the catch-all's
      # message ("failed") names no remedy, and 8's remedy is the one the
      # operator can actually act on.
      local unregister_exit=0
      "$LONGTERM_MEM_BINARY" unregister --target "$t" || unregister_exit=$?
      case "$unregister_exit" in
        0)
          longtermmem_installed_targets_remove "$t"
          ;;
        6)
          warn "longterm-mem unregister --target $t: unmanaged (an entry exists that longterm-mem does not own; left untouched). $t stays tracked as installed, because that entry was NOT removed and may be ours under a lost install-state.json -- inspect $t's config and remove the entry by hand, then re-run uninstall, or pass --purge to drop the shared binary regardless."
          ;;
        2)
          # Usage error: this binary does not accept the invocation
          # (version skew, a subcommand it does not know). It is the same
          # "the entry was not removed" shape as exit 6 above, and the same
          # orphan hazard, with ONE difference that decides it the other
          # way: the tool itself is unusable, so no re-run of `uninstall`
          # can ever remove the entry or clear the tracking, and keeping $t
          # tracked would leave --purge -- the action that orphans the
          # entries outright -- as the only way to finish. Exit 6 has a
          # real recovery (fix the entry, or let `register` adopt it back);
          # this has none until the binary is replaced. So it converges and
          # clears tracking, and says what was left behind.
          #
          # engine/installer's TestUninstall_VersionSkewStillConverges pins
          # this branch, alongside the missing-binary branch it mirrors.
          warn "longterm-mem unregister --target $t: this binary does not accept the invocation (exit 2, version skew), so $t's entry stays in its runtime config -- remove it by hand, or reinstall and re-run uninstall. Not retried; every re-run reproduces this."
          longtermmem_installed_targets_remove "$t"
          ;;
        8)
          # Unlike exit 2, this one IS operator-fixable and a re-run after
          # the fix succeeds, so it keeps $t tracked and fails the run --
          # the same treatment the catch-all gives, with the remedy named.
          warn "longterm-mem unregister --target $t: exit 8 — unregister could not resolve a path from the environment at all (no usable HOME means no runtime config root and no install-state.json directory), so nothing was attempted and $t's entry may still be in its runtime config. Keeping $t tracked as installed. The fix is the environment, not the runtime: set HOME to a writable home directory and re-run uninstall."
          uninstall_failed=1
          ;;
        *)
          # A real, operator-fixable failure (unreadable config, corrupted
          # install-state.json, permissions): keep $t tracked so the guard
          # below refuses to remove the shared binary while $t's entry may
          # still be present, and re-running after the fix can succeed.
          warn "longterm-mem unregister --target $t failed (exit $unregister_exit); keeping it tracked as installed"
          uninstall_failed=1
          ;;
      esac
    done

    # An absent tracking file means "this entrypoint does not know what is
    # installed", never "nothing is installed": another code path, a lost
    # file or a reset STATE_DIR all read empty while other runtimes may
    # still depend on the shared binary. So it fails CLOSED -- --purge is
    # the one explicit way to force removal.
    local tracking_known=""
    [[ -f "$LONGTERM_MEM_INSTALLED_TARGETS" ]] && tracking_known=1

    # A tracking file that exists but cannot be READ is the same class of
    # not-knowing as one that does not exist at all, and fails closed the
    # same way. It is captured separately from $remaining because an empty
    # $remaining is what AUTHORIZES removal below -- an unreadable file
    # produces exactly that empty string, so without this the strongest
    # signal to stop would read as the go-ahead.
    local remaining tracking_readable=1
    remaining="$(longtermmem_installed_targets_read)" || tracking_readable=""

    if [[ -n "$uninstall_failed" ]] && [[ -z "$purge" ]]; then
      # A real failure outranks every branch below: neither the shared
      # engine registration record nor the shared binary is safe to remove
      # while a target's own runtime config may still hold its entry.
      warn "longterm-mem: at least one target failed to unregister; leaving the registration record and the shared binary untouched (re-run uninstall for the failed target(s) once resolved, or pass --purge to force removal)"
    elif [[ -z "$tracking_readable" ]] && [[ -z "$purge" ]]; then
      warn "longterm-mem: the install tracking file at $LONGTERM_MEM_INSTALLED_TARGETS exists but could not be read, so whether any runtime still depends on the shared binary is unknown; leaving the registration record and the shared binary untouched. Fix its permissions and re-run uninstall, or pass --purge to remove them anyway."
    elif [[ -n "$purge" ]] || { [[ -n "$tracking_known" ]] && [[ -z "$remaining" ]]; }; then
      # Full uninstall: safe to wipe the engine-owned registration record
      # too. LongtermMemAdapter.Uninstall() removes the WHOLE record in one
      # call regardless of --target -- the per-runtime config entries
      # themselves were already removed selectively above, by unregister;
      # this only clears engine/runtime's own separate doctor/status
      # tracking (D4), and calling it only once every tracked target is
      # gone (or --purge forces it) is what keeps this call from wiping
      # another still-installed target's record.
      "$ENGINE_BINARY" runtime uninstall --component longterm-mem --state-dir "$STATE_DIR" \
        || warn "engine runtime uninstall --component longterm-mem reported a non-supported status"
      longtermmem_maybe_remove_binary "$purge"
    elif [[ -z "$tracking_known" ]]; then
      warn "longterm-mem: no install tracking found at $LONGTERM_MEM_INSTALLED_TARGETS; leaving the registration record and the shared binary untouched. Re-run with --purge to remove them anyway."
    else
      echo "  longterm-mem: unregistered the requested target(s); still installed for: $remaining (shared binary and engine-owned tracking left untouched -- re-run uninstall for the remaining target(s), or pass --purge, to remove them)"
    fi

    # Surface the failure on the process exit code even when --purge forced
    # cleanup to proceed anyway -- the caller still asked for every target
    # and at least one did not actually get unregistered cleanly.
    if [[ -n "$uninstall_failed" ]]; then
      return 1
    fi
  fi
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

# Guarded so this file can be `source`d (e.g. by tui/release_backend_test.go)
# to call an internal function directly for unit-style testing, without also
# running the CLI dispatch below. Normal execution (./bin/labdrian-overlay or
# via the bin/overlay wrapper) is unaffected: BASH_SOURCE[0] and $0 are
# identical for a top-level executed script.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  COMMAND="${1:-}"
  shift || true

  case "$COMMAND" in
    bootstrap)       cmd_bootstrap "$@" ;;
    capture)         cmd_capture "$@" ;;
    apply)           cmd_apply "$@" ;;
    self-update)     cmd_self_update "$@" ;;
    update)          cmd_update "$@" ;;
    restore)         cmd_restore "$@" ;;
    version|--version) cmd_version "$@" ;;
    status)          cmd_status "$@" ;;
    sync-check)      cmd_sync_check "$@" ;;
    install-hooks)   cmd_install_hooks "$@" ;;
    uninstall-hooks) cmd_uninstall_hooks "$@" ;;
    status-hooks)    cmd_status_hooks "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    repair-sdd-registry) cmd_repair_sdd_registry "$@" ;;
    skill-registry)  cmd_skill_registry "$@" ;;
    tui)             cmd_tui "$@" ;;
    install-alias)   cmd_install_alias "$@" ;;
    prespec)         cmd_prespec "$@" ;;
    skills)          cmd_skills "$@" ;;
    validate-entry-contract) cmd_validate_entry_contract "$@" ;;
    deterministic-checks) cmd_deterministic_checks "$@" ;;
    review-preflight) cmd_review_preflight "$@" ;;
    archive-reconcile) cmd_archive_reconcile "$@" ;;
    gadu-generate)   cmd_gadu_generate "$@" ;;
    longterm-mem)    cmd_longterm_mem "$@" ;;
    --help|-h)       usage; exit 0 ;;
    "")              usage >&2; exit 1 ;;
    *)               die "Unknown command: $COMMAND" ;;
  esac
fi
