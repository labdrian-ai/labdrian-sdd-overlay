#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of this script, following symlinks.
# Uses a pure-bash loop instead of readlink -f so it works on macOS/BSD too.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
CALLER_CWD="$PWD"
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Allow OVERLAY_DIR to be overridden via environment variable (useful for tests
# and power-user workflows; normal use leaves it unset so it auto-detects here).
OVERLAY_DIR="${OVERLAY_DIR:-"$(cd "$SCRIPT_DIR/.." && pwd)"}"
TARBALL="$HOME/.gentle-ai/backups/upgrade-20260615T175529Z/snapshot.tar.gz"
MANIFEST="${MANIFEST:-"$OVERLAY_DIR/overlay.manifest"}"

# path_clean <path> prints <path> lexically normalized: duplicate separators
# collapsed, "." elements removed, ".." elements resolved against the element
# before them, and any trailing separator dropped. "" becomes ".", and ".."
# above the root of a rooted path is the root.
#
# It reproduces Go's filepath.Clean on purpose, byte for byte, because that
# is the OTHER half of a contract this script cannot see. The engine derives
# the longterm-mem binary path with filepath.Join (which cleans), rebuilds
# each runtime's MCP entry from it, and decides ownership by comparing that
# rebuilt entry against the live one as an EXACT STRING fingerprint. This
# script builds the same path by concatenation (which does not clean) and
# hands that literal to `longterm-mem register --binary`, which is what
# actually gets written into the config. The two therefore agreed only while
# $STATE_DIR happened to be lexically clean already: one trailing slash and
# the overlay wrote "<dir>//bin/longterm-mem" while the engine looked for
# "<dir>/bin/longterm-mem" and reported the overlay's own freshly-written
# entry as unmanaged.
#
# Purely lexical, deliberately: it never touches the filesystem and never
# resolves a symlink, because the Go half it must agree with does not
# either. `realpath` would be the wrong tool here even where it exists —
# resolving symlinks would produce a path the engine never derives.
#
# Defined here, above the derived paths below, because those are assigned at
# source time and a function must exist before it is called.
path_clean() {
  local path="${1:-}"
  local rooted="" out="" elem rest

  [[ "$path" == /* ]] && rooted=1
  rest="$path"

  while [[ -n "$rest" ]]; do
    elem="${rest%%/*}"
    if [[ "$rest" == */* ]]; then
      rest="${rest#*/}"
    else
      rest=""
    fi

    case "$elem" in
      '' | '.')
        # A duplicate separator or a "." element names nothing.
        ;;
      '..')
        if [[ -n "$rooted" || ( -n "$out" && "$out" != ".." && "$out" != *"/.." ) ]]; then
          # Pop the previous element. A rooted path with nothing left to
          # pop stays at the root: "/.." is "/".
          if [[ "$out" == */* ]]; then
            out="${out%/*}"
          else
            out=""
          fi
        else
          # A RELATIVE path can lead with ".." elements that nothing
          # cancels; those are part of the answer, not noise.
          out="${out:+$out/}.."
        fi
        ;;
      *)
        out="${out:+$out/}$elem"
        ;;
    esac
  done

  if [[ -n "$rooted" ]]; then
    printf '%s\n' "/$out"
  elif [[ -n "$out" ]]; then
    printf '%s\n' "$out"
  else
    printf '%s\n' "."
  fi
}

# Home-scoped per design decision D3: state describes deployments under
# $HOME (TARGET_PATHS/AGENT_TARGET_PATHS are all $HOME-anchored), so a
# repo-scoped file would let two clones of this repo hold divergent records
# of the same live targets.
#
# Normalized ONCE, here, so every path derived from it below and every
# `--state-dir "$STATE_DIR"` handed to the engine already looks the way the
# engine's own filepath.Join will make it look. Doing it at the point of use
# instead would mean remembering it at each of them, which is exactly the
# kind of agreement that decays.
STATE_DIR="$(path_clean "${STATE_DIR:-"$HOME/.labdrian-overlay"}")"
STATE_FILE="$STATE_DIR/state.json"

declare -A TARGET_PATHS=(
  [claude]="$HOME/.claude/skills"
  [opencode]="$HOME/.config/opencode/skills"
  [codex]="$HOME/.codex/skills"
)

# Native agent-route destinations. Claude Code and OpenCode use different
# frontmatter schemas, so they are deployed from separate generated files.
declare -A AGENT_TARGET_PATHS=(
  [claude]="$HOME/.claude/agents"
  [opencode]="$HOME/.config/opencode/agents"
)

# Known limitations (explicitly out of scope for this change, R-009):
#   - The bootstrap init block's human-readable info echoes (dir creation) remain
#     skills-first. They are a no-op for GADU (custom rows) and only matter for a
#     hypothetical future managed agent row.
#   - No native Codex agent-definition files are produced (R-009).
#   - No SDD orchestrator auto-spawn wiring (R-009).

# Path where the engine binary is deployed. Using ~/.claude/bin/ keeps all
# Claude Code tooling co-located and makes the binary easy to find in hooks.
ENGINE_BINARY="$HOME/.claude/bin/gentle-ai-overlay"
ENGINE_SRC="$OVERLAY_DIR/engine"

# LONGTERM_MEM_BINARY is the fixed, documented, persistent install path for
# the longterm-mem binary (R-015): it never moves between an install and a
# later inspection. STATE_DIR-scoped (not $HOME/.claude/-scoped like
# ENGINE_BINARY) because longterm-mem is a cross-runtime component, not a
# Claude-specific one (D4).
#
# Routed through path_clean even though $STATE_DIR is already clean: this
# exact string is what `register --binary` writes into every runtime's MCP
# entry, and what the engine re-derives with filepath.Join to decide whether
# that entry is ours. path_clean here is what makes the two halves agree for
# EVERY $STATE_DIR rather than only the already-clean ones — including the
# one case normalizing $STATE_DIR alone does not cover, a state dir of "/",
# where plain concatenation still yields "//bin/longterm-mem".
LONGTERM_MEM_BINARY="$(path_clean "$STATE_DIR/bin/longterm-mem")"
LONGTERM_MEM_SRC="$OVERLAY_DIR/longterm-mem"

# LONGTERM_MEM_INSTALLED_TARGETS tracks, one target name per line, which of
# claude/opencode/codex this overlay entrypoint has installed longterm-mem
# for. It is this slice's own bookkeeping for the binary-removal guard
# (D4/10b.5: "binary removed only when --target all leaves zero install-state
# targets, or --purge"). True per-runtime selective un-registration in each
# runtime's own config file is module-owned and lands in slice 12b (R-019);
# until then this file is the only accurate source of truth for "does any
# target still count as installed" that this shell entrypoint has of its
# own — engine's registration.json (10a, LongtermMemAdapter) records
# per-runtime state but its Uninstall() removes the WHOLE record in one
# call regardless of --target, so it cannot answer this question on its own
# without risking exactly the bug this file exists to prevent: wiping out a
# still-installed target's record because a DIFFERENT target was uninstalled.
LONGTERM_MEM_INSTALLED_TARGETS="$STATE_DIR/longterm-mem/installed-targets"

# LONGTERM_MEM_TARGETS_LOCK serializes the whole read-modify-write cycle over
# the tracking file above (see longtermmem_targets_lock_acquire).
#
# Deliberately OUTSIDE the longterm-mem/ directory the tracking file lives in:
# a writer that has to report "I could not stage a rewrite in that directory"
# must still be able to take, and then release, the lock — a lock that can
# only be created in the directory that just proved unwritable would fail
# exactly when the failure path needs it.
LONGTERM_MEM_TARGETS_LOCK="$STATE_DIR/.installed-targets.lock"

# Minutes after which a lock directory is treated as abandoned. See the
# staleness escape in longtermmem_targets_lock_acquire.
LONGTERM_MEM_TARGETS_LOCK_STALE_MINUTES=5

# Set while THIS shell holds the lock, so release is idempotent and a nested
# `die` cannot rmdir a lock some other invocation owns.
LONGTERM_MEM_TARGETS_LOCK_HELD=""

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

# die releases the install-tracking lock before exiting. `die` exits the
# PROCESS, so a RETURN trap inside the critical section never runs on this
# path — and this is the path every unrecoverable problem in the tracking
# writers takes. Without this, the single most likely way to leave a lock
# behind would be the ordinary error path.
die() { longtermmem_targets_lock_release; echo "ERROR: $*" >&2; exit 1; }
info() { echo "==> $*"; }
warn() { echo "WARN: $*" >&2; }

# ---------------------------------------------------------------------------
# installed-targets lock (mkdir-based, deliberately NOT flock)
# ---------------------------------------------------------------------------
#
# The tracking file is read, modified and written back. Writing through a
# per-process temporary made that write atomic, which fixed TORN files but
# not LOST UPDATES: two overlay invocations can still each read before the
# other's rename, and the second rename then publishes state that never saw
# the first one's change. That file is what the binary-removal guard
# consults, so a dropped target means the SHARED BINARY can be deleted while
# a runtime is still registered against it.
#
# mkdir, not flock(1). mkdir is atomic on every platform this overlay runs
# on. flock(1) ships with util-linux and is ABSENT on macOS, so a
# flock-based guard would silently not run there — worse than no guard,
# because the code reads as protected everywhere while protecting only
# Linux.
#
# WHAT THE LOCK DOES NOT COVER: it serializes each tracking-file
# read-modify-write, not an overlay COMMAND. Every writer re-reads inside its
# own critical section -- longtermmem_maybe_remove_binary re-reads "remaining"
# there rather than trusting its caller's unlocked read -- so no decision is
# made on stale state. But an `add` that lands the instant after the removal
# guard releases still records a target whose shared binary was rm -f'ed a
# moment earlier: a runtime registered against a missing binary. Per-writer
# locking cannot close that; only a command-scoped lock could. Install and
# uninstall running concurrently are NOT safe end to end.
#
# longtermmem_targets_lock_acquire blocks for a bounded number of tries and
# then FAILS THE RUN rather than proceeding unlocked. Proceeding unlocked is
# defensible in general, but not here: the thing the lock protects is the
# only record of which runtimes still depend on a shared binary, and losing
# an entry from it is silent and destructive, while a failed run is loud,
# changes nothing, and is retryable. So the choice is explicit — refuse.
#
# A refusal that cannot clear would be its own bug (a lock directory left by
# a SIGKILLed run would wedge every later invocation forever), so there IS a
# staleness escape: a lock older than LONGTERM_MEM_TARGETS_LOCK_STALE_MINUTES
# is treated as abandoned and broken into, with a warning. It is bounded on
# both sides on purpose — long enough that no ordinary critical section here
# (a few file reads, a rename) can be mistaken for abandoned, short enough
# that an operator never has to know this directory exists. The age test
# goes through `find -mmin`, which behaves the same on GNU and BSD/macOS,
# rather than `stat`, whose format flags do not.
# longtermmem_targets_lock_is_stale reports whether the lock directory is
# older than the abandonment window. It is a function because the break-in
# below has to ask TWICE -- once to decide to break in at all, and once more
# under the break lock, against whatever the lock directory has become in
# between.
#
# The age test goes through `find -mmin`, which behaves the same on GNU and
# BSD/macOS, rather than `stat`, whose format flags do not.
longtermmem_targets_lock_is_stale() {
  [[ -n "$(find "$LONGTERM_MEM_TARGETS_LOCK" -maxdepth 0 \
             -mmin "+$LONGTERM_MEM_TARGETS_LOCK_STALE_MINUTES" 2>/dev/null)" ]]
}

longtermmem_targets_lock_acquire() {
  mkdir -p "$STATE_DIR" || die "longterm-mem: could not create $STATE_DIR"

  local i
  for i in 1 2 3 4 5; do
    if mkdir "$LONGTERM_MEM_TARGETS_LOCK" 2>/dev/null; then
      LONGTERM_MEM_TARGETS_LOCK_HELD=1
      return 0
    fi
    sleep 0.2
  done

  # THE BREAK-IN IS ITSELF A CRITICAL SECTION. Classifying the lock as stale
  # and then acting on that classification is a read-modify-write over the
  # lock directory, and the unconditional "rmdir then mkdir" this used to be
  # ran it unserialized: two invocations that both classify the same lock as
  # abandoned each break in independently, and an interleaving where the
  # loser's rmdir lands AFTER the winner's mkdir deletes the WINNER'S LIVE
  # LOCK and admits both to the critical section -- the exact lost update the
  # lock exists to prevent, reached through the lock's own recovery path.
  #
  # So the break-in is serialized by a second mkdir, and the staleness test is
  # RE-RUN under it. The re-run is the half that matters: the break lock alone
  # only orders the two breakers, and the loser, arriving a moment later,
  # would still be acting on a classification made before the winner replaced
  # the lock. Re-classifying under the break lock makes the loser see the
  # winner's FRESH lock, decline to remove it, and fail the run loudly.
  #
  # That exclusion covers breaker against breaker, and NOT breaker against an
  # ordinary acquirer: between the re-test above and the rmdir below, a plain
  # invocation can release the stale lock and take it normally, and the
  # breaker then removes that live lock. In production the gap is one stderr
  # write, so the window is microseconds and it still needs an already
  # abnormal lock older than the staleness bound -- and the rename this could
  # be rewritten around carries the same check-then-act on its source path, so
  # the residue looks irreducible in portable shell. It is named here rather
  # than left implied, because a reader who takes "serialized" to mean
  # exclusive against everything would build on a guarantee this does not make.
  #
  # The break lock is held for the duration of one age test and one mkdir, and
  # is released on every path out. A run SIGKILLed inside that window leaks it
  # and disables the staleness escape -- the message below names the lock
  # directory, and the break directory sits beside it under the same name.
  if longtermmem_targets_lock_is_stale; then
    if mkdir "$LONGTERM_MEM_TARGETS_LOCK.break" 2>/dev/null; then
      if longtermmem_targets_lock_is_stale; then
        warn "longterm-mem: the install-tracking lock at $LONGTERM_MEM_TARGETS_LOCK is older than $LONGTERM_MEM_TARGETS_LOCK_STALE_MINUTES minutes; treating it as abandoned by a killed run and taking it over"
        rmdir "$LONGTERM_MEM_TARGETS_LOCK" 2>/dev/null || true
        if mkdir "$LONGTERM_MEM_TARGETS_LOCK" 2>/dev/null; then
          LONGTERM_MEM_TARGETS_LOCK_HELD=1
          rmdir "$LONGTERM_MEM_TARGETS_LOCK.break" 2>/dev/null || true
          return 0
        fi
      fi
      rmdir "$LONGTERM_MEM_TARGETS_LOCK.break" 2>/dev/null || true
    fi
  fi

  # One last attempt before refusing. The retry budget above is a fixed number
  # of fixed sleeps, so a holder that releases just after the final mkdir --
  # 0.9s in, against a last attempt at 0.8s -- leaves the lock FREE while the
  # staleness test correctly answers "not stale", and the run would fail with
  # the lock sitting there available. One more mkdir costs a syscall and
  # removes that whole class of spurious refusals.
  if mkdir "$LONGTERM_MEM_TARGETS_LOCK" 2>/dev/null; then
    LONGTERM_MEM_TARGETS_LOCK_HELD=1
    return 0
  fi

  die "longterm-mem: could not acquire the install-tracking lock at $LONGTERM_MEM_TARGETS_LOCK; another overlay invocation is updating install state. Nothing was changed — re-run once it finishes, or remove that directory if no other invocation is running."
}

# longtermmem_targets_lock_release drops the lock if THIS shell holds it.
# Safe to call unconditionally (die does), and safe to call twice.
longtermmem_targets_lock_release() {
  [[ -n "${LONGTERM_MEM_TARGETS_LOCK_HELD:-}" ]] || return 0
  LONGTERM_MEM_TARGETS_LOCK_HELD=""
  rmdir "$LONGTERM_MEM_TARGETS_LOCK" 2>/dev/null || true
}

# Read manifest: emit "path tag" lines, skipping blank lines and comments
parse_manifest() {
  grep -v '^\s*#' "$MANIFEST" | grep -v '^\s*$'
}

# Managed files only
managed_files() {
  parse_manifest | awk '$2 == "managed" { print $1 }'
}

# All tracked files (managed + custom)
all_tracked_files() {
  parse_manifest | awk '{ print $1 }'
}

# Ensure the parent directory of a path exists
ensure_parent() {
  local path="$1"
  local parent
  parent="$(dirname "$path")"
  mkdir -p "$parent"
}

# Resolve --target argument to a space-separated list of target names
resolve_targets() {
  local arg="${1:-all}"
  if [[ "$arg" == "all" ]]; then
    echo "claude opencode codex"
  elif [[ -v TARGET_PATHS["$arg"] ]]; then
    echo "$arg"
  else
    die "Unknown target: $arg. Valid: claude, opencode, codex, all"
  fi
}

# ---------------------------------------------------------------------------
# usage
# ---------------------------------------------------------------------------

usage() {
  cat <<'EOF'
Usage: overlay <command> [options]

Commands:
  bootstrap                        Initialize overlay repo and branches
  capture [--target claude|opencode|codex] [--from-backup DIR]
                                   Capture managed files from target (default: claude).
                                   Pushes the 'upstream' mirror branch to origin.
  apply [--target claude|opencode|codex|all] [--push]
                                   Merge upstream and deploy to target(s) (default: all).
                                   Never pushes main unless --push; without it, reports
                                   how far local main is ahead of origin/main.
  self-update                     Fast-forward ONLY local 'main' (never the current branch),
                                   then return to the branch you were on. Converges to the
                                   latest published release tag (never past it, even when
                                   origin/main carries untagged commits beyond that tag); before
                                   the first release tag exists, falls back to legacy
                                   origin/main-HEAD convergence. Refuses (exit 1) on a dirty
                                   tracked tree, a local main ahead of origin/main, or no
                                   'origin' remote. Untracked files never block it.
  update                           Read-only: report the latest published release and each
                                   target's recorded version (up-to-date/behind/never deployed).
                                   Refreshes only cached tags/remote refs -- never a branch head,
                                   the working tree, target files, or state.
  restore --target claude|opencode|codex [--list] [--backup TIMESTAMP]
                                   DESTRUCTIVE: rolls a single target back from one of its
                                   retained backups (up to 3, auto-pruned; default: most
                                   recent). Refuses --target all. --list shows retained
                                   backups (timestamp, version) without changing anything.
                                   --backup TIMESTAMP picks a specific one. Exits non-zero
                                   without touching any file when the target has no backups.
                                   Performs zero git operations.
  version (also: --version)       Read-only: print this clone's current release version
                                   (from local main) and each target's recorded deployed
                                   version, naming any that are behind. Never-deployed
                                   targets are reported honestly, never fabricated.
  status [--target claude|opencode|codex|all]
                                   Show drift between repo and target(s) (default: all)
  sync-check [--target claude|opencode|codex|all] [--check-origin|--fetch]
                                   Validate gentle-ai sync state per target (default: all).
                                   Also reports REPO_BEHIND_ORIGIN=<count|NA> on each VERDICT
                                   line: how many commits local main is behind this repo's own
                                   origin/main. Default is a cached-ref comparison (no network
                                   call); pass --check-origin (alias --fetch) to run
                                   'git fetch origin' first for a live count. NA means the
                                   comparison is unavailable (no origin remote, no cached ref,
                                   or a requested fetch failed) -- other checks still complete.
  install-hooks                    Build + deploy the engine binary, then wire the two
                                   deterministic-scoping hooks into ~/.claude/settings.json.
                                   DELIBERATE ACTION — not called by 'apply'. Run once to
                                   activate; the hooks are INERT until this command runs.
                                   Also best-effort installs discovery tools (bat rg fd sd
                                   eza) via Homebrew so agents never hit the silent-empty
                                   footgun. Set OVERLAY_SKIP_TOOL_INSTALL=1 to opt out.
  uninstall-hooks                  Remove our two hook entries from ~/.claude/settings.json,
                                   leaving all other keys and hooks intact.
  status-hooks                     Read-only check of overlay installation health: binary
                                   present, hooks wired, contract readable. Exits 0 if all
                                   OK, 1 if any check fails. Safe to run at any time.
  doctor [--fix]                   Read-only host-toolchain preflight: checks go (required),
                                   gentle-ai, bat/rg/fd/sd/eza, the engine binary, and a
                                   non-empty skill-registry. Prints PASS/WARN/FAIL per check;
                                   exits non-zero only on a hard FAIL. Safe to run at any time.
                                   --fix: after the checks, attempt to install any missing
                                   discovery tools (bat rg fd sd eza) via Homebrew (best-effort,
                                   non-fatal), then re-check and report the result.
  repair-sdd-registry [--cwd DIR] [--target claude|opencode|codex] [--no-refresh]
                                   Refresh and repair .atl/skill-registry.md so existing
                                   sdd-* phase executor skills stay resolvable after
                                   gentle-ai sync/skill-registry refresh.
  skill-registry refresh [--cwd DIR] [--target claude|opencode|codex] [--no-repair]
                                   Run gentle-ai skill-registry refresh, then immediately
                                   repair sdd-* executor rows for the selected target
                                   (default target: codex).
  tui                              Launch the Bubbletea TUI front-end
  install-alias [name]             Symlink a command (default: labdrian) into ~/.local/bin
  prespec <verb>                   Forward to the engine's prespec discovery core
                                   (verbs: rank, lint, readiness, brief). Reads JSON
                                   from stdin, writes JSON to stdout. Used by the
                                   prespec-malandra skill.
  skills <verb>                    Forward to the engine's skills registry core
                                   list      print sorted registry entries
                                   status    print count summary
                                   validate  cross-check registry vs overlay.manifest,
                                             and skills/ on disk vs overlay.manifest
                                             (requires --source-root)
                                   install   copy project-scoped skills into <cwd>/.claude/skills
                                   add <id> [--repo <url>] [--ref <sha>]
                                             register a skill: custom (no --repo) or
                                             external=vendored provenance (--repo set).
                                             The overlay NEVER fetches; --repo/--ref are
                                             inert labels for a file you already committed.
                                   remove <id> unregister a skill from registry + manifest
                                   sync-manifest  regenerate */SKILL.md rows from skills.registry.yaml
  validate-entry-contract          Validate a pre-SDD entry candidate with the version-matched
    --schema PATH --instance PATH  schema and deterministic semantic checks. Relative paths are
                                   resolved from the caller's working directory. Preserves validator
                                   exit codes 2-6 and does not modify installed skill roots.
  deterministic-checks             Run the hardcoded v1 check set (gofmt, go vet, staticcheck,
    <normalize|check> [--top-n N]  deadcode) via the overlay-owned runner. 'check' never mutates;
    [--out-dir DIR]                'normalize' applies fixers. Exit 0=passed, 1=verification_failed,
                                   3=procedural_tooling_failed; propagated unchanged from the runner.
  review-preflight                 Ask whether a review started in the caller's cwd would cover
    [--base-ref REF]               anything, by reading the projection 'gentle-ai review status'
                                   reports. Exit 0=candidate covers something, 1=EMPTY candidate
                                   (a review here would approve nothing), 2=usage,
                                   3=could not determine; propagated unchanged from the guard.
  archive-reconcile                Detect completed SDD changes under openspec/changes/ (every
    [--repo PATH]                  tasks.md checkbox checked) that were never archived, and report
    [--known-gaps PATH]            whether their delta capabilities were promoted into
                                   openspec/specs/. A change whose completion signal the guard
                                   cannot read is reported as undetermined, never skipped.
                                   --known-gaps names a ledger of changes already known to fail;
                                   a listed change that stops failing is reported as a stale
                                   waiver, so the ledger cannot outlive the gap it records. The
                                   path is resolved from YOUR current directory, since the guard
                                   runs there -- pass it repository-relative.
                                   Exit 0=clean, 1=stranded change found, 2=usage, 3=could not
                                   determine (an unreadable signal, an unreadable ledger, or a
                                   stale waiver); propagated unchanged from the guard.
  gadu-generate [--check]          Regenerate GADU artifacts from the canonical source
                                   (agents/GADU.md, opencode/agents/GADU.md,
                                   skills/gadu-operator/SKILL.md) under OVERLAY_DIR.
                                   Optional --check verifies freshness without writing.
  longterm-mem install|status|uninstall
    [--target claude|opencode|codex|all] [--purge]
                                   Build (install only), copy to the fixed path
                                   $STATE_DIR/bin/longterm-mem, and report/record
                                   per-runtime (claude, opencode, codex) MCP
                                   registration via the engine runtime lifecycle
                                   surface (D4, R-014/R-015). status/uninstall never
                                   build. The binary is removed only when --target
                                   all leaves zero install-state targets, or --purge.
  --help                           Show this help

Targets:
  claude   → ~/.claude/skills
  opencode → ~/.config/opencode/skills
  codex    → ~/.codex/skills

Hook activation notes:
  - 'overlay apply' does NOT call install-hooks. Deploy of skills and hook
    wiring are intentionally separate so skills can be updated without
    mutating ~/.claude/settings.json.
  - Run 'overlay install-hooks' once after initial setup (or after a binary
    update) to activate deterministic scoping.
  - status-hooks is now read-only and fails loudly when the engine binary is
    absent (run 'overlay install-hooks').
EOF
}

SDD_EXECUTOR_SKILLS=(
  sdd-apply
  sdd-archive
  sdd-design
  sdd-explore
  sdd-init
  sdd-onboard
  sdd-propose
  sdd-spec
  sdd-tasks
  sdd-time-estimation
  sdd-verify
)

skill_frontmatter_description() {
  local skill_file="$1"
  awk '
    /^description:[[:space:]]*/ {
      sub(/^description:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"$/, "")
      gsub(/\|/, "\\|")
      print
      exit
    }
  ' "$skill_file"
}

repair_sdd_registry_file() {
  local registry="$1"
  local target="$2"
  local skill_root="${TARGET_PATHS[$target]}"

  mkdir -p "$(dirname "$registry")"
  if [[ ! -f "$registry" ]]; then
    cat > "$registry" <<EOF
# Skill Registry — $(basename "$(dirname "$(dirname "$registry")")")

## Skills

| Skill | Trigger / description | Scope | Path |
| --- | --- | --- | --- |

## Loading protocol

1. Match task context and target files against the \`Trigger / description\` column.
2. Pass only the matching \`Path\` values to the subagent under \`## Skills to load before work\`.
EOF
  fi

  grep -q '^## Skills$' "$registry" || die "registry has no '## Skills' section: $registry"
  grep -q '^## Loading protocol$' "$registry" || die "registry has no '## Loading protocol' section: $registry"

  local block tmp
  block="$(mktemp)"
  tmp="$(mktemp)"
  trap 'rm -f "$block" "$tmp"' RETURN

  local name path desc missing=0
  for name in "${SDD_EXECUTOR_SKILLS[@]}"; do
    path="$skill_root/$name/SKILL.md"
    if [[ ! -f "$path" ]]; then
      warn "missing $target SDD executor skill: $path"
      missing=$((missing + 1))
      continue
    fi
    desc="$(skill_frontmatter_description "$path")"
    [[ -n "$desc" ]] || desc="SDD phase executor: $name."
    printf '| `%s` | %s | executor | `%s` |\n' "$name" "$desc" "$path" >> "$block"
  done

  local note
  note='`sdd-*` phase skills are executor contracts. Gentle may skip them as user-invocable skills, but this registry keeps their paths visible so SDD delegation can resolve the existing installed files.'

  awk -v note="$note" -v block="$block" '
    $0 == note { next }
    $0 ~ /^\| `sdd-[^`]+` \|/ { next }
    $0 == "## Skills" {
      print note
      print ""
      print
      next
    }
    $0 == "## Loading protocol" {
      while ((getline line < block) > 0) {
        print line
      }
      close(block)
      print ""
      print
      next
    }
    { print }
  ' "$registry" > "$tmp"

  mv "$tmp" "$registry"
  rm -f "$block"
  trap - RETURN

  local count
  count="$(grep -c '^| `sdd-' "$registry" || true)"
  echo "repair-sdd-registry: registry=$registry target=$target sdd_executors=$count missing=$missing"
}

# ---------------------------------------------------------------------------
# route_resolve — single source of truth for manifest entry → routing
# ---------------------------------------------------------------------------
#
# route_resolve <manifest_path>
#
# Reads the optional third column of the overlay.manifest row whose first field
# equals <manifest_path>. Emits ONE tab-separated line (side-effect-free):
#
#   <route>\t<repo_source_abs>\t<target_name>:<dest_abs> [...]
#
# route=skill (default; all existing bare two-column rows):
#   repo_source = $OVERLAY_DIR/skills/<path>
#   targets     = claude:<CLAUDE_SKILLS>/<path>  opencode:<OC_SKILLS>/<path>  codex:<CODEX_SKILLS>/<path>
#
# route=agent (third column == "agent"):
#   repo_source = $OVERLAY_DIR/agents/<path>
#   targets     = claude:$HOME/.claude/agents/<path>
#
# route=opencode-agent (third column == "opencode-agent"):
#   repo_source = $OVERLAY_DIR/opencode/agents/<path>
#   targets     = opencode:$HOME/.config/opencode/agents/<path>
#
# route=mcp (third column == "mcp"; D13):
#   repo_source = $OVERLAY_DIR/<path>
#   targets     = (none) — the longterm-mem install path (build, copy,
#                 register) is dispatched separately, not via the deploy loop.
#
# Callers intersect the emitted target set with their --target selection:
#   --target codex + agent row → zero applicable targets (no work, not an error).
#
# Route domain guard (R-012 in overlay-agent-route, traces longterm-mem R-035):
# a row under longterm-mem/** whose third column is absent or not in the
# recognized four-value domain {skill, agent, opencode-agent, mcp} is REJECTED
# (exit 1, explicit stderr naming the row) rather than silently falling
# through to the skill route — see route_reject_unrouted_longterm_mem below.
#
# Back-compat invariant: bare two-column skill rows emit BYTE-IDENTICAL results
# to pre-route_resolve behavior (pinned by TestRouteResolve_LegacySkillRow).

# route_reject_unrouted_longterm_mem <manifest_path> <route_raw>
#
# Enforces the longterm-mem/** route-domain guard described above. <route_raw>
# is the UNDEFAULTED third column (empty when absent) — route_resolve must
# pass the raw value, not the "skill"-defaulted one, or a missing column would
# be indistinguishable from an explicit route=skill row. Exits 1 with an
# explicit stderr message naming the row on rejection; returns 0 otherwise.
# Hoisted into its own function so cmd_apply's manifest-load hook can reuse it
# without re-deriving route_resolve's internals.
route_reject_unrouted_longterm_mem() {
  local manifest_path="$1"
  local route_raw="$2"

  case "$route_raw" in
    skill|agent|opencode-agent|mcp)
      return 0
      ;;
  esac

  if [[ -z "$route_raw" ]]; then
    echo "route_resolve: longterm-mem row '$manifest_path' declares no route (missing third column); must be one of: skill, agent, opencode-agent, mcp" >&2
  else
    echo "route_resolve: longterm-mem row '$manifest_path' declares an unrecognized route '$route_raw'; must be one of: skill, agent, opencode-agent, mcp" >&2
  fi
  exit 1
}

route_resolve() {
  local manifest_path="$1"
  local route_raw
  route_raw="$(awk -v p="$manifest_path" '$1 == p { print $3; exit }' "$MANIFEST")"

  if [[ "$manifest_path" == longterm-mem/* ]]; then
    route_reject_unrouted_longterm_mem "$manifest_path" "$route_raw"
  fi

  local route="${route_raw:-skill}"

  # Detect structurally non-deployable rows: paths that cannot map to a skill
  # or agent source directory. Overlay engine source files (engine/*) and
  # root-level files (no path separator, e.g. skills.registry.yaml) are
  # tracked in the manifest for diff/sync-check purposes only; they are never
  # copied to skills/ or agents/ targets.
  #
  # Rule: for skill-route rows (non-agent), if the first path segment equals
  # the full path (no "/") or equals "engine", the row is non-deployable.
  # Callers skip non-deployable rows silently because the emitted target list
  # is empty and their existing [[ -z "$rr_dest" ]] && continue guards fire.
  if [[ "$route" != "agent" ]]; then
    local first_seg="${manifest_path%%/*}"
    if [[ "$first_seg" == "$manifest_path" || "$first_seg" == "engine" ]]; then
      printf 'non-deployable\t\t\n'
      return
    fi
  fi

  local repo_source
  local targets=()
  local tname

  if [[ "$route" == "agent" ]]; then
    repo_source="$OVERLAY_DIR/agents/${manifest_path}"
    targets+=("claude:${AGENT_TARGET_PATHS[claude]}/${manifest_path}")
  elif [[ "$route" == "opencode-agent" ]]; then
    local opencode_agent_rel="${manifest_path#opencode/agents/}"
    if [[ "$opencode_agent_rel" == "$manifest_path" || -z "$opencode_agent_rel" ]]; then
      printf 'non-deployable\t\t\n'
      return
    fi
    repo_source="$OVERLAY_DIR/${manifest_path}"
    targets+=("opencode:${AGENT_TARGET_PATHS[opencode]}/${opencode_agent_rel}")
  elif [[ "$route" == "mcp" ]]; then
    repo_source="$OVERLAY_DIR/${manifest_path}"
    # No copy targets: the longterm-mem install path (build, copy, register)
    # is dispatched separately from the deploy loop (D13).
  else
    repo_source="$OVERLAY_DIR/skills/${manifest_path}"
    for tname in "${!TARGET_PATHS[@]}"; do
      targets+=("${tname}:${TARGET_PATHS[$tname]}/${manifest_path}")
    done
  fi

  printf '%s\t%s\t%s\n' "$route" "$repo_source" "${targets[*]}"
}

route_repo_rel() {
  local route="$1"
  local manifest_path="$2"

  case "$route" in
    agent)
      printf 'agents/%s' "$manifest_path"
      ;;
    opencode-agent)
      printf '%s' "$manifest_path"
      ;;
    mcp)
      printf '%s' "$manifest_path"
      ;;
    skill)
      printf 'skills/%s' "$manifest_path"
      ;;
    *)
      printf '%s' "$manifest_path"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# release identity, digest, and state (R-001..R-003)
# ---------------------------------------------------------------------------

# resolve_latest_release_tag <ref> [do_fetch=true]
#
# R-003: by default (do_fetch=true, every caller except cmd_sync_check's
# read-only default path) explicitly fetches v*-matching tags from origin
# first (closing the gap where a plain branch fetch does not guarantee tag
# visibility), THEN resolves the highest semver-ordered ANNOTATED tag
# reachable from <ref>, using git's version-aware refname sort rather than a
# plain lexical one (v1.10.0 must outrank v1.9.0). Lightweight tags are
# skipped -- R-001 requires an annotated tag. Emits the literal token "none"
# when no qualifying tag exists (design decision D1's pre-first-tag
# bootstrap case), never an error -- callers decide how to degrade (D1:
# legacy convergence / "untagged" / "no releases published yet").
#
# Passing do_fetch=false resolves from whatever tags are already cached
# locally, without touching the network -- the same cached-only idiom
# compute_repo_behind_origin/compute_repo_behind_release use for their own
# default (non---check-origin) path. cmd_sync_check is the only caller that
# needs this: sync-check-verdicts R-001 and tui-self-update R-001 both
# require its default (no --check-origin/--fetch) path to invoke no
# `git fetch` at all, and every OTHER caller (cmd_apply, cmd_self_update,
# cmd_update, cmd_version) already requires or accepts a fresh fetch by its
# own spec/design, so they are left on the do_fetch=true default untouched.
resolve_latest_release_tag() {
  local ref="${1:-HEAD}"
  local do_fetch="${2:-true}"

  if [[ "$do_fetch" == true ]] && git remote get-url origin >/dev/null 2>&1; then
    # Bounded like every other network call this file makes (compute_repo_behind_origin,
    # compute_repo_behind_release, cmd_self_update's main fetch): this function is now
    # called from cmd_self_update, cmd_update, and cmd_sync_check's release_version line
    # (Slice 2), so a stalled connection here can no longer be a silent, unbounded hang.
    if command -v timeout >/dev/null 2>&1; then
      timeout 10 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
        fetch origin '+refs/tags/v*:refs/tags/v*' >/dev/null 2>&1 || true
    else
      git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
        fetch origin '+refs/tags/v*:refs/tags/v*' >/dev/null 2>&1 || true
    fi
  fi

  local tag objtype
  while IFS=$'\t' read -r tag objtype; do
    [[ -z "$tag" ]] && continue
    if [[ "$objtype" == "tag" ]]; then
      echo "$tag"
      return
    fi
  done < <(git for-each-ref --merged "$ref" --sort=-v:refname \
             --format=$'%(refname:short)\t%(objecttype)' 'refs/tags/v*' 2>/dev/null)

  echo "none"
}

# compute_target_digest <target> <live|ref>
#
# Design decision D5: one aggregate sha256 digest per deployment target,
# over sorted "<repo_rel>:<filehash>" lines -- one line per MANAGED manifest
# row that routes to <target> (custom rows are user-owned and excluded,
# matching overlay-release-state R-002's "managed file" wording). Manifest
# row order is not itself sorted, so lines are sorted with LC_ALL=C before
# hashing: this is what makes the digest invariant to manifest reordering
# while still sensitive to any single file's content.
#
# "live" reads each row's deployed destination file for <target> (what's
# actually installed there right now); "ref" reads the repo-source file
# instead (this checkout's current working tree content, independent of
# whether -- or what -- has been deployed). A missing file degrades to the
# literal "MISSING" token rather than aborting, so a never-deployed target
# still yields a real (if divergent) digest instead of erroring.
compute_target_digest() {
  local target="$1"
  local mode="$2"

  local lines=()
  while IFS= read -r rel_path; do
    local rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair rr_repo_rel path filehash
    rr_line="$(route_resolve "$rel_path")"
    rr_route="${rr_line%%$'\t'*}"
    rr_rest="${rr_line#*$'\t'}"
    rr_src="${rr_rest%%$'\t'*}"
    rr_targets="${rr_rest#*$'\t'}"

    rr_dest=""
    for rr_pair in $rr_targets; do
      [[ "${rr_pair%%:*}" == "$target" ]] && rr_dest="${rr_pair#*:}" && break
    done
    [[ -z "$rr_dest" ]] && continue

    if [[ "$mode" == "ref" ]]; then
      path="$rr_src"
    else
      path="$rr_dest"
    fi

    rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"

    if [[ -f "$path" ]]; then
      filehash="$(sha256sum "$path" | awk '{ print $1 }')"
    else
      filehash="MISSING"
    fi

    lines+=("${rr_repo_rel}:${filehash}")
  done < <(managed_files)

  printf '%s\n' "${lines[@]}" | LC_ALL=C sort | sha256sum | awk '{ print $1 }'
}

# state_read_target <target>
#
# Design decision D8: tolerant awk-based reader over the canonical JSON
# state file. Emits "<version>\t<digest>\t<applied_at>" for a recorded
# entry, or exactly the token "NEVER_DEPLOYED" when the state file is
# absent, has no entry for <target>, or fails to parse -- an unparseable
# file also prints a WARN rather than crashing (overlay-release-state
# R-001's "never deployed" honesty requirement).
state_read_target() {
  local target="$1"

  [[ -f "$STATE_FILE" ]] || { echo "NEVER_DEPLOYED"; return; }

  local line
  line="$(awk -v t="\"${target}\":" 'index($0, t) { print; exit }' "$STATE_FILE" 2>/dev/null || true)"

  if [[ -z "$line" ]]; then
    if [[ -s "$STATE_FILE" ]]; then
      warn "state file $STATE_FILE has no parseable entry for target '$target' -- reporting never deployed"
    fi
    echo "NEVER_DEPLOYED"
    return
  fi

  local version digest applied_at
  version="$(echo "$line" | awk -F'"version"[[:space:]]*:[[:space:]]*"' '{ print $2 }' | awk -F'"' '{ print $1 }')"
  digest="$(echo "$line" | awk -F'"digest"[[:space:]]*:[[:space:]]*"' '{ print $2 }' | awk -F'"' '{ print $1 }')"
  applied_at="$(echo "$line" | awk -F'"applied_at"[[:space:]]*:[[:space:]]*"' '{ print $2 }' | awk -F'"' '{ print $1 }')"

  if [[ -z "$version" || -z "$digest" ]]; then
    warn "state file $STATE_FILE entry for target '$target' is malformed -- reporting never deployed"
    echo "NEVER_DEPLOYED"
    return
  fi

  printf '%s\t%s\t%s\n' "$version" "$digest" "$applied_at"
}

# state_write_target <target> <version> <digest>
#
# Design decision D8: atomic tmp+mv rewrite of the whole canonical state
# file. Existing entries for OTHER targets are preserved by re-reading them
# through state_read_target -- if the prior file was corrupt, every "other"
# target degrades to never-deployed too (state_read_target's own
# tolerant-degrade behavior), so a corrupt state file self-heals into a
# clean one containing only what this call knows, rather than propagating
# the corruption forever.
state_write_target() {
  local target="$1"
  local version="$2"
  local digest="$3"
  local applied_at
  applied_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  mkdir -p "$STATE_DIR"

  local t existing v d a
  local entries=()
  for t in "${!TARGET_PATHS[@]}"; do
    [[ "$t" == "$target" ]] && continue
    existing="$(state_read_target "$t" 2>/dev/null || true)"
    [[ "$existing" == "NEVER_DEPLOYED" || -z "$existing" ]] && continue
    IFS=$'\t' read -r v d a <<< "$existing"
    entries+=("    \"${t}\": {\"version\": \"${v}\", \"digest\": \"${d}\", \"applied_at\": \"${a}\"}")
  done
  entries+=("    \"${target}\": {\"version\": \"${version}\", \"digest\": \"${digest}\", \"applied_at\": \"${applied_at}\"}")

  local tmp
  tmp="$(mktemp "${STATE_FILE}.XXXXXX")"
  {
    echo "{"
    echo "  \"schema\": 1,"
    echo "  \"targets\": {"
    local i n="${#entries[@]}"
    for ((i = 0; i < n; i++)); do
      if [[ "$i" -lt $((n - 1)) ]]; then
        echo "${entries[$i]},"
      else
        echo "${entries[$i]}"
      fi
    done
    echo "  }"
    echo "}"
  } > "$tmp"
  mv "$tmp" "$STATE_FILE"
}

# backup_target <target>
#
# overlay-backup-restore R-001 (design decision D3/D4): creates a
# timestamped backup of <target>'s CURRENTLY DEPLOYED managed files, but
# only for rows that are about to actually change -- a managed row whose
# live file does not yet exist (never deployed) or whose live file already
# matches the repo-source file about to be deployed (true no-op) has
# nothing meaningful to preserve, so it is excluded from both the
# needs-backup decision and the copy. Prints the created backup's
# timestamp directory name on stdout when a backup was made; prints
# nothing when the apply for this target is a full no-op. Backups live
# under $STATE_DIR/backups/<target>/<utc-ts>/ (D3), holding the full
# managed live-file set for the target under its repo-relative paths, plus
# a '.meta' file capturing the PRIOR state_read_target entry (read before
# any file is copied) so restore can recover the version that backup
# represents.
backup_target() {
  local target="$1"

  local -a changed_rel_paths=()
  local rel_path
  while IFS= read -r rel_path; do
    local rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair
    rr_line="$(route_resolve "$rel_path")"
    rr_route="${rr_line%%$'\t'*}"
    rr_rest="${rr_line#*$'\t'}"
    rr_src="${rr_rest%%$'\t'*}"
    rr_targets="${rr_rest#*$'\t'}"
    rr_dest=""
    for rr_pair in $rr_targets; do
      [[ "${rr_pair%%:*}" == "$target" ]] && rr_dest="${rr_pair#*:}" && break
    done
    [[ -z "$rr_dest" ]] && continue

    # Only an EXISTING live file that is about to be OVERWRITTEN needs
    # preserving. A row whose repo source is missing is skipped by apply
    # itself (never overwritten), and a target with no live file yet has
    # nothing to preserve -- both degrade to "nothing to back up" here.
    if [[ -f "$rr_dest" && -f "$rr_src" ]] && ! diff --brief "$rr_src" "$rr_dest" > /dev/null 2>&1; then
      changed_rel_paths+=("$rel_path")
    fi
  done < <(managed_files)

  # Explicit 'return 0' (not a bare 'return' after a failing [[ ]] test):
  # under this script's 'set -e', a bare 'return' here would propagate the
  # [[ ]] test's own nonzero status as this function's exit code, tripping
  # errexit for any caller that assigns its stdout via command substitution
  # (e.g. cmd_apply's `backup_ts="$(backup_target "$t")"`).
  [[ "${#changed_rel_paths[@]}" -gt 0 ]] || return 0

  local backups_dir="$STATE_DIR/backups/$target"
  mkdir -p "$backups_dir"

  local ts candidate suffix=0
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  candidate="$ts"
  while [[ -e "$backups_dir/$candidate" ]]; do
    suffix=$((suffix + 1))
    candidate="${ts}-${suffix}"
  done

  local backup_dir="$backups_dir/$candidate"
  mkdir -p "$backup_dir"

  for rel_path in "${changed_rel_paths[@]}"; do
    local rr_line rr_route rr_rest rr_targets rr_dest rr_pair rr_repo_rel dest_path
    rr_line="$(route_resolve "$rel_path")"
    rr_route="${rr_line%%$'\t'*}"
    rr_rest="${rr_line#*$'\t'}"
    rr_targets="${rr_rest#*$'\t'}"
    rr_dest=""
    for rr_pair in $rr_targets; do
      [[ "${rr_pair%%:*}" == "$target" ]] && rr_dest="${rr_pair#*:}" && break
    done
    [[ -z "$rr_dest" ]] && continue

    rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"
    dest_path="$backup_dir/$rr_repo_rel"
    mkdir -p "$(dirname "$dest_path")"
    cp "$rr_dest" "$dest_path"
  done

  local prior
  prior="$(state_read_target "$target" 2>/dev/null || true)"
  echo "$prior" > "$backup_dir/.meta"

  prune_backups "$target"

  echo "$candidate"
}

# prune_backups <target>
#
# overlay-backup-restore R-002 (design decision D4): retains only the 3
# most recent backups for a target, deleting older ones. Backup dir names
# are UTC timestamps (YYYYMMDDTHHMMSSZ, optionally suffixed by
# backup_target on a same-second collision, e.g. "<ts>-1"). Bash's own
# pathname expansion sorts the *globbed paths*, trailing slash included --
# that inverts a same-second collision, because ASCII '-' (0x2D) sorts
# before '/' (0x2F), so "<ts>-1/" sorts before "<ts>/" even though "<ts>-1"
# is the chronologically newer one. Re-sort the bare basenames explicitly
# so a same-second collision can't prune the wrong (newer) backup.
prune_backups() {
  local target="$1"
  local backups_dir="$STATE_DIR/backups/$target"

  [[ -d "$backups_dir" ]] || return 0

  local -a entries=()
  local d
  shopt -s nullglob
  for d in "$backups_dir"/*/; do
    entries+=("$(basename "$d")")
  done
  shopt -u nullglob

  if [[ "${#entries[@]}" -gt 0 ]]; then
    mapfile -t entries < <(printf '%s\n' "${entries[@]}" | LC_ALL=C sort)
  fi

  local total="${#entries[@]}"
  local keep=3
  [[ "$total" -le "$keep" ]] && return 0

  local excess=$((total - keep))
  local i
  for ((i = 0; i < excess; i++)); do
    rm -rf "${backups_dir:?}/${entries[$i]}"
  done
}

# route_tar_path resolves where a manifest row is stored inside a backup tarball.
# The legacy backup layout is under ~/.claude. OpenCode-native agent rows must use
# ~/.config/opencode instead.
route_tar_path() {
  local route="$1"
  local repo_rel="$2"  # output of route_repo_rel()

  case "$route" in
    opencode-agent)
      printf 'files/home/labdrian/.config/opencode/%s' "${repo_rel#opencode/}"
      ;;
    *)
      printf 'files/home/labdrian/.claude/%s' "$repo_rel"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# bootstrap
# ---------------------------------------------------------------------------

cmd_bootstrap() {
  info "Bootstrapping overlay repo at $OVERLAY_DIR"

  # 1. Init git repo if needed
  if [[ ! -d "$OVERLAY_DIR/.git" ]]; then
    git init "$OVERLAY_DIR"
  fi

  cd "$OVERLAY_DIR"

  # 2. Ensure all required directories exist
  mkdir -p bin \
    skills/sdd-spec \
    skills/sdd-tasks \
    skills/sdd-verify/references \
    skills/requirements-from-transcripts

  # 3. Write scaffold files if not present
  if [[ ! -f "$OVERLAY_DIR/README.md" ]]; then
    echo "# labdrian-sdd-overlay" > "$OVERLAY_DIR/README.md"
  fi
  if [[ ! -f "$OVERLAY_DIR/overlay.manifest" ]]; then
    die "overlay.manifest not found — ensure it exists before running bootstrap"
  fi
  if [[ ! -f "$OVERLAY_DIR/.gitignore" ]]; then
    printf '*.swp\n*.swo\n*~\n.DS_Store\n' > "$OVERLAY_DIR/.gitignore"
  fi

  # 4. Stage scaffold (bin/overlay itself is already here; stage it too)
  git add README.md overlay.manifest .gitignore bin/overlay

  # 5. Initial commit (only if none exists)
  if ! git log --oneline 2>/dev/null | head -1 | grep -q .; then
    git commit -m "chore: initial overlay scaffold"
  fi

  # 6. Create/switch to upstream branch
  git checkout -B upstream

  # 7. Extract managed files from tarball
  info "Extracting managed files from tarball: $TARBALL"
  if [[ ! -f "$TARBALL" ]]; then
    die "Tarball not found: $TARBALL"
  fi

  # Pre-build tar listing once to avoid SIGPIPE issues with set -euo pipefail
  local tar_listing
  tar_listing="$(tar tzf "$TARBALL" 2>/dev/null)"

  while IFS= read -r rel_path; do
    local rr_line rr_route rr_src rr_rest rr_repo_rel
    rr_line="$(route_resolve "$rel_path")"
    rr_route="${rr_line%%$'\t'*}"
    rr_rest="${rr_line#*$'\t'}"
    rr_src="${rr_rest%%$'\t'*}"
    rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"

    tar_path="$(route_tar_path "$rr_route" "$rr_repo_rel")"
    dest="$rr_src"
    ensure_parent "$dest"

    if echo "$tar_listing" | grep -qF "$tar_path"; then
      tar xzf "$TARBALL" --to-stdout "$tar_path" > "$dest"
      info "  extracted: ${rr_repo_rel}"
    else
      echo "  WARNING: not found in tarball, skipping: $tar_path"
    fi
  done < <(managed_files)

  # 8. Commit upstream baseline (only if there are changes)
  git add skills/
  test -d agents && git add agents/ || true
  test -d opencode && git add opencode/ || true
  if [[ -n "$(git status --porcelain)" ]]; then
    git commit -m "upstream: baseline from gentle-ai 1.40.2"
  else
    info "No changes to commit on upstream (already up to date)"
  fi

  # 9. Create main from upstream (AFTER upstream commit)
  git checkout -B main upstream

  # 10. Copy current customized files from live targets onto main
  info "Layering customized files onto main..."
  while IFS= read -r line; do
    rel_path="$(echo "$line" | awk '{ print $1 }')"
    local rr_line rr_src rr_rest rr_targets rr_dest rr_pair
    rr_line="$(route_resolve "$rel_path")"
    rr_rest="${rr_line#*$'\t'}"
    rr_src="${rr_rest%%$'\t'*}"      # repo dest
    rr_targets="${rr_rest#*$'\t'}"
    # Source from the claude live location when applicable (bootstrap layers from claude).
    rr_dest=""
    for rr_pair in $rr_targets; do
      [[ "${rr_pair%%:*}" == "claude" ]] && rr_dest="${rr_pair#*:}" && break
    done
    [[ -z "$rr_dest" ]] && continue

    src="${rr_dest}"
    dest="$rr_src"
    ensure_parent "$dest"

    if [[ -f "$src" ]]; then
      cp "$src" "$dest"
      info "  copied: $rel_path"
    else
      echo "  WARNING: source file not found, skipping: $src"
    fi
  done < <(parse_manifest)

  # 11. Commit overlay
  git add skills/
  test -d agents && git add agents/ || true
  test -d opencode && git add opencode/ || true
  if [[ -n "$(git status --porcelain)" ]]; then
    git commit -m "overlay: EARS notation + stable R-NNN IDs"
  else
    info "No customization diff detected — main is identical to upstream"
  fi

  echo ""
  echo "Bootstrap complete."
  echo "  upstream branch: pristine vendor baseline"
  echo "  main branch:     your customized overlay (current)"
  echo ""
  git log --oneline --all
}

# ---------------------------------------------------------------------------
# capture
# ---------------------------------------------------------------------------

cmd_capture() {
  cd "$OVERLAY_DIR"

  local from_backup=""
  local target_arg="claude"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --from-backup)
        shift
        from_backup="${1:-}"
        [[ -n "$from_backup" ]] || die "--from-backup requires a path argument"
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  # Validate single target (capture only supports one at a time)
  if [[ "$target_arg" == "all" ]]; then
    die "capture does not support --target all. Specify a single target: claude, opencode, codex"
  fi
  [[ -v TARGET_PATHS["$target_arg"] ]] || die "Unknown target: $target_arg. Valid: claude, opencode, codex"

  local target_dir="${TARGET_PATHS[$target_arg]}"

  # Refuse to run over uncommitted tracked changes: capture switches branches
  # and must never mix a dirty working tree into the sync commit.
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
    || die "Working tree has uncommitted tracked changes. Commit or stash them before capture."

  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"

  # Always return to the original branch, even if a later step fails under
  # 'set -euo pipefail' — prevents stranding the working tree on 'upstream'.
  # Expand the branch name NOW: an EXIT trap fires after the function's locals
  # are gone, and referencing them there is an unbound variable under 'set -u'.
  trap "git checkout '${current_branch}' >/dev/null 2>&1 || true" EXIT

  git checkout upstream

  # Reconcile with origin before capturing. 'upstream' is a mechanical
  # mirror pushed immediately after every capture (see below), so it should
  # normally already match origin/upstream — but if origin/upstream advanced
  # independently since this clone's last fetch (another machine captured
  # and pushed, or a manual reconcile merge landed there), a stale local ref
  # makes the push below either get rejected non-fast-forward (crashing the
  # whole capture under 'set -euo pipefail' despite the local capture
  # already having succeeded) or, worse, silently skip the push entirely
  # (the "anything to push?" check below reads the same stale cached
  # origin/upstream). Fetch first so that check is accurate, then
  # fast-forward when possible; when local ALSO carries unpushed commits,
  # merge non-interactively rather than discarding them — capture's own
  # comment below already promises a sync never strands local-only commits.
  # A fetch failure (offline) degrades gracefully: capture's core job is the
  # local commit, not the network round trip, so warn and proceed rather
  # than dying (parity with the "no origin remote" skip a few lines down).
  if git remote get-url origin >/dev/null 2>&1; then
    if git fetch origin upstream >/dev/null 2>&1; then
      if git rev-parse --verify -q origin/upstream >/dev/null; then
        if ! git merge --ff-only origin/upstream >/dev/null 2>&1; then
          git merge --no-edit origin/upstream \
            || die "'upstream' diverged from origin/upstream and auto-merge conflicted; resolve manually on the 'upstream' branch, then retry capture."
          info "Reconciled local 'upstream' with origin/upstream before capturing"
        fi
      fi
    else
      warn "git fetch origin upstream failed — proceeding without reconciling; push below may fail if origin has advanced"
    fi
  fi

  if [[ -n "$from_backup" ]]; then
    info "Capturing managed files from tarball: $from_backup"
    [[ -f "$from_backup" ]] || die "Tarball not found: $from_backup"

    local cap_listing
    cap_listing="$(tar tzf "$from_backup" 2>/dev/null)"

    while IFS= read -r rel_path; do
      local rr_line rr_route rr_src rr_rest rr_repo_rel
      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"

      tar_path="$(route_tar_path "$rr_route" "$rr_repo_rel")"
      dest="$rr_src"
      ensure_parent "$dest"

      if echo "$cap_listing" | grep -qF "$tar_path"; then
        tar xzf "$from_backup" --to-stdout "$tar_path" > "$dest"
        info "  extracted: ${rr_repo_rel}"
      else
        echo "  WARNING: not found in tarball, skipping: $tar_path"
      fi
    done < <(managed_files)
  else
    info "Capturing managed files from $target_dir"
    while IFS= read -r rel_path; do
      local rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair
      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_targets="${rr_rest#*$'\t'}"
      # Find live path for the requested target; skip if not applicable (e.g. native agent + codex)
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$target_arg" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      src="$rr_dest"
      dest="$rr_src"
      ensure_parent "$dest"

      if [[ -f "$src" ]]; then
        cp "$src" "$dest"
        info "  copied: $rel_path"
      else
        echo "  WARNING: source file not found, skipping: $src"
      fi
    done < <(managed_files)
  fi

  git add skills/
  test -d "$OVERLAY_DIR/agents" && git add agents/ || true
  test -d "$OVERLAY_DIR/opencode" && git add opencode/ || true
  # Commit only if deployable tracked files have STAGED changes. `git diff --cached --quiet`
  # ignores unrelated untracked paths (.engram/, tui/) present on 'upstream'
  # that previously caused a doomed `git commit` (exit 1) stranding the tree.
  if git diff --cached --quiet; then
    info "No changes detected — upstream already up to date"
  else
    git commit -m "upstream: sync from gentle-ai $(date +%Y-%m-%d)"
    info "upstream updated"
  fi

  # 'upstream' is a mechanical mirror of gentle-ai — push it immediately so a
  # sync never strands local-only commits (also flushes earlier unpushed runs).
  # A repo with no 'origin' remote (tests, detached mirrors) has nowhere to
  # push: skip loudly instead of failing the capture that already committed.
  if ! git remote get-url origin >/dev/null 2>&1; then
    info "No 'origin' remote — skipping upstream push"
  elif git rev-parse --verify -q origin/upstream >/dev/null; then
    if [[ -n "$(git rev-list origin/upstream..upstream)" ]]; then
      git push origin upstream
      info "Pushed upstream to origin"
    fi
  else
    git push -u origin upstream
    info "Pushed upstream to origin (new remote branch)"
  fi

  git checkout "$current_branch"
  trap - EXIT
  info "Returned to branch: $current_branch"
}

# ---------------------------------------------------------------------------
# apply
# ---------------------------------------------------------------------------

cmd_apply() {
  cd "$OVERLAY_DIR"

  local target_arg="all"
  local push_main=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --push)
        push_main=1
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  # Refuse to run over uncommitted tracked changes: apply switches branches
  # and merges, and must never entangle a session's work in progress.
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
    || die "Working tree has uncommitted tracked changes. Commit or stash them before apply."

  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"

  # Always return to the original branch, even if a later step fails — apply
  # must never strand a session's checkout on 'main'. On merge conflicts git
  # refuses the checkout, so the trap degrades to staying on main to resolve.
  # Expand the branch name NOW: an EXIT trap fires after the function's locals
  # are gone, and referencing them there is an unbound variable under 'set -u'.
  trap "git checkout '${current_branch}' >/dev/null 2>&1 || true" EXIT

  git checkout main

  info "Merging upstream into main..."
  if ! git merge upstream; then
    echo ""
    echo "MERGE CONFLICTS detected. Resolve the following files, then run:"
    echo "  git -C \"$OVERLAY_DIR\" add <file>"
    echo "  git -C \"$OVERLAY_DIR\" commit"
    echo "  overlay apply  (re-run to deploy after resolving)"
    echo ""
    echo "Conflicted files:"
    git diff --name-only --diff-filter=U
    exit 1
  fi

  # Resolved once (repo-level, not target-scoped): the release version this
  # apply is deploying. D1's pre-first-tag bootstrap records "untagged"
  # rather than fabricating or failing when no release tag exists yet; the
  # per-target digest recorded below is still real either way.
  local release_version
  release_version="$(resolve_latest_release_tag main)"
  [[ "$release_version" == "none" ]] && release_version="untagged"

  # D13: set when any manifest row processed below resolves to route=mcp.
  # cmd_longterm_mem install is invoked once, after the ENTIRE deploy loop
  # below (all targets), not once per target inside it — see the flag check
  # after the loop.
  local saw_mcp_row=""

  for t in $(resolve_targets "$target_arg"); do
    local tpath="${TARGET_PATHS[$t]}"
    echo ""
    echo "=== Deploying to: $t ==="

    if [[ ! -d "$tpath" ]]; then
      mkdir -p "$tpath"
      echo "  (created target directory: $tpath)"
    fi

    # overlay-backup-restore R-001: snapshot this target's currently
    # deployed managed files BEFORE any of them are overwritten below.
    # backup_target itself no-ops (creates nothing, prints nothing) when
    # nothing would actually change for this target.
    local backup_ts
    backup_ts="$(backup_target "$t")"
    if [[ -n "$backup_ts" ]]; then
      echo "  backup: $backup_ts"
    fi

    local deployed=0
    local in_sync=0

    while IFS= read -r rel_path; do
      local rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair rr_repo_rel
      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_targets="${rr_rest#*$'\t'}"
      # D13: mcp-routed rows emit zero copy targets and would otherwise be
      # silently skipped by the "[[ -z "$rr_dest" ]] && continue" guard
      # below with no trace of ever having been seen — record the sighting
      # here, before that guard, so the install hook after the deploy loop
      # knows whether to fire (reusing route_resolve's own already-applied
      # route_reject_unrouted_longterm_mem guard for the same-pass rejection
      # of any unrouted/unrecognized longterm-mem/** row, task 9.11).
      if [[ "$rr_route" == "mcp" ]]; then
        saw_mcp_row=1
      fi
      # Find dest for the current target ($t); skip if not in applicable set
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$t" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      src="$rr_src"
      dest="$rr_dest"
      ensure_parent "$dest"

      if [[ -f "$src" ]]; then
        if [[ -f "$dest" ]] && diff --brief "$src" "$dest" > /dev/null 2>&1; then
          in_sync=$((in_sync + 1))
        else
          cp "$src" "$dest"
          deployed=$((deployed + 1))
        fi
      else
        rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"
        echo "  WARNING: ${rr_repo_rel} not found in overlay, skipping"
      fi
    done < <(all_tracked_files)

    echo "  $t: deployed=$deployed in-sync=$in_sync"

    # overlay-release-state R-001: persist this target's deployed version
    # and content digest so a target with no entry can be reported honestly
    # as "never deployed" rather than staying silently unversioned forever.
    local target_digest
    target_digest="$(compute_target_digest "$t" live)"
    state_write_target "$t" "$release_version" "$target_digest"
  done

  # D13: run the longterm-mem install path exactly once for this whole
  # apply invocation — never once per deploy target — passing through
  # apply's own --target selection unchanged.
  #
  # Its exit status is inspected, because this runs AFTER the loop above has
  # already committed each target's state row. An unchecked failure would
  # leave apply reporting success with no MCP server installed, and — since
  # the digests it just wrote are unchanged — a later apply would see
  # nothing to do and never retry. That degraded state would be sticky
  # rather than self-healing, so the failure is named loudly, the exact
  # recovery command is printed, and apply itself exits non-zero.
  #
  # The step goes through longtermmem_install_step rather than calling
  # cmd_longterm_mem here: see that function for why a bare call in this
  # condition context could not observe the failures it most needed to.
  local mcp_install_failed=""
  if [[ -n "$saw_mcp_row" ]]; then
    echo ""
    info "longterm-mem: mcp-routed row detected — running install once (D13)"
    if ! longtermmem_install_step "$target_arg"; then
      mcp_install_failed=1
    fi
  fi

  echo ""
  echo "Deploy complete."

  git checkout "$current_branch"
  trap - EXIT
  info "Returned to branch: $current_branch"

  # main is never pushed silently: pushing main is deliberate delivery. An
  # explicit --push must push or fail loudly — never no-op — so it runs
  # unconditionally ('set -euo pipefail' aborts if the remote is unreachable).
  # Without --push, make any local-only divergence loud.
  if [[ -n "$push_main" ]]; then
    git push origin main
    info "Pushed main to origin"
  elif git rev-parse --verify -q origin/main >/dev/null; then
    local ahead
    ahead="$(git rev-list --count origin/main..main)"
    if [[ "$ahead" -gt 0 ]]; then
      echo ""
      echo "NOTICE: local main is $ahead commit(s) ahead of origin/main."
      echo "  Push deliberately with: overlay apply --push"
      echo "  or: git -C \"$OVERLAY_DIR\" push origin main"
    fi
  fi

  # Deploy itself succeeded, but a failed mcp install must not exit 0.
  [[ -n "$mcp_install_failed" ]] && return 1
  return 0
}

# ---------------------------------------------------------------------------
# self-update
# ---------------------------------------------------------------------------

# Fast-forwards ONLY the local 'main' branch and restores the original
# branch afterward, via the same trap-based EXIT pattern used by
# cmd_capture/cmd_apply. Every refusal (no origin, dirty tree, local-ahead
# divergence) fires BEFORE any checkout, so a refusal never touches the
# working tree or leaves the caller's branch stranded. Flagless: this signal
# is repo-level, not target-scoped.
#
# R-004 (MODIFIED): once at least one release tag exists anywhere, main
# converges to the highest semver-ordered release tag reachable from
# origin/main -- NEVER to origin/main's raw HEAD, which may carry untagged
# commits beyond the latest tag. D1's pre-first-tag bootstrap keeps the
# original origin/main-HEAD convergence verbatim (legacy path below) until
# the very first release tag is cut, so every zero-tag caller keeps its
# exact documented behavior.
cmd_self_update() {
  cd "$OVERLAY_DIR"

  [[ $# -eq 0 ]] || die "Unknown option: $1"

  # 1. No 'origin' remote -> nothing to converge against.
  git remote get-url origin >/dev/null 2>&1 \
    || die "self-update requires an 'origin' remote; none is configured."

  # 2. Dirty tracked tree -> hard refusal, before any checkout, fetch, or tag
  #    resolution. Untracked files are ignored (capture/apply parity).
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
    || die "Working tree has uncommitted tracked changes. Commit or stash them before self-update."

  # 3. Bounded fetch of main only (idiom from compute_repo_behind_origin).
  #    'timeout' is optional -- not on stock macOS -- so this degrades to an
  #    unbounded (but still low-speed-guarded) fetch rather than a hard dep.
  #    Also refreshes the ref resolve_latest_release_tag below resolves
  #    tags against.
  if command -v timeout >/dev/null 2>&1; then
    timeout 10 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin main \
      || die "git fetch origin main failed."
  else
    git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin main \
      || die "git fetch origin main failed."
  fi

  # 4. Local main ahead of origin/main -> hard refusal (R-006), unaffected by
  #    tag mode: self-update converges main, it never silently diverges
  #    further from a local-only commit that only exists on this clone.
  local ahead
  ahead="$(git rev-list --count origin/main..main)"
  [[ "$ahead" -eq 0 ]] \
    || die "Local main is $ahead commit(s) ahead of origin/main; self-update refuses to diverge further. Resolve manually (e.g. 'overlay apply --push')."

  # 5. R-003/D1: resolve the highest release tag reachable from origin/main.
  #    "none" means no release tag exists anywhere yet -- fall back verbatim
  #    to the original origin/main-HEAD convergence (D1 pre-first-tag
  #    bootstrap).
  local release_tag
  release_tag="$(resolve_latest_release_tag origin/main)"

  if [[ "$release_tag" == "none" ]]; then
    info "no release tags yet -- legacy convergence"

    local behind
    behind="$(git rev-list --count main..origin/main)"
    if [[ "$behind" -eq 0 ]]; then
      info "main is already up to date with origin/main"
      return
    fi

    # Expand the branch name NOW: an EXIT trap fires after the function's
    # locals are gone, and referencing them there is an unbound variable
    # under 'set -u' (the c891c94 lesson).
    local current_branch old_main new_main
    current_branch="$(git rev-parse --abbrev-ref HEAD)"
    old_main="$(git rev-parse main)"

    trap "git checkout '${current_branch}' >/dev/null 2>&1 || true" EXIT

    git checkout main
    git merge --ff-only origin/main
    new_main="$(git rev-parse main)"

    git checkout "$current_branch"
    trap - EXIT

    info "Updated main: ${old_main:0:12}..${new_main:0:12} (fast-forward)"
    return
  fi

  # 6. Tag mode: converge main to the resolved tag's commit only -- NEVER
  #    past it, even when origin/main's raw HEAD carries untagged commits
  #    beyond this tag. merge-base --is-ancestor also covers "main is
  #    already AHEAD of this tag" (e.g. a prior self-update already landed
  #    it) as a no-op, not only exact equality.
  local target_commit main_head
  target_commit="$(git rev-parse "${release_tag}^{commit}")"
  main_head="$(git rev-parse main)"

  if git merge-base --is-ancestor "$target_commit" "$main_head"; then
    info "main is already up to date with $release_tag"
    return
  fi

  local current_branch old_main new_main
  current_branch="$(git rev-parse --abbrev-ref HEAD)"
  old_main="$main_head"

  trap "git checkout '${current_branch}' >/dev/null 2>&1 || true" EXIT

  git checkout main
  git merge --ff-only "$target_commit"
  new_main="$(git rev-parse main)"

  git checkout "$current_branch"
  trap - EXIT

  info "Updated main: ${old_main:0:12}..${new_main:0:12} (fast-forward) -> $release_tag"
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------

# Read-only update-availability check (overlay-update-check R-001, design
# D6). Refreshes ONLY refs/tags/*/refs/remotes/* -- a bounded 'git fetch
# origin main' plus resolve_latest_release_tag's own explicit tag fetch --
# and NEVER touches a local branch head, the working tree, target files, or
# the state file. A fetch is byte-idempotent absent a remote change, so
# running this twice in a row leaves every git ref, target file, and
# state-file byte identical (R-001's zero-mutation scenario).
cmd_update() {
  cd "$OVERLAY_DIR"

  [[ $# -eq 0 ]] || die "Unknown option: $1"

  if git remote get-url origin >/dev/null 2>&1; then
    if command -v timeout >/dev/null 2>&1; then
      timeout 10 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin main \
        >/dev/null 2>&1 || warn "git fetch origin main failed -- reporting from cached refs"
    else
      git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin main \
        >/dev/null 2>&1 || warn "git fetch origin main failed -- reporting from cached refs"
    fi
  else
    warn "no 'origin' remote configured -- reporting from cached refs only"
  fi

  local latest_ref="main"
  git rev-parse --verify -q refs/remotes/origin/main >/dev/null 2>&1 && latest_ref="origin/main"

  local release_version
  release_version="$(resolve_latest_release_tag "$latest_ref")"

  if [[ "$release_version" == "none" ]]; then
    echo "Latest release: (no releases published yet)"
  else
    echo "Latest release: $release_version"
  fi

  for t in $(resolve_targets all); do
    local recorded recorded_version recorded_digest
    recorded="$(state_read_target "$t")"

    if [[ "$recorded" == "NEVER_DEPLOYED" ]]; then
      echo "  $t: never deployed"
      continue
    fi

    IFS=$'\t' read -r recorded_version recorded_digest _ <<< "$recorded"

    if [[ "$release_version" == "none" ]]; then
      echo "  $t: $recorded_version (no releases published yet)"
    elif [[ "$recorded_version" == "$release_version" ]]; then
      echo "  $t: up-to-date ($recorded_version)"
    else
      echo "  $t: behind ($release_version available, have $recorded_version)"
    fi
  done
}

# ---------------------------------------------------------------------------
# restore
# ---------------------------------------------------------------------------

# cmd_restore --target <t> [--list] [--backup <ts>]
#
# overlay-backup-restore R-003, design decision D4: rolls a single target
# back from one of its retained backups (default: most recent). Refuses
# --target all (a single-target destructive rollback, never a blanket one).
# --list prints the retained backups (newest last) without touching
# anything. --backup <ts> selects a specific retained backup instead of the
# most recent. Deliberately performs ZERO git operations (design.md threat
# matrix) and never `cd`s into $OVERLAY_DIR: it only reads $MANIFEST (an
# absolute path already) to map repo-relative backup entries back onto
# their live destinations, and reads/writes files under
# $STATE_DIR/backups/<target>/ and the target's live directory.
cmd_restore() {
  local target_arg=""
  local list_mode=0
  local backup_ts=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --list)
        list_mode=1
        ;;
      --backup)
        shift
        backup_ts="${1:-}"
        [[ -n "$backup_ts" ]] || die "--backup requires a timestamp argument"
        ;;
      *) die "Unknown option: $1. Usage: overlay restore --target claude|opencode|codex [--list] [--backup TIMESTAMP]" ;;
    esac
    shift || true
  done

  [[ -n "$target_arg" ]] || die "restore requires --target claude|opencode|codex"
  [[ "$target_arg" != "all" ]] \
    || die "restore does not support --target all. Specify a single target: claude, opencode, codex"
  [[ -v TARGET_PATHS["$target_arg"] ]] \
    || die "Unknown target: $target_arg. Valid: claude, opencode, codex"

  local backups_dir="$STATE_DIR/backups/$target_arg"

  local -a entries=()
  local d
  shopt -s nullglob
  for d in "$backups_dir"/*/; do
    entries+=("$(basename "$d")")
  done
  shopt -u nullglob

  # See prune_backups' comment: bash's glob sorts the paths *with* their
  # trailing slash, which inverts a same-second collision suffix ("<ts>-1"
  # sorting before "<ts>" instead of after it). Re-sort the bare basenames
  # so both --list and the "most recent" default (below) are correct even
  # when two backups for the same target were taken in the same second.
  if [[ "${#entries[@]}" -gt 0 ]]; then
    mapfile -t entries < <(printf '%s\n' "${entries[@]}" | LC_ALL=C sort)
  fi

  if [[ "$list_mode" -eq 1 ]]; then
    if [[ "${#entries[@]}" -eq 0 ]]; then
      echo "No backups available for target '$target_arg'."
      return
    fi
    echo "Backups for $target_arg (newest last):"
    local e meta version
    for e in "${entries[@]}"; do
      version="unknown"
      if [[ -f "$backups_dir/$e/.meta" ]]; then
        meta="$(cat "$backups_dir/$e/.meta")"
        if [[ "$meta" != "NEVER_DEPLOYED" && -n "$meta" ]]; then
          version="$(echo "$meta" | awk -F'\t' '{ print $1 }')"
        fi
      fi
      echo "  $e ($version)"
    done
    return
  fi

  if [[ "${#entries[@]}" -eq 0 ]]; then
    die "No backups available for target '$target_arg'. Nothing to restore."
  fi

  local selected
  if [[ -n "$backup_ts" ]]; then
    local found=0
    for e in "${entries[@]}"; do
      [[ "$e" == "$backup_ts" ]] && found=1 && break
    done
    [[ "$found" -eq 1 ]] \
      || die "Backup '$backup_ts' not found for target '$target_arg'. Run 'overlay restore --target $target_arg --list' to see available backups."
    selected="$backup_ts"
  else
    # 'entries' was explicitly re-sorted above; the last element is the
    # most recent backup (D4 default).
    selected="${entries[-1]}"
  fi

  local backup_dir="$backups_dir/$selected"

  info "Restoring $target_arg from backup $selected..."

  while IFS= read -r rel_path; do
    local rr_line rr_route rr_rest rr_targets rr_dest rr_pair rr_repo_rel src_path
    rr_line="$(route_resolve "$rel_path")"
    rr_route="${rr_line%%$'\t'*}"
    rr_rest="${rr_line#*$'\t'}"
    rr_targets="${rr_rest#*$'\t'}"
    rr_dest=""
    for rr_pair in $rr_targets; do
      [[ "${rr_pair%%:*}" == "$target_arg" ]] && rr_dest="${rr_pair#*:}" && break
    done
    [[ -z "$rr_dest" ]] && continue

    rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"
    src_path="$backup_dir/$rr_repo_rel"

    if [[ -f "$src_path" ]]; then
      ensure_parent "$rr_dest"
      cp "$src_path" "$rr_dest"
    fi
  done < <(managed_files)

  local restored_digest
  restored_digest="$(compute_target_digest "$target_arg" live)"

  local restored_version="untagged"
  if [[ -f "$backup_dir/.meta" ]]; then
    local meta_content
    meta_content="$(cat "$backup_dir/.meta")"
    if [[ "$meta_content" != "NEVER_DEPLOYED" && -n "$meta_content" ]]; then
      restored_version="$(echo "$meta_content" | awk -F'\t' '{ print $1 }')"
    fi
  fi

  state_write_target "$target_arg" "$restored_version" "$restored_digest"

  info "Restored $target_arg from backup $selected (version $restored_version)."
}

# ---------------------------------------------------------------------------
# version
# ---------------------------------------------------------------------------

# cmd_version (overlay-release-surfacing R-002; also reachable via the
# --version flag, see dispatch below): reports this clone's own current
# release version (resolved from local 'main', matching what 'apply' would
# deploy right now -- unlike 'update', which checks the newest PUBLISHED
# release on origin) and, per target, its recorded deployed version. A
# target with no recorded state is reported as "never deployed" rather than
# a stale or fabricated version (R-002).
cmd_version() {
  cd "$OVERLAY_DIR"

  [[ $# -eq 0 ]] || die "Unknown option: $1"

  local repo_version
  repo_version="$(resolve_latest_release_tag main)"

  if [[ "$repo_version" == "none" ]]; then
    echo "Repository version: (no releases published yet)"
  else
    echo "Repository version: $repo_version"
  fi

  for t in $(resolve_targets all); do
    local recorded recorded_version recorded_digest
    recorded="$(state_read_target "$t")"

    if [[ "$recorded" == "NEVER_DEPLOYED" ]]; then
      echo "  $t: never deployed"
      continue
    fi

    IFS=$'\t' read -r recorded_version recorded_digest _ <<< "$recorded"

    if [[ "$repo_version" != "none" && "$recorded_version" != "$repo_version" ]]; then
      echo "  $t: $recorded_version (behind)"
    else
      echo "  $t: $recorded_version"
    fi
  done
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

cmd_status() {
  cd "$OVERLAY_DIR"

  local target_arg="all"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  echo "=== Branch ==="
  git rev-parse --abbrev-ref HEAD

  echo ""
  echo "=== Diff stat upstream..main ==="
  git diff --stat upstream..main || echo "(no diff)"

  for t in $(resolve_targets "$target_arg"); do
    local tpath="${TARGET_PATHS[$t]}"
    echo ""
    echo "=== Status: $t ==="

    while IFS= read -r rel_path; do
      local rr_line rr_src rr_targets rr_dest rr_pair
      rr_line="$(route_resolve "$rel_path")"
      rr_src="${rr_line#*$'\t'}"; rr_src="${rr_src%%$'\t'*}"
      rr_targets="${rr_line##*$'\t'}"
      # Find live_file for this target; skip if route not applicable
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$t" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      repo_file="$rr_src"
      live_file="$rr_dest"

      if [[ ! -f "$repo_file" ]]; then
        echo "  MISSING in repo: $rel_path"
      elif [[ ! -f "$live_file" ]]; then
        echo "  MISSING in target: $rel_path"
      else
        if diff --brief "$repo_file" "$live_file" > /dev/null 2>&1; then
          echo "  in sync  : $rel_path"
        else
          echo "  DIFFERS  : $rel_path"
        fi
      fi
    done < <(all_tracked_files)

    # overlay-release-state R-001/R-002, sync-check-verdicts R-008: report
    # this target's recorded release version against its live aggregate
    # digest, independent of the per-file drift lines above.
    local target_digest recorded recorded_version recorded_digest
    target_digest="$(compute_target_digest "$t" live)"
    recorded="$(state_read_target "$t")"
    if [[ "$recorded" == "NEVER_DEPLOYED" ]]; then
      echo "  version: never deployed"
    else
      IFS=$'\t' read -r recorded_version recorded_digest _ <<< "$recorded"
      if [[ "$target_digest" == "$recorded_digest" ]]; then
        echo "  version: in sync at $recorded_version"
      else
        echo "  version: $recorded_version (drift detected -- run 'overlay apply --target $t')"
      fi
    fi
  done
}

# ---------------------------------------------------------------------------
# sync-check
# ---------------------------------------------------------------------------

# Computes how many commits local main is behind this repo's own origin/main,
# repo-level (not target-scoped). Emits an integer count on stdout, or the
# literal token "NA" when the comparison is unavailable (no origin remote, no
# cached ref, or a requested live fetch failed).
#
# When check_origin is "true", runs `git fetch origin` first for a live
# comparison. Every new git invocation here is wrapped in the same
# `if <cmd> 2>/dev/null; then ... else ...NA...; fi` guard idiom already used
# elsewhere in this function (precedent: line ~854, `if git cat-file -e
# "main:${rr_repo_rel}" 2>/dev/null; then ...`), so a missing remote/ref or a
# failed fetch degrades to NA instead of aborting the script under
# `set -euo pipefail`.
#
# The fetch is best-effort time-bounded (wrapped in `timeout` when that
# coreutil is available -- not on stock macOS, so this degrades gracefully
# rather than being a hard new dependency) so a stalled network path (VPN
# half-up, black-holed proxy) cannot hang sync-check indefinitely; a
# `low-speed` git config guards the HTTPS-transport case the same way.
#
# Every NA-producing branch below writes a one-line explanation to stderr
# (not stdout, so it never contaminates the count/NA value captured by
# callers via command substitution) using the `SYNC_CHECK:(repo):` prefix --
# "(repo)" is a deliberate, documented repo-scope marker distinct from the
# `SYNC_CHECK:$t:` per-target prefix used elsewhere in this file (this
# comparison is repo-level, not target-scoped, and no real target name would
# fit here). The fetch-failure branch additionally includes the first line
# of git's own error text, so a security-relevant failure (e.g. a host-key
# mismatch or TLS verification error) is distinguishable from a benign
# offline failure instead of both collapsing into the same generic message.
compute_repo_behind_origin() {
  local check_origin="$1"

  if ! git remote get-url origin >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no 'origin' remote configured -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
    return
  fi

  if [[ "$check_origin" == true ]]; then
    local fetch_err="" fetch_ok=true
    if command -v timeout >/dev/null 2>&1; then
      fetch_err="$(timeout 10 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin 2>&1 >/dev/null)" || fetch_ok=false
    else
      fetch_err="$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin 2>&1 >/dev/null)" || fetch_ok=false
    fi
    if [[ "$fetch_ok" == false ]]; then
      local fetch_err_line="${fetch_err%%$'\n'*}"
      echo "SYNC_CHECK:(repo): git fetch origin failed -- degrading REPO_BEHIND_ORIGIN to NA (${fetch_err_line:-no error output})" >&2
      echo "NA"
      return
    fi
  fi

  if ! git rev-parse --verify -q refs/remotes/origin/main >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no cached refs/remotes/origin/main (never fetched) -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
    return
  fi

  # Compared against local 'main', never the checked-out branch (HEAD). This
  # must track the exact ref self-update converges: self-update fast-forwards
  # ONLY main and always returns to whatever branch was current (D1-D3), so a
  # HEAD-relative comparison stays nonzero forever when the current branch
  # isn't main -- the TUI's "Actualizar repositorio" button would fast-forward
  # main for real but its own banner would never report convergence. This is
  # also the same ref cmd_sync_check's own per-file comparisons already use
  # ("main:${rr_repo_rel}" below), so this makes the diagnostic agree with
  # both its producer (self-update) and its sibling check (per-file drift).
  if ! git rev-parse --verify -q refs/heads/main >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no local 'main' branch -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
    return
  fi

  local count
  if count="$(git rev-list main..origin/main --count 2>/dev/null)"; then
    echo "$count"
  else
    echo "SYNC_CHECK:(repo): git rev-list main..origin/main failed -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
  fi
}

# compute_repo_behind_release <check_origin>
#
# Design decision D2: how many commits local main is behind the newest
# LOCALLY-KNOWN annotated v*-tag reachable from this repo's cached
# refs/remotes/origin/main -- cached-only by default, exactly like its
# sibling compute_repo_behind_origin, so a plain 'sync-check'/'status' never
# hits the network. Pass check_origin=true (mirrors sync-check's
# --check-origin/--fetch flag) to explicitly refresh v*-tags from origin
# first, still without moving any local branch head.
#
# Filtering candidate tags with --merged origin/main (rather than every known
# tag) keeps this consistent with resolve_latest_release_tag's own
# reachability rule and avoids a rogue/unrelated-branch tag producing a
# nonsensical count. Emits the literal token "NA" whenever no cached
# origin/main ref, no local main branch, or no qualifying tag exists yet
# (D1's pre-first-tag bootstrap) -- never an error.
compute_repo_behind_release() {
  local check_origin="$1"

  if ! git remote get-url origin >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no 'origin' remote configured -- REPO_BEHIND_RELEASE unavailable" >&2
    echo "NA"
    return
  fi

  if [[ "$check_origin" == true ]]; then
    if command -v timeout >/dev/null 2>&1; then
      timeout 10 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
        fetch origin '+refs/tags/v*:refs/tags/v*' >/dev/null 2>&1 || true
    else
      git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
        fetch origin '+refs/tags/v*:refs/tags/v*' >/dev/null 2>&1 || true
    fi
  fi

  if ! git rev-parse --verify -q refs/remotes/origin/main >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no cached refs/remotes/origin/main (never fetched) -- REPO_BEHIND_RELEASE unavailable" >&2
    echo "NA"
    return
  fi

  if ! git rev-parse --verify -q refs/heads/main >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no local 'main' branch -- REPO_BEHIND_RELEASE unavailable" >&2
    echo "NA"
    return
  fi

  local tag objtype latest_tag=""
  while IFS=$'\t' read -r tag objtype; do
    [[ -z "$tag" ]] && continue
    if [[ "$objtype" == "tag" ]]; then
      latest_tag="$tag"
      break
    fi
  done < <(git for-each-ref --merged origin/main --sort=-v:refname \
             --format=$'%(refname:short)\t%(objecttype)' 'refs/tags/v*' 2>/dev/null)

  if [[ -z "$latest_tag" ]]; then
    echo "SYNC_CHECK:(repo): no release tag known yet -- REPO_BEHIND_RELEASE unavailable" >&2
    echo "NA"
    return
  fi

  local count
  if count="$(git rev-list --count "main..${latest_tag}" 2>/dev/null)"; then
    echo "$count"
  else
    echo "SYNC_CHECK:(repo): git rev-list main..${latest_tag} failed -- REPO_BEHIND_RELEASE unavailable" >&2
    echo "NA"
  fi
}

cmd_sync_check() {
  cd "$OVERLAY_DIR"

  local target_arg="all"
  local check_origin=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --check-origin|--fetch)
        check_origin=true
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  local repo_behind_origin
  repo_behind_origin="$(compute_repo_behind_origin "$check_origin")"

  local repo_behind_release
  repo_behind_release="$(compute_repo_behind_release "$check_origin")"

  # overlay-update-check/overlay-release-identity: the release `apply` would
  # currently deploy, resolved from local main (D1 fallback: "untagged").
  # Cached-only unless --check-origin/--fetch was passed (mirrors
  # compute_repo_behind_origin/compute_repo_behind_release just above) --
  # sync-check-verdicts R-001 and tui-self-update R-001 both require this
  # default path to invoke no `git fetch`.
  local release_version
  release_version="$(resolve_latest_release_tag main "$check_origin")"
  [[ "$release_version" == "none" ]] && release_version="untagged"

  for t in $(resolve_targets "$target_arg"); do
    local tpath="${TARGET_PATHS[$t]}"
    echo ""
    echo "=== sync-check: $t ($tpath) ==="

    if [[ ! -d "$tpath" ]]; then
      echo "SYNC_CHECK:$t: target dir not found at $tpath -- skipping"
      continue
    fi

    local upstream_changed=0
    local overlay_not_deployed=0

    while IFS= read -r line; do
      local rel_path tag rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair rr_repo_rel
      rel_path="$(echo "$line" | awk '{ print $1 }')"
      tag="$(echo "$line" | awk '{ print $2 }')"

      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_targets="${rr_rest#*$'\t'}"
      rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"

      # Find live_file for this target; skip row if route not applicable
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$t" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      local live_file="$rr_dest"

      # Hash of live file (empty string if missing)
      local live_hash=""
      if [[ -f "$live_file" ]]; then
        live_hash="$(sha256sum "$live_file" | awk '{ print $1 }')"
      fi

      # Hash of main version in repo (CORRECTNESS-CRITICAL: use route subdir, not hardcoded skills/)
      local main_hash=""
      if git cat-file -e "main:${rr_repo_rel}" 2>/dev/null; then
        main_hash="$(git show "main:${rr_repo_rel}" 2>/dev/null | sha256sum | awk '{ print $1 }')"
      fi

      # PRIMARY check: live == main → IN SYNC, nothing to do
      if [[ -n "$live_hash" && "$live_hash" == "$main_hash" ]]; then
        echo "  IN_SYNC: ${rr_repo_rel}"
        continue
      fi

      # live != main (or live missing) — determine why
      if [[ -z "$live_hash" ]]; then
        # File missing at target
        overlay_not_deployed=$((overlay_not_deployed + 1))
        echo "  OVERLAY_NOT_DEPLOYED: ${rr_repo_rel} (live missing)"
        continue
      fi

      # Determine if this is a MANAGED file (exists on upstream branch)
      local is_managed=false
      if git cat-file -e "upstream:${rr_repo_rel}" 2>/dev/null; then
        is_managed=true
      fi

      if [[ "$is_managed" == true ]]; then
        # Compare live vs upstream to distinguish subtypes
        local upstream_hash
        upstream_hash="$(git show "upstream:${rr_repo_rel}" 2>/dev/null | sha256sum | awk '{ print $1 }')"

        if [[ "$live_hash" == "$upstream_hash" ]]; then
          # live == upstream but live != main → overlay not deployed (customization reverted)
          overlay_not_deployed=$((overlay_not_deployed + 1))
          echo "  OVERLAY_NOT_DEPLOYED: ${rr_repo_rel} (live matches upstream, customization not deployed)"
        else
          # live != upstream AND live != main → upstream has a new pristine version we haven't captured
          upstream_changed=$((upstream_changed + 1))
          echo "  UPSTREAM_CHANGED: ${rr_repo_rel}"
        fi
      else
        # CUSTOM file (no upstream counterpart): live != main → overlay not deployed
        overlay_not_deployed=$((overlay_not_deployed + 1))
        echo "  OVERLAY_NOT_DEPLOYED: ${rr_repo_rel} (custom file, not deployed)"
      fi

    done < <(parse_manifest)

    # sync-check-verdicts R-007/R-008: aggregate per-target digest vs. the
    # recorded deploy (from `apply`), independent of the per-file
    # classification above.
    local target_digest recorded recorded_version recorded_digest digest_match
    target_digest="$(compute_target_digest "$t" live)"
    recorded="$(state_read_target "$t")"
    if [[ "$recorded" == "NEVER_DEPLOYED" ]]; then
      recorded_version="NA"
      digest_match="NA"
    else
      IFS=$'\t' read -r recorded_version recorded_digest _ <<< "$recorded"
      if [[ "$target_digest" == "$recorded_digest" ]]; then
        digest_match="yes"
      else
        digest_match="no"
      fi
    fi

    echo ""
    echo "VERDICT:$t:UPSTREAM_CHANGED=$upstream_changed OVERLAY_NOT_DEPLOYED=$overlay_not_deployed REPO_BEHIND_ORIGIN=$repo_behind_origin REPO_BEHIND_RELEASE=$repo_behind_release RECORDED_VERSION=$recorded_version DIGEST_MATCH=$digest_match"

    if [[ "$upstream_changed" -gt 0 ]]; then
      echo "ACTION:$t: gentle-ai sync detected: run 'overlay capture --target $t' then 'overlay apply' to re-merge your customizations"
    elif [[ "$overlay_not_deployed" -gt 0 ]]; then
      # R-007: name the release `apply` would bring only when there IS a
      # recorded version that has gone stale (digest_match=no) -- a
      # genuinely never-deployed target (digest_match=NA) gets no
      # fabricated version, and the pre-first-tag bootstrap (no real
      # version to name yet) is never papered over either.
      if [[ "$digest_match" == "no" && "$release_version" != "untagged" ]]; then
        echo "ACTION:$t: run 'overlay apply --target $t' (release $release_version available)"
      else
        echo "ACTION:$t: run 'overlay apply --target $t'"
      fi
    elif [[ "$repo_behind_origin" != "NA" && "$repo_behind_origin" -gt 0 ]]; then
      echo "ACTION:$t: run 'git pull' to update your local clone (behind origin/main by $repo_behind_origin commit(s))"
    elif [[ "$digest_match" == "yes" ]]; then
      # R-008: name the matching version when fully in sync.
      echo "ACTION:$t: in sync with gentle-ai (healthy) at $recorded_version"
    else
      echo "ACTION:$t: in sync with gentle-ai (healthy)"
    fi
  done
}

# ---------------------------------------------------------------------------
# tui
# ---------------------------------------------------------------------------

cmd_tui() {
  command -v go >/dev/null 2>&1 || die "go is not installed; required to run the TUI"
  [[ -d "$OVERLAY_DIR/tui" ]] || die "tui/ not found at $OVERLAY_DIR/tui"
  # First-run convenience: a fresh clone only checks out `main`, but sync-check and
  # the dashboard need a local `upstream` ref. Materialize it from origin/upstream if
  # missing, so the user can go straight from `install-alias` to `tui` and do
  # everything else (capture / apply / install-hooks) from inside the dashboard.
  if ! git -C "$OVERLAY_DIR" show-ref --verify --quiet refs/heads/upstream \
     && git -C "$OVERLAY_DIR" show-ref --verify --quiet refs/remotes/origin/upstream; then
    git -C "$OVERLAY_DIR" branch --force upstream origin/upstream >/dev/null 2>&1 \
      && info "Materialized local 'upstream' branch from origin/upstream."
  fi
  # Export repo root so the Go program can locate bin/labdrian-overlay reliably.
  export OVERLAY_DIR
  # Run from inside the module dir (repo root is not a Go module).
  cd "$OVERLAY_DIR/tui"
  exec go run .
}

# ---------------------------------------------------------------------------
# Discovery tools — canonical list used by ensure_discovery_tools,
# recheck_discovery_tools, and cmd_doctor. Change once here to update all.
# ---------------------------------------------------------------------------

DISCOVERY_TOOLS=(bat rg fd sd eza)

# ---------------------------------------------------------------------------
# ensure_discovery_tools
# ---------------------------------------------------------------------------
#
# Best-effort, NON-FATAL, idempotent provisioner for the five CLI tools the
# persona rule mandates: bat rg fd sd eza.
#
# Contract:
#   - PORTABLE: uses only 'command -v' for detection; never calls fd/eza/bat
#     inside the helper itself.
#   - NON-FATAL: a provisioning failure MUST NOT abort the caller. All brew
#     invocations are guarded against 'set -e' via explicit if/then/else.
#   - TRANSPARENT: prints exactly what it will install and what succeeded/failed.
#   - IDEMPOTENT: skips tools already present; re-runs are safe.
#   - NO SIGPIPE: all output captured to vars before any comparison.
#
# Called by:
#   - cmd_install_hooks (best-effort, auto): runs after hooks are wired.
#   - cmd_doctor --fix (explicit opt-in): runs then re-checks tool status.

ensure_discovery_tools() {
  local -a missing=()

  # Probe each of the five mandated tools with 'command -v' — never assume
  # any are present, never use them for the probe itself.
  local t
  for t in "${DISCOVERY_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || missing+=("$t")
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    info "Discovery tools: all present (bat rg fd sd eza) — nothing to install."
    return 0
  fi

  if command -v brew >/dev/null 2>&1; then
    echo "==> Discovery tools missing: ${missing[*]}"
    echo "    Installing via Homebrew (best-effort)..."
    local -a succeeded=()
    local -a failed=()
    local tool
    for tool in "${missing[@]}"; do
      if brew install "$tool"; then
        # Re-probe after install to confirm it landed on PATH.
        if command -v "$tool" >/dev/null 2>&1; then
          succeeded+=("$tool")
        else
          # brew reported success but binary still not on PATH (e.g. PATH not
          # refreshed, cask install, prefix mismatch). Treat as non-fatal warn.
          warn "brew install $tool reported success but '$tool' is still not on PATH. You may need to reload your shell or adjust PATH."
          failed+=("$tool")
        fi
      else
        warn "brew install $tool failed — skipping (non-fatal)."
        failed+=("$tool")
      fi
    done
    if [[ ${#succeeded[@]} -gt 0 ]]; then
      info "Installed: ${succeeded[*]}"
    fi
    if [[ ${#failed[@]} -gt 0 ]]; then
      warn "Could not install: ${failed[*]}"
      warn "Install them manually so agents do not hit the silent-empty footgun."
      warn "The skill-discovery-safety guard remains the fallback for any session."
    fi
  else
    # No brew — warn loudly about the silent-empty trap but stay non-fatal.
    warn "Homebrew not found. The following discovery tools are missing: ${missing[*]}"
    warn "Without them, agents that run e.g. 'fd ... 2>/dev/null' get an empty"
    warn "result (command not found, swallowed) and may misread it as zero skills."
    warn "Install manually — typical options:"
    warn "  cargo install bat ripgrep fd-find sd eza   (Rust/cargo — most reliable)"
    warn "  Debian/Ubuntu (apt): 'bat' installs as 'batcat', 'fd' as 'fd-find' (binary:"
    warn "    'fdfind'); 'sd' and 'eza' are often absent or only in recent repos —"
    warn "    prefer cargo or a newer apt source for those."
    warn "  Fedora/RHEL (dnf): bat ripgrep fd-find eza  (sd may need cargo)"
    warn "  Arch (pacman): bat ripgrep fd sd eza"
    warn "The skill-discovery-safety guard is the fallback but not a substitute."
  fi

  return 0  # always non-fatal
}

# ---------------------------------------------------------------------------
# recheck_discovery_tools
# ---------------------------------------------------------------------------
#
# Re-probes DISCOVERY_TOOLS after a provisioning attempt and prints
# PASS or WARN. Single source of truth — used by both branches of cmd_doctor
# --fix (fail!=0 and fail==0). Always returns 0 (non-fatal).

recheck_discovery_tools() {
  local -a recheck_missing=()
  local t
  for t in "${DISCOVERY_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || recheck_missing+=("$t")
  done
  if [[ ${#recheck_missing[@]} -eq 0 ]]; then
    echo "PASS  ${DISCOVERY_TOOLS[*]} all present after provisioning."
  else
    echo "WARN  still missing after provisioning: ${recheck_missing[*]}"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# install-hooks
# ---------------------------------------------------------------------------
#
# Design decisions:
#   1. SEPARATE from 'overlay apply'. Skills deployment and hook wiring are
#      distinct operations — apply only copies files, never mutates
#      ~/.claude/settings.json. This keeps apply non-invasive.
#   2. DELIBERATE activation. The user must run 'overlay install-hooks'
#      intentionally. This satisfies the "INERT until user activates" contract.
#   3. MISSING-BINARY SAFETY. Hook commands emitted by the engine use the form:
#        command -v <binary> &>/dev/null && <binary> ... || true
#      This ensures any hook exits 0 even when the binary is absent, so no
#      Claude Code Task is ever blocked by a missing binary.
#   4. ATOMIC+BACKUP inside the engine. The engine's merge-settings subcommand
#      writes to a temp file and renames; it also copies the original to
#      settings.json.bak before overwriting.

cmd_install_hooks() {
  command -v go >/dev/null 2>&1 || die "go is not installed; required to build the engine"
  command -v gentle-ai >/dev/null 2>&1 || warn "gentle-ai not found on PATH — the overlay layers onto gentle-ai; hooks will install but skill propagation/scoping may be inert until gentle-ai is installed. Run 'overlay doctor' for a full preflight."
  [[ -d "$ENGINE_SRC" ]] || die "engine source not found at $ENGINE_SRC"

  info "Building engine binary..."
  mkdir -p "$(dirname "$ENGINE_BINARY")"
  (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/) \
    || die "go build failed; binary not deployed"
  info "Engine binary deployed to: $ENGINE_BINARY"

  local settings_path="$HOME/.claude/settings.json"
  info "Merging hooks into: $settings_path"
  "$ENGINE_BINARY" merge-settings \
    --settings "$settings_path" \
    --hook-command "$ENGINE_BINARY" \
    || die "merge-settings failed"

  echo ""
  echo "install-hooks complete."
  echo "  binary  : $ENGINE_BINARY"
  echo "  settings: $settings_path (backup at ${settings_path}.bak)"
  echo "  hooks   : four hook pairs (minimalism-contract + skill-discovery-safety"
  echo "            + anti-generic-design + review-projection-contract) wired"
  echo "            into UserPromptSubmit and PreToolUse/Agent (eight entries total)."
  echo ""
  echo "Deterministic scoping is now ACTIVE for Claude Code sessions."
  echo ""
  echo "Run 'overlay doctor' to verify the full installation."

  # Guard: if the standalone skill-discovery-safety.md has not been deployed yet
  # (user ran install-hooks but not 'overlay apply'), warn loudly so the safety
  # contract is not silently absent from the skill registry.
  local safety_path="$HOME/.claude/skills/_shared/skill-discovery-safety.md"
  if test -f "$safety_path"; then
    :
  else
    echo ""
    echo "WARNING: $safety_path not found."
    echo "  The safety contract is embedded in the engine binary and will propagate"
    echo "  via hooks, but the standalone copy has not been deployed yet."
    echo "  Run 'overlay apply' to deploy all skills, then 'overlay doctor' to verify."
  fi

  # Best-effort: provision discovery tools so agents don't hit the silent-empty
  # footgun on a fresh install. Non-fatal — a failure here must never abort
  # install-hooks. The skill-discovery-safety guard is the fallback.
  # Set OVERLAY_SKIP_TOOL_INSTALL=1 to opt out (e.g. in CI or managed hosts).
  if [[ -n "${OVERLAY_SKIP_TOOL_INSTALL:-}" ]]; then
    info "OVERLAY_SKIP_TOOL_INSTALL is set — skipping automatic discovery-tool installation."
    warn "Discovery tools (bat rg fd sd eza) were NOT auto-installed."
    warn "Run 'overlay doctor --fix' later to provision them when ready."
  else
    echo ""
    echo "==> Installing host packages via Homebrew: discovery tools (bat rg fd sd eza)."
    echo "    Set OVERLAY_SKIP_TOOL_INSTALL=1 to skip this step."
    ensure_discovery_tools
  fi
}

# ---------------------------------------------------------------------------
# status-hooks
# ---------------------------------------------------------------------------
#
# Read-only health check for overlay install status:
#   - Engine binary present + executable at $ENGINE_BINARY
#   - Hooks wired in ~/.claude/settings.json (UserPromptSubmit + PreToolUse/Agent)
#   - Contract readable with valid frontmatter
#   - (best-effort) Scoped block present in CWD's .atl/skill-registry.md
#
# Exits 0 if all checks pass, 1 otherwise.
# Read-only by design: no binary builds/writes.

cmd_status_hooks() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    # 'install-hooks' is no longer the narrowest remedy: doctor --fix rebuilds
    # the binary without also rewriting ~/.claude/settings.json. Hook wiring is
    # still named, because an engine that was never installed needs it too.
    die "engine binary not found at $ENGINE_BINARY; run 'overlay doctor --fix' to build it, or run 'overlay install-hooks' to build it and wire the hooks"
  fi

  # The engine binary's freshness belongs to THIS status command, not to
  # cmd_status: cmd_status reports per-target file/version sync of deployed
  # skills, while status-hooks is the read-only health check for the overlay's
  # own installation — the engine binary and its hooks. The TUI's "Estado" row
  # folds status-hooks in, so one line here surfaces there with no TUI change.
  # One line, because status is a summary; 'overlay doctor' is the report.
  if engine_binary_is_stale; then
    warn "$(engine_stale_diagnosis)"
  fi

  exec "$ENGINE_BINARY" status
}

# ---------------------------------------------------------------------------
# uninstall-hooks
# ---------------------------------------------------------------------------

cmd_uninstall_hooks() {
  local settings_path="$HOME/.claude/settings.json"

  if [[ ! -f "$ENGINE_BINARY" ]]; then
    # Binary absent: fall back to a fresh build to run uninstall.
    # If we cannot build, error out — we cannot safely remove entries.
    command -v go >/dev/null 2>&1 || die "engine binary not found at $ENGINE_BINARY and go is not installed; cannot uninstall"
    [[ -d "$ENGINE_SRC" ]] || die "engine source not found at $ENGINE_SRC; cannot build for uninstall"
    info "Engine binary not found; building to perform uninstall..."
    mkdir -p "$(dirname "$ENGINE_BINARY")"
    (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/) \
      || die "go build failed; cannot uninstall hooks"
  fi

  info "Removing hooks from: $settings_path"
  "$ENGINE_BINARY" uninstall-hooks \
    --settings "$settings_path" \
    --hook-command "$ENGINE_BINARY" \
    || die "uninstall-hooks failed"

  echo ""
  echo "uninstall-hooks complete."
  echo "  Our eight hook entries (four pairs: minimalism-contract + skill-discovery-safety"
  echo "  + anti-generic-design + review-projection-contract)"
  echo "  have been removed from $settings_path"
  echo "  (backup at ${settings_path}.bak if the file was modified)"
  echo ""
  echo "Run 'overlay doctor' to verify the installation state."
}

# ---------------------------------------------------------------------------
# install-alias
# ---------------------------------------------------------------------------

cmd_install_alias() {
  local name="${1:-labdrian}"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$OVERLAY_DIR/bin/labdrian-overlay" "$HOME/.local/bin/$name"
  echo "Linked '$name' -> overlay. Run '$name tui' (needs ~/.local/bin on PATH)."
}

# doctor_fix_engine_binary is doctor --fix's half of "update the engine on
# purpose". ensure_engine_binary heals silently on the way to running
# something; this is the DELIBERATE repair, and until it existed the only way
# to rebuild the engine was 'overlay install-hooks', which also rewrites
# ~/.claude/settings.json — a hammer for this tack, and so nobody ran it after
# a repository update.
#
# It never fails the run: doctor's engine-binary check is a WARN, and a repair
# that could not happen is REPORTED as not-happened rather than claimed. That
# is the whole point of the check — a repair reported but not performed is the
# same invisible failure mode in a new place.
# doctor_report_engine_binary prints the engine binary's state as one doctor
# line: absent / stale / current. Three states, because they need three
# different remedies -- "present" alone was the gap that let an eleven-day-old
# engine keep executing every hook unreported. Staleness is asked of
# engine_binary_is_stale so this file keeps exactly ONE staleness rule.
# Neither problem state is a hard FAIL: a stale engine usually still serves the
# command at hand, and an absent one is repairable from here.
#
# It is a function rather than an inline block so --fix can RE-RUN it after
# rebuilding, the way --fix already re-runs recheck_discovery_tools after
# provisioning. Without that, a --fix run left its own "is STALE" line standing
# as the report's only state for the binary, contradicted further down by
# "Engine binary rebuilt" -- a report that stops describing reality before it
# finishes.
doctor_report_engine_binary() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    echo "WARN  engine binary not found at $ENGINE_BINARY — nothing the overlay hands to the engine can run. Rebuild it with 'overlay doctor --fix' (or 'overlay install-hooks', which also rewires ~/.claude/settings.json)."
  elif engine_binary_is_stale; then
    echo "WARN  $(engine_stale_diagnosis)"
  else
    echo "PASS  engine binary present and current at $ENGINE_BINARY"
  fi
}

doctor_fix_engine_binary() {
  local reason
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    reason="absent"
  elif engine_binary_is_stale; then
    reason="stale"
  else
    echo "Engine binary already current at $ENGINE_BINARY — nothing to rebuild."
    return 0
  fi

  if ! command -v go >/dev/null 2>&1; then
    echo "COULD NOT REPAIR the $reason engine binary at $ENGINE_BINARY: go is not on PATH. Install a Go toolchain, then run 'overlay doctor --fix' again."
    return 0
  fi
  if [[ ! -d "$ENGINE_SRC" ]]; then
    echo "COULD NOT REPAIR the $reason engine binary at $ENGINE_BINARY: engine source not found at $ENGINE_SRC."
    return 0
  fi

  echo "Rebuilding the $reason engine binary from $ENGINE_SRC..."
  mkdir -p "$(dirname "$ENGINE_BINARY")"
  if (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/); then
    echo "Engine binary rebuilt: $ENGINE_BINARY"
  else
    echo "COULD NOT REPAIR the $reason engine binary at $ENGINE_BINARY: go build failed (see the build output above)."
  fi
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
#
# Read-only host-toolchain preflight. Prints PASS / WARN / FAIL per check and
# exits non-zero only on a hard FAIL (missing REQUIRED tool or empty registry).
#
# Honors the three robustness principles:
#   - PORTABLE DISCOVERY: every tool is probed with 'command -v'; the registry
#     check uses only POSIX 'test'. Never calls fd/eza/bat directly.
#   - FAIL-LOUD: no bare '2>/dev/null' on discovery; command-not-found stays
#     visible. A missing required tool or an empty registry is a hard FAIL with
#     an actionable message.
#   - REGISTRY-AUTHORITATIVE: the registry file is the source of truth. An empty
#     or whitespace-only registry is reported as FAIL ("inconclusive, not zero
#     skills"), never silently passed.
#
# Classification:
#   FAIL  -> registry empty/whitespace-only or unreadable; go absent
#   WARN  -> registry absent; gentle-ai absent; engine binary absent; fd/eza/bat absent
#   PASS  -> check satisfied

cmd_doctor() {
  local fail=0
  local fix=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix) fix=1 ;;
      *) die "Unknown option: $1. Usage: overlay doctor [--fix]" ;;
    esac
    shift || true
  done

  echo "overlay doctor — host-toolchain preflight"
  echo ""

  # (a) REQUIRED: go on PATH (needed to build the engine binary).
  if command -v go >/dev/null 2>&1; then
    echo "PASS  go on PATH"
  else
    echo "FAIL  go not found on PATH — required to build the engine binary (run 'overlay install-hooks')."
    fail=1
  fi

  # (b) REQUIRED-with-context: gentle-ai on PATH. The overlay layers onto
  #     gentle-ai; absence is a loud WARN, not a hard FAIL (overlay can still
  #     install and run, but propagation/scoping may be inert).
  if command -v gentle-ai >/dev/null 2>&1; then
    echo "PASS  gentle-ai on PATH"
  else
    echo "WARN  gentle-ai not found on PATH — the overlay layers onto gentle-ai; skill propagation/scoping may be inert until it is installed."
  fi

  # (c) bat / rg / fd / sd / eza — the full set the persona rule mandates.
  #     Absence is a WARN, never a hard FAIL: the safety guard is the fallback.
  #     Run 'overlay doctor --fix' to auto-install via Homebrew when available.
  local missing_discovery=()
  local t
  for t in "${DISCOVERY_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || missing_discovery+=("$t")
  done
  if [[ ${#missing_discovery[@]} -eq 0 ]]; then
    echo "PASS  bat/rg/fd/sd/eza on PATH"
  else
    echo "WARN  not found: ${missing_discovery[*]}. Without these tools agents that run"
    echo "      e.g. 'fd ... 2>/dev/null' get empty output (command not found, swallowed)"
    echo "      and may misread it as zero skills — the silent-empty footgun."
    echo "      Run 'overlay doctor --fix' to auto-install via Homebrew (if available)."
    echo "      Skill discovery MUST use the registry (.atl/skill-registry.md or engram),"
    echo "      never a bare filesystem scan. An empty result is INCONCLUSIVE, not zero skills."
  fi

  # (d) Engine binary: absent / stale / current. Three states, because they
  #     need three different remedies — "present" alone was the gap that let an
  #     eleven-day-old engine keep executing every hook unreported. Staleness is
  #     asked of engine_binary_is_stale so this file keeps exactly ONE staleness
  #     rule. Neither state is a hard FAIL: a stale engine usually still serves
  #     the command at hand, and an absent one is repairable from here.
  doctor_report_engine_binary

  # (e) REGISTRY-AUTHORITATIVE + FAIL-LOUD: registry present AND non-empty.
  #     Resolve under OVERLAY_DIR first, then CWD. A missing or empty/
  #     whitespace-only registry is a hard FAIL.
  local registry=""
  if [[ -f "$OVERLAY_DIR/.atl/skill-registry.md" ]]; then
    registry="$OVERLAY_DIR/.atl/skill-registry.md"
  elif [[ -f "$PWD/.atl/skill-registry.md" ]]; then
    registry="$PWD/.atl/skill-registry.md"
  fi

  if [[ -z "$registry" ]]; then
    echo "WARN  skill-registry.md not found under $OVERLAY_DIR/.atl or $PWD/.atl — project may not use the overlay. Run skill-registry to generate it; do NOT conclude skills are absent."
  elif [[ ! -s "$registry" ]]; then
    echo "FAIL  registry empty (zero bytes): $registry — run skill-registry; do NOT conclude skills are absent."
    fail=1
  else
    # Reject a whitespace-only file too. Capture content to a var (no pipe)
    # to avoid SIGPIPE under 'set -euo pipefail'.
    local registry_content
    registry_content="$(tr -d '[:space:]' < "$registry")"
    if [[ -z "$registry_content" ]]; then
      echo "FAIL  registry whitespace-only: $registry — run skill-registry; an empty scan is INCONCLUSIVE, not zero skills."
      fail=1
    else
      echo "PASS  registry present and non-empty: $registry"
    fi
  fi

  # (f) overlay-release-surfacing R-001: per-target deployed-version digest
  # consistency. A target with no recorded state (never deployed) has
  # nothing to compare yet -- silently skipped, not reported as a failure
  # or warning. A digest mismatch is a WARN, never a FAIL: it never touches
  # `fail`, preserving doctor's "exits non-zero only on a hard FAIL"
  # contract (R-001's explicit requirement).
  local dt drecorded drecorded_version drecorded_digest dtarget_digest
  for dt in "${!TARGET_PATHS[@]}"; do
    drecorded="$(state_read_target "$dt")"
    [[ "$drecorded" == "NEVER_DEPLOYED" ]] && continue
    IFS=$'\t' read -r drecorded_version drecorded_digest _ <<< "$drecorded"
    dtarget_digest="$(compute_target_digest "$dt" live)"
    if [[ "$dtarget_digest" == "$drecorded_digest" ]]; then
      echo "PASS  $dt: deployed at $drecorded_version, digest matches"
    else
      echo "WARN  $dt: deployed at $drecorded_version, digest drift detected -- run 'overlay apply --target $dt'"
    fi
  done

  echo ""
  if [[ "$fail" -ne 0 ]]; then
    echo "doctor: FAIL — one or more required checks did not pass (see above)." >&2
    # Still run --fix provisioning if requested, then re-check tools, but exit 1 after.
    if [[ "$fix" -eq 1 ]]; then
      echo ""
      echo "==> --fix: engine binary..."
      doctor_fix_engine_binary
      echo ""
      echo "==> Re-checking the engine binary after --fix..."
      doctor_report_engine_binary
      echo ""
      echo "==> --fix: attempting to provision discovery tools despite FAIL above..."
      ensure_discovery_tools
      echo ""
      echo "==> Re-checking discovery tools after provisioning..."
      recheck_discovery_tools
    fi
    exit 1
  fi
  echo "doctor: OK — required checks passed (review any WARN above)."

  # --fix: explicit opt-in to provision missing discovery tools, then re-check.
  if [[ "$fix" -eq 1 ]]; then
    echo ""
    echo "==> --fix: engine binary..."
    doctor_fix_engine_binary
    echo ""
    echo "==> Re-checking the engine binary after --fix..."
    doctor_report_engine_binary
    echo ""
    echo "==> --fix: provisioning discovery tools (${DISCOVERY_TOOLS[*]})..."
    ensure_discovery_tools
    echo ""
    echo "==> Re-checking discovery tools after provisioning..."
    recheck_discovery_tools
  fi
}

# ---------------------------------------------------------------------------
# repair-sdd-registry
# ---------------------------------------------------------------------------
#
# Gentle's default skill-registry intentionally skips sdd-* phase skills because
# they are executor contracts, not normal user-invocable skills. Codex/Gentle SDD
# delegation still needs their exact paths. This command makes the registry
# durable after `gentle-ai sync` / `gentle-ai skill-registry refresh` by
# refreshing first, then re-inserting installed sdd-* rows with Scope=executor.

cmd_repair_sdd_registry() {
  local cwd="$CALLER_CWD"
  local target="codex"
  local refresh=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        shift
        cwd="${1:-}"
        [[ -n "$cwd" ]] || die "--cwd requires an argument"
        ;;
      --target)
        shift
        target="${1:-}"
        [[ -n "$target" ]] || die "--target requires an argument"
        [[ -v TARGET_PATHS["$target"] ]] || die "Unknown target: $target. Valid: claude, opencode, codex"
        ;;
      --no-refresh)
        refresh=0
        ;;
      *) die "Unknown option: $1. Usage: overlay repair-sdd-registry [--cwd DIR] [--target claude|opencode|codex] [--no-refresh]" ;;
    esac
    shift || true
  done

  [[ -d "$cwd" ]] || die "--cwd is not a directory: $cwd"

  if [[ "$refresh" -eq 1 ]]; then
    command -v gentle-ai >/dev/null 2>&1 || die "gentle-ai not found on PATH; use --no-refresh to repair an existing registry only"
    gentle-ai skill-registry refresh --cwd "$cwd" --force --quiet --no-gitignore
  fi

  repair_sdd_registry_file "$cwd/.atl/skill-registry.md" "$target"
}

# ---------------------------------------------------------------------------
# skill-registry refresh
# ---------------------------------------------------------------------------
#
# Wrapper around `gentle-ai skill-registry refresh` that applies the overlay's
# SDD executor repair immediately after the generated registry is refreshed.
# This prevents the known Gentle default skip of sdd-* phase skills from
# reappearing every time users refresh the registry through the overlay.

cmd_skill_registry() {
  local verb="${1:-}"
  [[ "$verb" == "refresh" ]] || die "Usage: overlay skill-registry refresh [--cwd DIR] [--target claude|opencode|codex] [--no-repair] [--force] [--quiet] [--no-gitignore]"
  shift || true

  local cwd="$CALLER_CWD"
  local target="codex"
  local repair=1
  local saw_no_gitignore=0
  local -a gentle_args=("skill-registry" "refresh")

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        shift
        cwd="${1:-}"
        [[ -n "$cwd" ]] || die "--cwd requires an argument"
        gentle_args+=("--cwd" "$cwd")
        ;;
      --target)
        shift
        target="${1:-}"
        [[ -n "$target" ]] || die "--target requires an argument"
        [[ -v TARGET_PATHS["$target"] ]] || die "Unknown target: $target. Valid: claude, opencode, codex"
        ;;
      --no-repair)
        repair=0
        ;;
      --no-gitignore)
        saw_no_gitignore=1
        gentle_args+=("$1")
        ;;
      --force|--quiet)
        gentle_args+=("$1")
        ;;
      *) die "Unknown option: $1. Usage: overlay skill-registry refresh [--cwd DIR] [--target claude|opencode|codex] [--no-repair] [--force] [--quiet] [--no-gitignore]" ;;
    esac
    shift || true
  done

  [[ -d "$cwd" ]] || die "--cwd is not a directory: $cwd"
  [[ "$saw_no_gitignore" -eq 1 ]] || gentle_args+=("--no-gitignore")

  command -v gentle-ai >/dev/null 2>&1 || die "gentle-ai not found on PATH"
  gentle-ai "${gentle_args[@]}"

  if [[ "$repair" -eq 1 ]]; then
    repair_sdd_registry_file "$cwd/.atl/skill-registry.md" "$target"
  fi
}

# cmd_prespec forwards to the engine binary's `prespec` subcommand, passing
# stdin/stdout/args straight through. This is the user-facing entry point the
# prespec-malandra skill calls (e.g. `labdrian prespec lint`).
cmd_prespec() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    die "engine binary not found at $ENGINE_BINARY; run 'overlay install-hooks' first"
  fi
  exec "$ENGINE_BINARY" prespec "$@"
}

# cmd_skills forwards to the engine binary's `skills` subcommand.
# Injects default --registry and --manifest paths from $OVERLAY_DIR so that
# `labdrian skills list` / `labdrian skills validate` work from any cwd.
# Flags already supplied by the caller are never overridden.
cmd_skills() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    die "engine binary not found at $ENGINE_BINARY; run 'overlay install-hooks' first"
  fi

  local has_registry=0 has_manifest=0 has_source_root=0
  for arg in "$@"; do
    [[ "$arg" == "--registry" ]] && has_registry=1
    [[ "$arg" == "--manifest" ]] && has_manifest=1
    [[ "$arg" == "--source-root" ]] && has_source_root=1
  done

  local -a defaults=()
  [[ "$has_registry" -eq 0 ]] && defaults+=("--registry" "$OVERLAY_DIR/skills.registry.yaml")
  [[ "$has_manifest" -eq 0 ]] && defaults+=("--manifest" "$OVERLAY_DIR/overlay.manifest")
  [[ "$has_source_root" -eq 0 ]] && defaults+=("--source-root" "$OVERLAY_DIR/skills")

  # Verb-first: "$@" carries the verb (and any user flags); injected defaults go
  # AFTER it so the engine's positional verb extraction is not shadowed by a flag value.
  exec "$ENGINE_BINARY" skills "$@" "${defaults[@]}"
}

# ---------------------------------------------------------------------------
# validate-entry-contract
# ---------------------------------------------------------------------------

cmd_validate_entry_contract() {
  local validator_src="$OVERLAY_DIR/tools/entry-contract-validator"
  if [[ ! -f "$validator_src/go.mod" || ! -f "$validator_src/main.go" ]]; then
    echo "error: entry-contract validator source is unavailable under $validator_src" >&2
    return 3
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is required to build the entry-contract validator" >&2
    return 3
  fi

  local -a normalized_args=()
  local flag value
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --schema|--instance)
        flag="$1"
        shift
        if [[ $# -eq 0 ]]; then
          normalized_args+=("$flag")
          break
        fi
        value="$1"
        [[ "$value" == /* ]] || value="$CALLER_CWD/$value"
        normalized_args+=("$flag" "$value")
        ;;
      --schema=*|--instance=*)
        flag="${1%%=*}"
        value="${1#*=}"
        [[ "$value" == /* ]] || value="$CALLER_CWD/$value"
        normalized_args+=("$flag=$value")
        ;;
      *)
        normalized_args+=("$1")
        ;;
    esac
    shift
  done

  local validator_binary
  if ! validator_binary="$(mktemp "${TMPDIR:-/tmp}/entry-contract-validator.XXXXXX")"; then
    echo "error: could not allocate a temporary entry-contract validator binary" >&2
    return 3
  fi
  rm -f "$validator_binary"

  if ! (cd "$validator_src" && go build -o "$validator_binary" .); then
    rm -f "$validator_binary"
    echo "error: could not build the entry-contract validator" >&2
    return 3
  fi

  local status=0
  "$validator_binary" "${normalized_args[@]}" || status=$?
  rm -f "$validator_binary"
  return "$status"
}

# ---------------------------------------------------------------------------
# deterministic-checks
# ---------------------------------------------------------------------------

cmd_deterministic_checks() {
  local runner_src="$OVERLAY_DIR/tools/deterministic-check-runner"
  if [[ ! -f "$runner_src/go.mod" || ! -f "$runner_src/main.go" ]]; then
    echo "error: deterministic-check-runner source is unavailable under $runner_src" >&2
    return 3
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is required to build the deterministic-check-runner" >&2
    return 3
  fi

  local runner_binary
  if ! runner_binary="$(mktemp "${TMPDIR:-/tmp}/deterministic-check-runner.XXXXXX")"; then
    echo "error: could not allocate a temporary deterministic-check-runner binary" >&2
    return 3
  fi
  rm -f "$runner_binary"

  if ! (cd "$runner_src" && go build -o "$runner_binary" .); then
    rm -f "$runner_binary"
    echo "error: could not build the deterministic-check-runner" >&2
    return 3
  fi

  local status=0
  (cd "$CALLER_CWD" && "$runner_binary" "$@") || status=$?
  if [[ "$status" -ne 0 && ! -d "$CALLER_CWD" ]]; then
    status=3
  fi
  rm -f "$runner_binary"
  return "$status"
}

# ---------------------------------------------------------------------------
# review-preflight
# ---------------------------------------------------------------------------

# Same shape as cmd_deterministic_checks above, deliberately: every failure to
# reach the guard is exit 3 ("could not determine"), never exit 0, so a missing
# source tree or a missing toolchain can never be read as "a review here is
# safe". The guard's own exit code is propagated verbatim - the wrapper never
# re-derives it, exactly as skills/sdd-verify/SKILL.md requires of the sibling
# runner.
cmd_review_preflight() {
  local guard_src="$OVERLAY_DIR/tools/review-preflight"
  if [[ ! -f "$guard_src/go.mod" || ! -f "$guard_src/main.go" ]]; then
    echo "error: review-preflight source is unavailable under $guard_src" >&2
    return 3
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is required to build the review-preflight guard" >&2
    return 3
  fi

  local guard_binary
  if ! guard_binary="$(mktemp "${TMPDIR:-/tmp}/review-preflight.XXXXXX")"; then
    echo "error: could not allocate a temporary review-preflight binary" >&2
    return 3
  fi
  rm -f "$guard_binary"

  if ! (cd "$guard_src" && go build -o "$guard_binary" .); then
    rm -f "$guard_binary"
    echo "error: could not build the review-preflight guard" >&2
    return 3
  fi

  local status=0
  (cd "$CALLER_CWD" && "$guard_binary" "$@") || status=$?
  # A CALLER_CWD that no longer exists makes the subshell's own `cd` fail with
  # exit 1, which for this guard would read as "EMPTY candidate" - a verdict
  # about a projection that was never observed. Remap that one case to 3.
  if [[ "$status" -ne 0 && ! -d "$CALLER_CWD" ]]; then
    status=3
  fi
  rm -f "$guard_binary"
  return "$status"
}

# ---------------------------------------------------------------------------
# archive-reconcile
# ---------------------------------------------------------------------------

# Same shape as cmd_review_preflight above, deliberately: every failure to
# reach the guard is exit 3 ("could not determine"), never exit 0, so a missing
# source tree or a missing toolchain can never be read as "no stranded change
# exists here". The guard's own exit code is propagated verbatim - the wrapper
# never re-derives it.
cmd_archive_reconcile() {
  local guard_src="$OVERLAY_DIR/tools/archive-reconcile"
  if [[ ! -f "$guard_src/go.mod" || ! -f "$guard_src/main.go" ]]; then
    echo "error: archive-reconcile source is unavailable under $guard_src" >&2
    return 3
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is required to build the archive-reconcile guard" >&2
    return 3
  fi

  local guard_binary
  if ! guard_binary="$(mktemp "${TMPDIR:-/tmp}/archive-reconcile.XXXXXX")"; then
    echo "error: could not allocate a temporary archive-reconcile binary" >&2
    return 3
  fi
  rm -f "$guard_binary"

  if ! (cd "$guard_src" && go build -o "$guard_binary" .); then
    rm -f "$guard_binary"
    echo "error: could not build the archive-reconcile guard" >&2
    return 3
  fi

  local status=0
  (cd "$CALLER_CWD" && "$guard_binary" "$@") || status=$?
  # A CALLER_CWD that no longer exists makes the subshell's own `cd` fail with
  # exit 1, which for this guard would read as "STRANDED change found" - a
  # verdict about a scan that was never performed. Remap that one case to 3.
  if [[ "$status" -ne 0 && ! -d "$CALLER_CWD" ]]; then
    status=3
  fi
  rm -f "$guard_binary"
  return "$status"
}

# ---------------------------------------------------------------------------
