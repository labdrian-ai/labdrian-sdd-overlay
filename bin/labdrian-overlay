#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of this script, following symlinks.
# Uses a pure-bash loop instead of readlink -f so it works on macOS/BSD too.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
# shellcheck disable=SC2034  # read by the modules
CALLER_CWD="$PWD"
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Allow OVERLAY_DIR to be overridden via environment variable (useful for tests
# and power-user workflows; normal use leaves it unset so it auto-detects here).
OVERLAY_DIR="${OVERLAY_DIR:-"$(cd "$SCRIPT_DIR/.." && pwd)"}"

# The program is this file and the modules in lib/ beside it, sourced in the order listed here. At
# load time a module may use only what an earlier one assigned; at run time any function of any
# module is available. lib/ is found from the REAL location of this file (SCRIPT_DIR: symlinks
# resolved above), never from OVERLAY_DIR, which a caller may point at another checkout.
OVERLAY_LIB_DIR="$SCRIPT_DIR/lib"
_modules=(
  common
  locations
  targets
  engine_binary
  manifest_routes
  deploy_state
  release
  backups
  pi_package
  discovery_tools
  usage
  longterm_mem
  skill_registry
  engine_verbs
  tool_runners
  bootstrap
  capture
  apply
  self_update
  release_report
  restore
  status
  sync_check
)
for _module in "${_modules[@]}"; do
  if [[ ! -f "$OVERLAY_LIB_DIR/$_module.sh" ]]; then
    echo "ERROR: labdrian-overlay is incomplete: the module '$_module' is missing (expected at $OVERLAY_LIB_DIR/$_module.sh)." >&2
    echo "       The program is this file plus every module in lib/ beside it; restore them (git checkout -- bin/lib in the clone it came from)." >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$OVERLAY_LIB_DIR/$_module.sh"
done
unset _modules _module

# ---------------------------------------------------------------------------
# tui
# ---------------------------------------------------------------------------

cmd_tui() {
  command -v go >/dev/null 2>&1 || die "go is not installed; required to run the TUI"
  [[ -d "$OVERLAY_DIR/tui" ]] || die "tui/ not found at $OVERLAY_DIR/tui"
  # First-run convenience: a fresh clone only checks out `main`, but sync-check and
  # the dashboard need a local `upstream` ref. Materialize it from origin/upstream if
  # missing, so the user can go straight from `install-alias` to `tui` and do
  # everything else (capture / apply / install-hooks) from inside the dashboard.
  if ! git -C "$OVERLAY_DIR" show-ref --verify --quiet refs/heads/upstream \
     && git -C "$OVERLAY_DIR" show-ref --verify --quiet refs/remotes/origin/upstream; then
    git -C "$OVERLAY_DIR" branch --force upstream origin/upstream >/dev/null 2>&1 \
      && info "Materialized local 'upstream' branch from origin/upstream."
  fi
  # Export repo root so the Go program can locate bin/labdrian-overlay reliably.
  export OVERLAY_DIR
  # Run from inside the module dir (repo root is not a Go module).
  cd "$OVERLAY_DIR/tui"
  exec go run .
}

# ---------------------------------------------------------------------------
# install-hooks
# ---------------------------------------------------------------------------
#
# Design decisions:
#   1. SEPARATE from 'labdrian apply'. Skills deployment and hook wiring are
#      distinct operations — apply only copies files, never mutates
#      ~/.claude/settings.json. This keeps apply non-invasive.
#   2. DELIBERATE activation. The user must run 'labdrian install-hooks'
#      intentionally. This satisfies the "INERT until user activates" contract.
#   3. MISSING-BINARY SAFETY. Hook commands emitted by the engine use the form:
#        command -v <binary> &>/dev/null && <binary> ... || true
#      This ensures any hook exits 0 even when the binary is absent, so no
#      Claude Code Task is ever blocked by a missing binary.
#   4. ATOMIC+BACKUP inside the engine. The engine's merge-settings subcommand
#      writes to a temp file and renames; it also copies the original to
#      settings.json.bak before overwriting.

cmd_install_hooks() {
  command -v go >/dev/null 2>&1 || die "go is not installed; required to build the engine"
  command -v gentle-ai >/dev/null 2>&1 || warn "gentle-ai not found on PATH — the overlay layers onto gentle-ai; hooks will install but skill propagation/scoping may be inert until gentle-ai is installed. Run 'labdrian doctor' for a full preflight."
  [[ -d "$ENGINE_SRC" ]] || die "engine source not found at $ENGINE_SRC"

  info "Building engine binary..."
  mkdir -p "$(dirname "$ENGINE_BINARY")"
  (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/) \
    || die "go build failed; binary not deployed"
  info "Engine binary deployed to: $ENGINE_BINARY"

  local settings_path="$HOME/.claude/settings.json"
  info "Merging hooks into: $settings_path"
  "$ENGINE_BINARY" merge-settings \
    --settings "$settings_path" \
    --hook-command "$ENGINE_BINARY" \
    || die "merge-settings failed"

  echo ""
  echo "install-hooks complete."
  echo "  binary  : $ENGINE_BINARY"
  echo "  settings: $settings_path (backup at ${settings_path}.bak)"
  echo "  hooks   : the overlay hook families, wired into UserPromptSubmit, PreToolUse, and SessionEnd:"
  echo "            deterministic scoping (minimalism-contract and anti-generic-design),"
  echo "            the SessionEnd longterm-mem sync, the review-receipt and shaper clearance guards,"
  echo "            the workflow projection hooks, and the skills approve guard"
  echo "            (denies the agent running 'skills approve'; a speed bump, not a security boundary)."
  echo ""
  echo "Deterministic scoping is now ACTIVE for Claude Code sessions once you restart Claude Code,"
  echo "which loads hooks only when it starts (re-run install-hooks after an upgrade that adds a family)."
  echo ""
  echo "Run 'labdrian doctor' to verify the full installation."

  # Best-effort: provision discovery tools so agents don't hit the silent-empty
  # footgun on a fresh install. Non-fatal — a failure here must never abort
  # install-hooks.
  # Set OVERLAY_SKIP_TOOL_INSTALL=1 to opt out (e.g. in CI or managed hosts).
  if [[ -n "${OVERLAY_SKIP_TOOL_INSTALL:-}" ]]; then
    info "OVERLAY_SKIP_TOOL_INSTALL is set — skipping automatic discovery-tool installation."
    warn "Discovery tools (bat rg fd sd eza) were NOT auto-installed."
    warn "Run 'labdrian doctor --fix' later to provision them when ready."
  else
    echo ""
    echo "==> Installing host packages via Homebrew: discovery tools (bat rg fd sd eza)."
    echo "    Set OVERLAY_SKIP_TOOL_INSTALL=1 to skip this step."
    ensure_discovery_tools
  fi
}

# ---------------------------------------------------------------------------
# status-hooks
# ---------------------------------------------------------------------------
#
# Read-only health check for overlay install status:
#   - Engine binary present + executable at $ENGINE_BINARY
#   - Hooks wired in ~/.claude/settings.json (UserPromptSubmit + PreToolUse/Agent)
#   - Contract readable with valid frontmatter
#   - (best-effort) Scoped block present in CWD's .atl/skill-registry.md
#
# Exits 0 if all checks pass, 1 otherwise.
# Read-only by design: no binary builds/writes.

cmd_status_hooks() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    # 'install-hooks' is no longer the narrowest remedy: doctor --fix rebuilds
    # the binary without also rewriting ~/.claude/settings.json. Hook wiring is
    # still named, because an engine that was never installed needs it too.
    die "engine binary not found at $ENGINE_BINARY; run 'labdrian doctor --fix' to build it, or run 'labdrian install-hooks' to build it and wire the hooks"
  fi

  # The engine binary's freshness belongs to THIS status command, not to
  # cmd_status: cmd_status reports per-target file/version sync of deployed
  # skills, while status-hooks is the read-only health check for the overlay's
  # own installation — the engine binary and its hooks. The TUI's "Estado" row
  # folds status-hooks in, so one line here surfaces there with no TUI change.
  # One line, because status is a summary; 'labdrian doctor' is the report.
  if engine_binary_is_stale; then
    warn "$(engine_stale_diagnosis)"
  fi

  exec "$ENGINE_BINARY" status
}

# ---------------------------------------------------------------------------
# uninstall-hooks
# ---------------------------------------------------------------------------

cmd_uninstall_hooks() {
  local settings_path="$HOME/.claude/settings.json"

  if [[ ! -f "$ENGINE_BINARY" ]]; then
    # Binary absent: fall back to a fresh build to run uninstall.
    # If we cannot build, error out — we cannot safely remove entries.
    command -v go >/dev/null 2>&1 || die "engine binary not found at $ENGINE_BINARY and go is not installed; cannot uninstall"
    [[ -d "$ENGINE_SRC" ]] || die "engine source not found at $ENGINE_SRC; cannot build for uninstall"
    info "Engine binary not found; building to perform uninstall..."
    mkdir -p "$(dirname "$ENGINE_BINARY")"
    (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/) \
      || die "go build failed; cannot uninstall hooks"
  fi

  info "Removing hooks from: $settings_path"
  "$ENGINE_BINARY" uninstall-hooks \
    --settings "$settings_path" \
    --hook-command "$ENGINE_BINARY" \
    || die "uninstall-hooks failed"

  echo ""
  echo "uninstall-hooks complete."
  echo "  Every overlay hook entry (scoping, the SessionEnd sync, the review-receipt and shaper guards,"
  echo "  the workflow projection hooks, and the skills approve guard) has been removed from $settings_path"
  echo "  (backup at ${settings_path}.bak if the file was modified)"
  echo ""
  echo "Run 'labdrian doctor' to verify the installation state."
}

# ---------------------------------------------------------------------------
# install-alias
# ---------------------------------------------------------------------------

cmd_install_alias() {
  local name="${1:-labdrian}"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$OVERLAY_DIR/bin/labdrian-overlay" "$HOME/.local/bin/$name"
  echo "Linked '$name' -> overlay. Run '$name tui' (needs ~/.local/bin on PATH)."
}

# doctor_fix_engine_binary is doctor --fix's half of "update the engine on
# purpose". ensure_engine_binary heals silently on the way to running
# something; this is the DELIBERATE repair, and until it existed the only way
# to rebuild the engine was 'labdrian install-hooks', which also rewrites
# ~/.claude/settings.json — a hammer for this tack, and so nobody ran it after
# a repository update.
#
# It never fails the run: doctor's engine-binary check is a WARN, and a repair
# that could not happen is REPORTED as not-happened rather than claimed. That
# is the whole point of the check — a repair reported but not performed is the
# same invisible failure mode in a new place.
# doctor_report_engine_binary prints the engine binary's state as one doctor
# line: absent / stale / current. Three states, because they need three
# different remedies -- "present" alone was the gap that let an eleven-day-old
# engine keep executing every hook unreported. Staleness is asked of
# engine_binary_is_stale so this file keeps exactly ONE staleness rule.
# Neither problem state is a hard FAIL: a stale engine usually still serves the
# command at hand, and an absent one is repairable from here.
#
# It is a function rather than an inline block so --fix can RE-RUN it after
# rebuilding, the way --fix already re-runs recheck_discovery_tools after
# provisioning. Without that, a --fix run left its own "is STALE" line standing
# as the report's only state for the binary, contradicted further down by
# "Engine binary rebuilt" -- a report that stops describing reality before it
# finishes.
doctor_report_engine_binary() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    echo "WARN  engine binary not found at $ENGINE_BINARY — nothing the overlay hands to the engine can run. Rebuild it with 'labdrian doctor --fix' (or 'labdrian install-hooks', which also rewires ~/.claude/settings.json)."
  elif engine_binary_is_stale; then
    echo "WARN  $(engine_stale_diagnosis)"
  else
    echo "PASS  engine binary present and current at $ENGINE_BINARY"
  fi
}

# doctor_report_registry prints, as one doctor line, what the engine says of the
# skill registry of the project doctor looks at. The judgment is the engine's
# (`status --only registry`, the same check `status-hooks` makes), so the
# overlay has one rule for what a registry may be: absent is quiet (a project
# that does not use the overlay is no problem), empty, white space only or
# unreadable is a FAIL (never taken for "zero skills"), and one that lacks a
# scoped block warns. This function only chooses the project -- the overlay
# repository's registry when it has one, else the directory doctor runs in --
# and puts the engine's level on the line: ok is PASS, a warning is WARN, a
# failure is FAIL and the function returns 1, for the caller to fail the run.
#
# Doctor must still say something when the engine cannot answer, because
# diagnosing a missing engine is part of its job: an absent binary, or one so
# old that it does not know the question, is a WARN that says the registry was
# not checked, never a silent pass. An engine that ran and ended with a code it
# does not give for a report is a fault, and is a FAIL that fails doctor.
doctor_report_registry() {
  local dir="$PWD"
  [[ -f "$OVERLAY_DIR/.atl/skill-registry.md" ]] && dir="$OVERLAY_DIR"

  if [[ ! -x "$ENGINE_BINARY" ]]; then
    echo "WARN  registry not checked: the engine judges it and its binary is not at $ENGINE_BINARY. Rebuild it with 'labdrian doctor --fix'."
    return 0
  fi

  local report rc=0
  report="$("$ENGINE_BINARY" status --only registry --cwd "$dir" 2>&1)" || rc=$?
  # The engine's codes for a report are 0 (ok), 2 (a warning and no failure) and 1
  # (a failure); a usage error is 1 too, but it has no line of the shape below. An
  # engine that ran and ended with any other code (a crash, a kill, a program that
  # could not be run, a code of its own) is not an engine that left the registry
  # unchecked for want of one, it is an engine that failed: FAIL, and doctor fails
  # with it. A line printed before such a code may be half an answer, so it is not
  # shown.
  case "$rc" in
    0 | 1 | 2) ;;
    *)
      echo "FAIL  registry not checked: the engine at $ENGINE_BINARY ended with code $rc on 'status --only registry'; only 0 (ok), 2 (a warning) and 1 (a failure) are answers. Rebuild it with 'labdrian doctor --fix'."
      return 1
      ;;
  esac
  # One line, "[LEVEL] registry: ...": an engine older than this script ignores
  # --only and prints its whole report, and then none of it is an answer.
  if [[ "$report" != "["*"] registry: "* || "$report" == *$'\n'* ]]; then
    echo "WARN  registry not checked: the engine at $ENGINE_BINARY did not answer 'status --only registry' (is it older than this overlay?). Rebuild it with 'labdrian doctor --fix'."
    return 0
  fi
  local line="${report#*] }"
  case "$rc" in
    0) echo "PASS  $line" ;;
    2) echo "WARN  $line" ;;
    1) echo "FAIL  $line"; return 1 ;;
  esac
}

doctor_fix_engine_binary() {
  local reason
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    reason="absent"
  elif engine_binary_is_stale; then
    reason="stale"
  else
    echo "Engine binary already current at $ENGINE_BINARY — nothing to rebuild."
    return 0
  fi

  if ! command -v go >/dev/null 2>&1; then
    echo "COULD NOT REPAIR the $reason engine binary at $ENGINE_BINARY: go is not on PATH. Install a Go toolchain, then run 'labdrian doctor --fix' again."
    return 0
  fi
  if [[ ! -d "$ENGINE_SRC" ]]; then
    echo "COULD NOT REPAIR the $reason engine binary at $ENGINE_BINARY: engine source not found at $ENGINE_SRC."
    return 0
  fi

  echo "Rebuilding the $reason engine binary from $ENGINE_SRC..."
  mkdir -p "$(dirname "$ENGINE_BINARY")"
  if (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/); then
    echo "Engine binary rebuilt: $ENGINE_BINARY"
  else
    echo "COULD NOT REPAIR the $reason engine binary at $ENGINE_BINARY: go build failed (see the build output above)."
  fi
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
#
# Read-only host-toolchain preflight. Prints PASS / WARN / FAIL per check and
# exits non-zero only on a hard FAIL (missing REQUIRED tool or empty registry).
#
# Honors the three robustness principles:
#   - PORTABLE DISCOVERY: every tool is probed with 'command -v'. Never calls
#     fd/eza/bat directly.
#   - FAIL-LOUD: no bare '2>/dev/null' on discovery; command-not-found stays
#     visible. A missing required tool or an empty registry is a hard FAIL with
#     an actionable message.
#   - REGISTRY-AUTHORITATIVE: the registry file is the source of truth, and the
#     engine judges it (doctor_report_registry): an empty or whitespace-only
#     registry is reported as FAIL ("inconclusive, not zero skills"), never
#     silently passed.
#
# Classification:
#   FAIL  -> registry empty/whitespace-only or unreadable; go absent; an engine that
#            ran and ended with a code it does not give for a report
#   WARN  -> registry without a scoped block, or not checked (no engine to ask);
#            gentle-ai absent; engine binary absent; fd/eza/bat absent
#   (a registry that is absent is PASS: a project that does not use the overlay is no problem)
#   PASS  -> check satisfied

cmd_doctor() {
  local fail=0
  local fix=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix) fix=1 ;;
      *) die "Unknown option: $1. Usage: labdrian doctor [--fix]" ;;
    esac
    shift || true
  done

  echo "labdrian doctor — host-toolchain preflight"
  echo ""

  # (a) REQUIRED: go on PATH (needed to build the engine binary).
  if command -v go >/dev/null 2>&1; then
    echo "PASS  go on PATH"
  else
    echo "FAIL  go not found on PATH — required to build the engine binary (run 'labdrian install-hooks')."
    fail=1
  fi

  # (b) REQUIRED-with-context: gentle-ai on PATH. The overlay layers onto
  #     gentle-ai; absence is a loud WARN, not a hard FAIL (overlay can still
  #     install and run, but propagation/scoping may be inert).
  if command -v gentle-ai >/dev/null 2>&1; then
    echo "PASS  gentle-ai on PATH"
  else
    echo "WARN  gentle-ai not found on PATH — the overlay layers onto gentle-ai; skill propagation/scoping may be inert until it is installed."
  fi

  # (c) bat / rg / fd / sd / eza — the full set the persona rule mandates.
  #     Absence is a WARN, never a hard FAIL: the safety guard is the fallback.
  #     Run 'labdrian doctor --fix' to auto-install via Homebrew when available.
  local missing_discovery=()
  local t
  for t in "${DISCOVERY_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || missing_discovery+=("$t")
  done
  if [[ ${#missing_discovery[@]} -eq 0 ]]; then
    echo "PASS  bat/rg/fd/sd/eza on PATH"
  else
    echo "WARN  not found: ${missing_discovery[*]}. Without these tools agents that run"
    echo "      e.g. 'fd ... 2>/dev/null' get empty output (command not found, swallowed)"
    echo "      and may misread it as zero skills — the silent-empty footgun."
    echo "      Run 'labdrian doctor --fix' to auto-install via Homebrew (if available)."
    echo "      Skill discovery MUST use the registry (.atl/skill-registry.md or engram),"
    echo "      never a bare filesystem scan. An empty result is INCONCLUSIVE, not zero skills."
  fi

  # (d) Engine binary: absent / stale / current. Three states, because they
  #     need three different remedies — "present" alone was the gap that let an
  #     eleven-day-old engine keep executing every hook unreported. Staleness is
  #     asked of engine_binary_is_stale so this file keeps exactly ONE staleness
  #     rule. Neither state is a hard FAIL: a stale engine usually still serves
  #     the command at hand, and an absent one is repairable from here.
  doctor_report_engine_binary

  # (e) REGISTRY-AUTHORITATIVE + FAIL-LOUD: the skill registry of the project,
  #     judged by the engine (doctor_report_registry), not by a second rule of
  #     this script. An empty, white-space-only or unreadable registry is a hard
  #     FAIL; one that lacks a scoped block is a WARN.
  doctor_report_registry || fail=1

  # (f) overlay-release-surfacing R-001: per-target deployed-version digest
  # consistency. A target with no recorded state (never deployed) has
  # nothing to compare yet -- silently skipped, not reported as a failure
  # or warning. A digest mismatch is a WARN, never a FAIL: it never touches
  # `fail`, preserving doctor's "exits non-zero only on a hard FAIL"
  # contract (R-001's explicit requirement).
  local dt drecorded drecorded_version drecorded_digest dtarget_digest
  for dt in "${!TARGET_PATHS[@]}"; do
    drecorded="$(state_read_target "$dt")"
    [[ "$drecorded" == "NEVER_DEPLOYED" ]] && continue
    IFS=$'\t' read -r drecorded_version drecorded_digest _ <<< "$drecorded"
    dtarget_digest="$(compute_target_digest "$dt" live)"
    if [[ "$dtarget_digest" == "$drecorded_digest" ]]; then
      echo "PASS  $dt: deployed at $drecorded_version, digest matches"
    else
      echo "WARN  $dt: deployed at $drecorded_version, digest drift detected -- run 'labdrian apply --target $dt'"
    fi
  done

  echo ""
  if [[ "$fail" -ne 0 ]]; then
    echo "doctor: FAIL — one or more required checks did not pass (see above)." >&2
    # Still run --fix provisioning if requested, then re-check tools, but exit 1 after.
    if [[ "$fix" -eq 1 ]]; then
      echo ""
      echo "==> --fix: engine binary..."
      doctor_fix_engine_binary
      echo ""
      echo "==> Re-checking the engine binary after --fix..."
      doctor_report_engine_binary
      echo ""
      echo "==> --fix: attempting to provision discovery tools despite FAIL above..."
      ensure_discovery_tools
      echo ""
      echo "==> Re-checking discovery tools after provisioning..."
      recheck_discovery_tools
    fi
    exit 1
  fi
  echo "doctor: OK — required checks passed (review any WARN above)."

  # --fix: explicit opt-in to provision missing discovery tools, then re-check.
  if [[ "$fix" -eq 1 ]]; then
    echo ""
    echo "==> --fix: engine binary..."
    doctor_fix_engine_binary
    echo ""
    echo "==> Re-checking the engine binary after --fix..."
    doctor_report_engine_binary
    echo ""
    echo "==> --fix: provisioning discovery tools (${DISCOVERY_TOOLS[*]})..."
    ensure_discovery_tools
    echo ""
    echo "==> Re-checking discovery tools after provisioning..."
    recheck_discovery_tools
  fi
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

# Guarded so this file can be `source`d (e.g. by tui/internal/adapters/overlaycli/release_backend_test.go)
# to call an internal function directly for unit-style testing, without also
# running the CLI dispatch below. Normal execution (./bin/labdrian-overlay, or a
# symlink to it such as the one install-alias makes) is unaffected: BASH_SOURCE[0]
# and $0 are identical for a top-level executed script.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  COMMAND="${1:-}"
  shift || true

  case "$COMMAND" in
    bootstrap)       cmd_bootstrap "$@" ;;
    capture)         cmd_capture "$@" ;;
    apply)           cmd_apply "$@" ;;
    self-update)     cmd_self_update "$@" ;;
    update)          cmd_update "$@" ;;
    restore)         cmd_restore "$@" ;;
    targets)         cmd_targets "$@" ;;
    version|--version) cmd_version "$@" ;;
    status)          cmd_status "$@" ;;
    sync-check)      cmd_sync_check "$@" ;;
    install-hooks)   cmd_install_hooks "$@" ;;
    uninstall-hooks) cmd_uninstall_hooks "$@" ;;
    status-hooks)    cmd_status_hooks "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    repair-sdd-registry) cmd_repair_sdd_registry "$@" ;;
    skill-registry)  cmd_skill_registry "$@" ;;
    tui)             cmd_tui "$@" ;;
    install-alias)   cmd_install_alias "$@" ;;
    prespec)         cmd_prespec "$@" ;;
    skills)          cmd_skills "$@" ;;
    shaper)          cmd_shaper "$@" ;;
    roles)           cmd_roles "$@" ;;
    memory)          cmd_memory "$@" ;;
    workflow)        cmd_workflow "$@" ;;
    validate-entry-contract) cmd_validate_entry_contract "$@" ;;
    deterministic-checks) cmd_deterministic_checks "$@" ;;
    archive-reconcile) cmd_archive_reconcile "$@" ;;
    gadu-generate)   cmd_gadu_generate "$@" ;;
    longterm-mem)    cmd_longterm_mem "$@" ;;
    --help|-h)       usage; exit 0 ;;
    "")              usage >&2; exit 1 ;;
    *)               die "Unknown command: $COMMAND" ;;
  esac
fi
