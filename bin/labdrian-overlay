#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of this script, following symlinks.
# Uses a pure-bash loop instead of readlink -f so it works on macOS/BSD too.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
CALLER_CWD="$PWD"
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Allow OVERLAY_DIR to be overridden via environment variable (useful for tests
# and power-user workflows; normal use leaves it unset so it auto-detects here).
OVERLAY_DIR="${OVERLAY_DIR:-"$(cd "$SCRIPT_DIR/.." && pwd)"}"
TARBALL="$HOME/.gentle-ai/backups/upgrade-20260615T175529Z/snapshot.tar.gz"
MANIFEST="${MANIFEST:-"$OVERLAY_DIR/overlay.manifest"}"

declare -A TARGET_PATHS=(
  [claude]="$HOME/.claude/skills"
  [opencode]="$HOME/.config/opencode/skills"
  [codex]="$HOME/.codex/skills"
)

# Native agent-route destinations. Claude Code and OpenCode use different
# frontmatter schemas, so they are deployed from separate generated files.
declare -A AGENT_TARGET_PATHS=(
  [claude]="$HOME/.claude/agents"
  [opencode]="$HOME/.config/opencode/agents"
)

# Known limitations (explicitly out of scope for this change, R-009):
#   - The bootstrap init block's human-readable info echoes (dir creation) remain
#     skills-first. They are a no-op for GADU (custom rows) and only matter for a
#     hypothetical future managed agent row.
#   - No native Codex agent-definition files are produced (R-009).
#   - No SDD orchestrator auto-spawn wiring (R-009).

# Path where the engine binary is deployed. Using ~/.claude/bin/ keeps all
# Claude Code tooling co-located and makes the binary easy to find in hooks.
ENGINE_BINARY="$HOME/.claude/bin/gentle-ai-overlay"
ENGINE_SRC="$OVERLAY_DIR/engine"

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() { echo "ERROR: $*" >&2; exit 1; }
info() { echo "==> $*"; }
warn() { echo "WARN: $*" >&2; }

# Read manifest: emit "path tag" lines, skipping blank lines and comments
parse_manifest() {
  grep -v '^\s*#' "$MANIFEST" | grep -v '^\s*$'
}

# Managed files only
managed_files() {
  parse_manifest | awk '$2 == "managed" { print $1 }'
}

# All tracked files (managed + custom)
all_tracked_files() {
  parse_manifest | awk '{ print $1 }'
}

# Ensure the parent directory of a path exists
ensure_parent() {
  local path="$1"
  local parent
  parent="$(dirname "$path")"
  mkdir -p "$parent"
}

# Resolve --target argument to a space-separated list of target names
resolve_targets() {
  local arg="${1:-all}"
  if [[ "$arg" == "all" ]]; then
    echo "claude opencode codex"
  elif [[ -v TARGET_PATHS["$arg"] ]]; then
    echo "$arg"
  else
    die "Unknown target: $arg. Valid: claude, opencode, codex, all"
  fi
}

# ---------------------------------------------------------------------------
# usage
# ---------------------------------------------------------------------------

usage() {
  cat <<'EOF'
Usage: overlay <command> [options]

Commands:
  bootstrap                        Initialize overlay repo and branches
  capture [--target claude|opencode|codex] [--from-backup DIR]
                                   Capture managed files from target (default: claude).
                                   Pushes the 'upstream' mirror branch to origin.
  apply [--target claude|opencode|codex|all] [--push]
                                   Merge upstream and deploy to target(s) (default: all).
                                   Never pushes main unless --push; without it, reports
                                   how far local main is ahead of origin/main.
  self-update                     Fast-forward ONLY local 'main' to 'origin/main' (never the
                                   current branch), then return to the branch you were on.
                                   Refuses (exit 1) on a dirty tracked tree, a local main
                                   ahead of origin/main, or no 'origin' remote. Untracked
                                   files never block it.
  status [--target claude|opencode|codex|all]
                                   Show drift between repo and target(s) (default: all)
  sync-check [--target claude|opencode|codex|all] [--check-origin|--fetch]
                                   Validate gentle-ai sync state per target (default: all).
                                   Also reports REPO_BEHIND_ORIGIN=<count|NA> on each VERDICT
                                   line: how many commits local main is behind this repo's own
                                   origin/main. Default is a cached-ref comparison (no network
                                   call); pass --check-origin (alias --fetch) to run
                                   'git fetch origin' first for a live count. NA means the
                                   comparison is unavailable (no origin remote, no cached ref,
                                   or a requested fetch failed) -- other checks still complete.
  install-hooks                    Build + deploy the engine binary, then wire the two
                                   deterministic-scoping hooks into ~/.claude/settings.json.
                                   DELIBERATE ACTION — not called by 'apply'. Run once to
                                   activate; the hooks are INERT until this command runs.
                                   Also best-effort installs discovery tools (bat rg fd sd
                                   eza) via Homebrew so agents never hit the silent-empty
                                   footgun. Set OVERLAY_SKIP_TOOL_INSTALL=1 to opt out.
  uninstall-hooks                  Remove our two hook entries from ~/.claude/settings.json,
                                   leaving all other keys and hooks intact.
  status-hooks                     Read-only check of overlay installation health: binary
                                   present, hooks wired, contract readable. Exits 0 if all
                                   OK, 1 if any check fails. Safe to run at any time.
  doctor [--fix]                   Read-only host-toolchain preflight: checks go (required),
                                   gentle-ai, bat/rg/fd/sd/eza, the engine binary, and a
                                   non-empty skill-registry. Prints PASS/WARN/FAIL per check;
                                   exits non-zero only on a hard FAIL. Safe to run at any time.
                                   --fix: after the checks, attempt to install any missing
                                   discovery tools (bat rg fd sd eza) via Homebrew (best-effort,
                                   non-fatal), then re-check and report the result.
  repair-sdd-registry [--cwd DIR] [--target claude|opencode|codex] [--no-refresh]
                                   Refresh and repair .atl/skill-registry.md so existing
                                   sdd-* phase executor skills stay resolvable after
                                   gentle-ai sync/skill-registry refresh.
  skill-registry refresh [--cwd DIR] [--target claude|opencode|codex] [--no-repair]
                                   Run gentle-ai skill-registry refresh, then immediately
                                   repair sdd-* executor rows for the selected target
                                   (default target: codex).
  tui                              Launch the Bubbletea TUI front-end
  install-alias [name]             Symlink a command (default: labdrian) into ~/.local/bin
  prespec <verb>                   Forward to the engine's prespec discovery core
                                   (verbs: rank, lint, readiness, brief). Reads JSON
                                   from stdin, writes JSON to stdout. Used by the
                                   prespec-malandra skill.
  skills <verb>                    Forward to the engine's skills registry core
                                   list      print sorted registry entries
                                   status    print count summary
                                   validate  cross-check registry vs overlay.manifest,
                                             and skills/ on disk vs overlay.manifest
                                             (requires --source-root)
                                   install   copy project-scoped skills into <cwd>/.claude/skills
                                   add <id> [--repo <url>] [--ref <sha>]
                                             register a skill: custom (no --repo) or
                                             external=vendored provenance (--repo set).
                                             The overlay NEVER fetches; --repo/--ref are
                                             inert labels for a file you already committed.
                                   remove <id> unregister a skill from registry + manifest
                                   sync-manifest  regenerate */SKILL.md rows from skills.registry.yaml
  validate-entry-contract          Validate a pre-SDD entry candidate with the version-matched
    --schema PATH --instance PATH  schema and deterministic semantic checks. Relative paths are
                                   resolved from the caller's working directory. Preserves validator
                                   exit codes 2-6 and does not modify installed skill roots.
  deterministic-checks             Run the hardcoded v1 check set (gofmt, go vet, staticcheck,
    <normalize|check> [--top-n N]  deadcode) via the overlay-owned runner. 'check' never mutates;
    [--out-dir DIR]                'normalize' applies fixers. Exit 0=passed, 1=verification_failed,
                                   3=procedural_tooling_failed; propagated unchanged from the runner.
  review-preflight                 Ask whether a review started in the caller's cwd would cover
    [--base-ref REF]               anything, by reading the projection 'gentle-ai review status'
                                   reports. Exit 0=candidate covers something, 1=EMPTY candidate
                                   (a review here would approve nothing), 2=usage,
                                   3=could not determine; propagated unchanged from the guard.
  gadu-generate [--check]          Regenerate GADU artifacts from the canonical source
                                   (agents/GADU.md, opencode/agents/GADU.md,
                                   skills/gadu-operator/SKILL.md) under OVERLAY_DIR.
                                   Optional --check verifies freshness without writing.
  --help                           Show this help

Targets:
  claude   → ~/.claude/skills
  opencode → ~/.config/opencode/skills
  codex    → ~/.codex/skills

Hook activation notes:
  - 'overlay apply' does NOT call install-hooks. Deploy of skills and hook
    wiring are intentionally separate so skills can be updated without
    mutating ~/.claude/settings.json.
  - Run 'overlay install-hooks' once after initial setup (or after a binary
    update) to activate deterministic scoping.
  - status-hooks is now read-only and fails loudly when the engine binary is
    absent (run 'overlay install-hooks').
EOF
}

SDD_EXECUTOR_SKILLS=(
  sdd-apply
  sdd-archive
  sdd-design
  sdd-explore
  sdd-init
  sdd-onboard
  sdd-propose
  sdd-spec
  sdd-tasks
  sdd-time-estimation
  sdd-verify
)

skill_frontmatter_description() {
  local skill_file="$1"
  awk '
    /^description:[[:space:]]*/ {
      sub(/^description:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"$/, "")
      gsub(/\|/, "\\|")
      print
      exit
    }
  ' "$skill_file"
}

repair_sdd_registry_file() {
  local registry="$1"
  local target="$2"
  local skill_root="${TARGET_PATHS[$target]}"

  mkdir -p "$(dirname "$registry")"
  if [[ ! -f "$registry" ]]; then
    cat > "$registry" <<EOF
# Skill Registry — $(basename "$(dirname "$(dirname "$registry")")")

## Skills

| Skill | Trigger / description | Scope | Path |
| --- | --- | --- | --- |

## Loading protocol

1. Match task context and target files against the \`Trigger / description\` column.
2. Pass only the matching \`Path\` values to the subagent under \`## Skills to load before work\`.
EOF
  fi

  grep -q '^## Skills$' "$registry" || die "registry has no '## Skills' section: $registry"
  grep -q '^## Loading protocol$' "$registry" || die "registry has no '## Loading protocol' section: $registry"

  local block tmp
  block="$(mktemp)"
  tmp="$(mktemp)"
  trap 'rm -f "$block" "$tmp"' RETURN

  local name path desc missing=0
  for name in "${SDD_EXECUTOR_SKILLS[@]}"; do
    path="$skill_root/$name/SKILL.md"
    if [[ ! -f "$path" ]]; then
      warn "missing $target SDD executor skill: $path"
      missing=$((missing + 1))
      continue
    fi
    desc="$(skill_frontmatter_description "$path")"
    [[ -n "$desc" ]] || desc="SDD phase executor: $name."
    printf '| `%s` | %s | executor | `%s` |\n' "$name" "$desc" "$path" >> "$block"
  done

  local note
  note='`sdd-*` phase skills are executor contracts. Gentle may skip them as user-invocable skills, but this registry keeps their paths visible so SDD delegation can resolve the existing installed files.'

  awk -v note="$note" -v block="$block" '
    $0 == note { next }
    $0 ~ /^\| `sdd-[^`]+` \|/ { next }
    $0 == "## Skills" {
      print note
      print ""
      print
      next
    }
    $0 == "## Loading protocol" {
      while ((getline line < block) > 0) {
        print line
      }
      close(block)
      print ""
      print
      next
    }
    { print }
  ' "$registry" > "$tmp"

  mv "$tmp" "$registry"
  rm -f "$block"
  trap - RETURN

  local count
  count="$(grep -c '^| `sdd-' "$registry" || true)"
  echo "repair-sdd-registry: registry=$registry target=$target sdd_executors=$count missing=$missing"
}

# ---------------------------------------------------------------------------
# route_resolve — single source of truth for manifest entry → routing
# ---------------------------------------------------------------------------
#
# route_resolve <manifest_path>
#
# Reads the optional third column of the overlay.manifest row whose first field
# equals <manifest_path>. Emits ONE tab-separated line (side-effect-free):
#
#   <route>\t<repo_source_abs>\t<target_name>:<dest_abs> [...]
#
# route=skill (default; all existing bare two-column rows):
#   repo_source = $OVERLAY_DIR/skills/<path>
#   targets     = claude:<CLAUDE_SKILLS>/<path>  opencode:<OC_SKILLS>/<path>  codex:<CODEX_SKILLS>/<path>
#
# route=agent (third column == "agent"):
#   repo_source = $OVERLAY_DIR/agents/<path>
#   targets     = claude:$HOME/.claude/agents/<path>
#
# route=opencode-agent (third column == "opencode-agent"):
#   repo_source = $OVERLAY_DIR/opencode/agents/<path>
#   targets     = opencode:$HOME/.config/opencode/agents/<path>
#
# Callers intersect the emitted target set with their --target selection:
#   --target codex + agent row → zero applicable targets (no work, not an error).
#
# Back-compat invariant: bare two-column skill rows emit BYTE-IDENTICAL results
# to pre-route_resolve behavior (pinned by TestRouteResolve_LegacySkillRow).

route_resolve() {
  local manifest_path="$1"
  local route
  route="$(awk -v p="$manifest_path" '$1 == p { print $3; exit }' "$MANIFEST")"
  route="${route:-skill}"

  # Detect structurally non-deployable rows: paths that cannot map to a skill
  # or agent source directory. Overlay engine source files (engine/*) and
  # root-level files (no path separator, e.g. skills.registry.yaml) are
  # tracked in the manifest for diff/sync-check purposes only; they are never
  # copied to skills/ or agents/ targets.
  #
  # Rule: for skill-route rows (non-agent), if the first path segment equals
  # the full path (no "/") or equals "engine", the row is non-deployable.
  # Callers skip non-deployable rows silently because the emitted target list
  # is empty and their existing [[ -z "$rr_dest" ]] && continue guards fire.
  if [[ "$route" != "agent" ]]; then
    local first_seg="${manifest_path%%/*}"
    if [[ "$first_seg" == "$manifest_path" || "$first_seg" == "engine" ]]; then
      printf 'non-deployable\t\t\n'
      return
    fi
  fi

  local repo_source
  local targets=()
  local tname

  if [[ "$route" == "agent" ]]; then
    repo_source="$OVERLAY_DIR/agents/${manifest_path}"
    targets+=("claude:${AGENT_TARGET_PATHS[claude]}/${manifest_path}")
  elif [[ "$route" == "opencode-agent" ]]; then
    local opencode_agent_rel="${manifest_path#opencode/agents/}"
    if [[ "$opencode_agent_rel" == "$manifest_path" || -z "$opencode_agent_rel" ]]; then
      printf 'non-deployable\t\t\n'
      return
    fi
    repo_source="$OVERLAY_DIR/${manifest_path}"
    targets+=("opencode:${AGENT_TARGET_PATHS[opencode]}/${opencode_agent_rel}")
  else
    repo_source="$OVERLAY_DIR/skills/${manifest_path}"
    for tname in "${!TARGET_PATHS[@]}"; do
      targets+=("${tname}:${TARGET_PATHS[$tname]}/${manifest_path}")
    done
  fi

  printf '%s\t%s\t%s\n' "$route" "$repo_source" "${targets[*]}"
}

route_repo_rel() {
  local route="$1"
  local manifest_path="$2"

  case "$route" in
    agent)
      printf 'agents/%s' "$manifest_path"
      ;;
    opencode-agent)
      printf '%s' "$manifest_path"
      ;;
    skill)
      printf 'skills/%s' "$manifest_path"
      ;;
    *)
      printf '%s' "$manifest_path"
      ;;
  esac
}

# route_tar_path resolves where a manifest row is stored inside a backup tarball.
# The legacy backup layout is under ~/.claude. OpenCode-native agent rows must use
# ~/.config/opencode instead.
route_tar_path() {
  local route="$1"
  local repo_rel="$2"  # output of route_repo_rel()

  case "$route" in
    opencode-agent)
      printf 'files/home/labdrian/.config/opencode/%s' "${repo_rel#opencode/}"
      ;;
    *)
      printf 'files/home/labdrian/.claude/%s' "$repo_rel"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# bootstrap
# ---------------------------------------------------------------------------

cmd_bootstrap() {
  info "Bootstrapping overlay repo at $OVERLAY_DIR"

  # 1. Init git repo if needed
  if [[ ! -d "$OVERLAY_DIR/.git" ]]; then
    git init "$OVERLAY_DIR"
  fi

  cd "$OVERLAY_DIR"

  # 2. Ensure all required directories exist
  mkdir -p bin \
    skills/sdd-spec \
    skills/sdd-tasks \
    skills/sdd-verify/references \
    skills/requirements-from-transcripts

  # 3. Write scaffold files if not present
  if [[ ! -f "$OVERLAY_DIR/README.md" ]]; then
    echo "# labdrian-sdd-overlay" > "$OVERLAY_DIR/README.md"
  fi
  if [[ ! -f "$OVERLAY_DIR/overlay.manifest" ]]; then
    die "overlay.manifest not found — ensure it exists before running bootstrap"
  fi
  if [[ ! -f "$OVERLAY_DIR/.gitignore" ]]; then
    printf '*.swp\n*.swo\n*~\n.DS_Store\n' > "$OVERLAY_DIR/.gitignore"
  fi

  # 4. Stage scaffold (bin/overlay itself is already here; stage it too)
  git add README.md overlay.manifest .gitignore bin/overlay

  # 5. Initial commit (only if none exists)
  if ! git log --oneline 2>/dev/null | head -1 | grep -q .; then
    git commit -m "chore: initial overlay scaffold"
  fi

  # 6. Create/switch to upstream branch
  git checkout -B upstream

  # 7. Extract managed files from tarball
  info "Extracting managed files from tarball: $TARBALL"
  if [[ ! -f "$TARBALL" ]]; then
    die "Tarball not found: $TARBALL"
  fi

  # Pre-build tar listing once to avoid SIGPIPE issues with set -euo pipefail
  local tar_listing
  tar_listing="$(tar tzf "$TARBALL" 2>/dev/null)"

  while IFS= read -r rel_path; do
    local rr_line rr_route rr_src rr_rest rr_repo_rel
    rr_line="$(route_resolve "$rel_path")"
    rr_route="${rr_line%%$'\t'*}"
    rr_rest="${rr_line#*$'\t'}"
    rr_src="${rr_rest%%$'\t'*}"
    rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"

    tar_path="$(route_tar_path "$rr_route" "$rr_repo_rel")"
    dest="$rr_src"
    ensure_parent "$dest"

    if echo "$tar_listing" | grep -qF "$tar_path"; then
      tar xzf "$TARBALL" --to-stdout "$tar_path" > "$dest"
      info "  extracted: ${rr_repo_rel}"
    else
      echo "  WARNING: not found in tarball, skipping: $tar_path"
    fi
  done < <(managed_files)

  # 8. Commit upstream baseline (only if there are changes)
  git add skills/
  test -d agents && git add agents/ || true
  test -d opencode && git add opencode/ || true
  if [[ -n "$(git status --porcelain)" ]]; then
    git commit -m "upstream: baseline from gentle-ai 1.40.2"
  else
    info "No changes to commit on upstream (already up to date)"
  fi

  # 9. Create main from upstream (AFTER upstream commit)
  git checkout -B main upstream

  # 10. Copy current customized files from live targets onto main
  info "Layering customized files onto main..."
  while IFS= read -r line; do
    rel_path="$(echo "$line" | awk '{ print $1 }')"
    local rr_line rr_src rr_rest rr_targets rr_dest rr_pair
    rr_line="$(route_resolve "$rel_path")"
    rr_rest="${rr_line#*$'\t'}"
    rr_src="${rr_rest%%$'\t'*}"      # repo dest
    rr_targets="${rr_rest#*$'\t'}"
    # Source from the claude live location when applicable (bootstrap layers from claude).
    rr_dest=""
    for rr_pair in $rr_targets; do
      [[ "${rr_pair%%:*}" == "claude" ]] && rr_dest="${rr_pair#*:}" && break
    done
    [[ -z "$rr_dest" ]] && continue

    src="${rr_dest}"
    dest="$rr_src"
    ensure_parent "$dest"

    if [[ -f "$src" ]]; then
      cp "$src" "$dest"
      info "  copied: $rel_path"
    else
      echo "  WARNING: source file not found, skipping: $src"
    fi
  done < <(parse_manifest)

  # 11. Commit overlay
  git add skills/
  test -d agents && git add agents/ || true
  test -d opencode && git add opencode/ || true
  if [[ -n "$(git status --porcelain)" ]]; then
    git commit -m "overlay: EARS notation + stable R-NNN IDs"
  else
    info "No customization diff detected — main is identical to upstream"
  fi

  echo ""
  echo "Bootstrap complete."
  echo "  upstream branch: pristine vendor baseline"
  echo "  main branch:     your customized overlay (current)"
  echo ""
  git log --oneline --all
}

# ---------------------------------------------------------------------------
# capture
# ---------------------------------------------------------------------------

cmd_capture() {
  cd "$OVERLAY_DIR"

  local from_backup=""
  local target_arg="claude"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --from-backup)
        shift
        from_backup="${1:-}"
        [[ -n "$from_backup" ]] || die "--from-backup requires a path argument"
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  # Validate single target (capture only supports one at a time)
  if [[ "$target_arg" == "all" ]]; then
    die "capture does not support --target all. Specify a single target: claude, opencode, codex"
  fi
  [[ -v TARGET_PATHS["$target_arg"] ]] || die "Unknown target: $target_arg. Valid: claude, opencode, codex"

  local target_dir="${TARGET_PATHS[$target_arg]}"

  # Refuse to run over uncommitted tracked changes: capture switches branches
  # and must never mix a dirty working tree into the sync commit.
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
    || die "Working tree has uncommitted tracked changes. Commit or stash them before capture."

  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"

  # Always return to the original branch, even if a later step fails under
  # 'set -euo pipefail' — prevents stranding the working tree on 'upstream'.
  # Expand the branch name NOW: an EXIT trap fires after the function's locals
  # are gone, and referencing them there is an unbound variable under 'set -u'.
  trap "git checkout '${current_branch}' >/dev/null 2>&1 || true" EXIT

  git checkout upstream

  # Reconcile with origin before capturing. 'upstream' is a mechanical
  # mirror pushed immediately after every capture (see below), so it should
  # normally already match origin/upstream — but if origin/upstream advanced
  # independently since this clone's last fetch (another machine captured
  # and pushed, or a manual reconcile merge landed there), a stale local ref
  # makes the push below either get rejected non-fast-forward (crashing the
  # whole capture under 'set -euo pipefail' despite the local capture
  # already having succeeded) or, worse, silently skip the push entirely
  # (the "anything to push?" check below reads the same stale cached
  # origin/upstream). Fetch first so that check is accurate, then
  # fast-forward when possible; when local ALSO carries unpushed commits,
  # merge non-interactively rather than discarding them — capture's own
  # comment below already promises a sync never strands local-only commits.
  # A fetch failure (offline) degrades gracefully: capture's core job is the
  # local commit, not the network round trip, so warn and proceed rather
  # than dying (parity with the "no origin remote" skip a few lines down).
  if git remote get-url origin >/dev/null 2>&1; then
    if git fetch origin upstream >/dev/null 2>&1; then
      if git rev-parse --verify -q origin/upstream >/dev/null; then
        if ! git merge --ff-only origin/upstream >/dev/null 2>&1; then
          git merge --no-edit origin/upstream \
            || die "'upstream' diverged from origin/upstream and auto-merge conflicted; resolve manually on the 'upstream' branch, then retry capture."
          info "Reconciled local 'upstream' with origin/upstream before capturing"
        fi
      fi
    else
      warn "git fetch origin upstream failed — proceeding without reconciling; push below may fail if origin has advanced"
    fi
  fi

  if [[ -n "$from_backup" ]]; then
    info "Capturing managed files from tarball: $from_backup"
    [[ -f "$from_backup" ]] || die "Tarball not found: $from_backup"

    local cap_listing
    cap_listing="$(tar tzf "$from_backup" 2>/dev/null)"

    while IFS= read -r rel_path; do
      local rr_line rr_route rr_src rr_rest rr_repo_rel
      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"

      tar_path="$(route_tar_path "$rr_route" "$rr_repo_rel")"
      dest="$rr_src"
      ensure_parent "$dest"

      if echo "$cap_listing" | grep -qF "$tar_path"; then
        tar xzf "$from_backup" --to-stdout "$tar_path" > "$dest"
        info "  extracted: ${rr_repo_rel}"
      else
        echo "  WARNING: not found in tarball, skipping: $tar_path"
      fi
    done < <(managed_files)
  else
    info "Capturing managed files from $target_dir"
    while IFS= read -r rel_path; do
      local rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair
      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_targets="${rr_rest#*$'\t'}"
      # Find live path for the requested target; skip if not applicable (e.g. native agent + codex)
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$target_arg" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      src="$rr_dest"
      dest="$rr_src"
      ensure_parent "$dest"

      if [[ -f "$src" ]]; then
        cp "$src" "$dest"
        info "  copied: $rel_path"
      else
        echo "  WARNING: source file not found, skipping: $src"
      fi
    done < <(managed_files)
  fi

  git add skills/
  test -d "$OVERLAY_DIR/agents" && git add agents/ || true
  test -d "$OVERLAY_DIR/opencode" && git add opencode/ || true
  # Commit only if deployable tracked files have STAGED changes. `git diff --cached --quiet`
  # ignores unrelated untracked paths (.engram/, tui/) present on 'upstream'
  # that previously caused a doomed `git commit` (exit 1) stranding the tree.
  if git diff --cached --quiet; then
    info "No changes detected — upstream already up to date"
  else
    git commit -m "upstream: sync from gentle-ai $(date +%Y-%m-%d)"
    info "upstream updated"
  fi

  # 'upstream' is a mechanical mirror of gentle-ai — push it immediately so a
  # sync never strands local-only commits (also flushes earlier unpushed runs).
  # A repo with no 'origin' remote (tests, detached mirrors) has nowhere to
  # push: skip loudly instead of failing the capture that already committed.
  if ! git remote get-url origin >/dev/null 2>&1; then
    info "No 'origin' remote — skipping upstream push"
  elif git rev-parse --verify -q origin/upstream >/dev/null; then
    if [[ -n "$(git rev-list origin/upstream..upstream)" ]]; then
      git push origin upstream
      info "Pushed upstream to origin"
    fi
  else
    git push -u origin upstream
    info "Pushed upstream to origin (new remote branch)"
  fi

  git checkout "$current_branch"
  trap - EXIT
  info "Returned to branch: $current_branch"
}

# ---------------------------------------------------------------------------
# apply
# ---------------------------------------------------------------------------

cmd_apply() {
  cd "$OVERLAY_DIR"

  local target_arg="all"
  local push_main=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --push)
        push_main=1
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  # Refuse to run over uncommitted tracked changes: apply switches branches
  # and merges, and must never entangle a session's work in progress.
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
    || die "Working tree has uncommitted tracked changes. Commit or stash them before apply."

  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"

  # Always return to the original branch, even if a later step fails — apply
  # must never strand a session's checkout on 'main'. On merge conflicts git
  # refuses the checkout, so the trap degrades to staying on main to resolve.
  # Expand the branch name NOW: an EXIT trap fires after the function's locals
  # are gone, and referencing them there is an unbound variable under 'set -u'.
  trap "git checkout '${current_branch}' >/dev/null 2>&1 || true" EXIT

  git checkout main

  info "Merging upstream into main..."
  if ! git merge upstream; then
    echo ""
    echo "MERGE CONFLICTS detected. Resolve the following files, then run:"
    echo "  git -C \"$OVERLAY_DIR\" add <file>"
    echo "  git -C \"$OVERLAY_DIR\" commit"
    echo "  overlay apply  (re-run to deploy after resolving)"
    echo ""
    echo "Conflicted files:"
    git diff --name-only --diff-filter=U
    exit 1
  fi

  for t in $(resolve_targets "$target_arg"); do
    local tpath="${TARGET_PATHS[$t]}"
    echo ""
    echo "=== Deploying to: $t ==="

    if [[ ! -d "$tpath" ]]; then
      mkdir -p "$tpath"
      echo "  (created target directory: $tpath)"
    fi

    local deployed=0
    local in_sync=0

    while IFS= read -r rel_path; do
      local rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair rr_repo_rel
      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_targets="${rr_rest#*$'\t'}"
      # Find dest for the current target ($t); skip if not in applicable set
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$t" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      src="$rr_src"
      dest="$rr_dest"
      ensure_parent "$dest"

      if [[ -f "$src" ]]; then
        if [[ -f "$dest" ]] && diff --brief "$src" "$dest" > /dev/null 2>&1; then
          in_sync=$((in_sync + 1))
        else
          cp "$src" "$dest"
          deployed=$((deployed + 1))
        fi
      else
        rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"
        echo "  WARNING: ${rr_repo_rel} not found in overlay, skipping"
      fi
    done < <(all_tracked_files)

    echo "  $t: deployed=$deployed in-sync=$in_sync"
  done

  echo ""
  echo "Deploy complete."

  git checkout "$current_branch"
  trap - EXIT
  info "Returned to branch: $current_branch"

  # main is never pushed silently: pushing main is deliberate delivery. An
  # explicit --push must push or fail loudly — never no-op — so it runs
  # unconditionally ('set -euo pipefail' aborts if the remote is unreachable).
  # Without --push, make any local-only divergence loud.
  if [[ -n "$push_main" ]]; then
    git push origin main
    info "Pushed main to origin"
  elif git rev-parse --verify -q origin/main >/dev/null; then
    local ahead
    ahead="$(git rev-list --count origin/main..main)"
    if [[ "$ahead" -gt 0 ]]; then
      echo ""
      echo "NOTICE: local main is $ahead commit(s) ahead of origin/main."
      echo "  Push deliberately with: overlay apply --push"
      echo "  or: git -C \"$OVERLAY_DIR\" push origin main"
    fi
  fi
}

# ---------------------------------------------------------------------------
# self-update
# ---------------------------------------------------------------------------

# Fast-forwards ONLY the local 'main' branch to 'origin/main' and restores the
# original branch afterward, via the same trap-based EXIT pattern used by
# cmd_capture/cmd_apply. Every refusal (no origin, dirty tree, local-ahead
# divergence) fires BEFORE any checkout, so a refusal never touches the
# working tree or leaves the caller's branch stranded. Flagless: this signal
# is repo-level, not target-scoped.
cmd_self_update() {
  cd "$OVERLAY_DIR"

  [[ $# -eq 0 ]] || die "Unknown option: $1"

  # 1. No 'origin' remote -> nothing to converge against.
  git remote get-url origin >/dev/null 2>&1 \
    || die "self-update requires an 'origin' remote; none is configured."

  # 2. Dirty tracked tree -> hard refusal, before any checkout. Untracked
  #    files are ignored (capture/apply parity, see cmd_capture/cmd_apply).
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
    || die "Working tree has uncommitted tracked changes. Commit or stash them before self-update."

  # 3. Bounded fetch of main only (idiom from compute_repo_behind_origin).
  #    'timeout' is optional -- not on stock macOS -- so this degrades to an
  #    unbounded (but still low-speed-guarded) fetch rather than a hard dep.
  if command -v timeout >/dev/null 2>&1; then
    timeout 10 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin main \
      || die "git fetch origin main failed."
  else
    git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin main \
      || die "git fetch origin main failed."
  fi

  # 4. Local main ahead of origin/main -> hard refusal (R-006). Deliberately
  #    stricter than cmd_apply's advisory-only ahead notice: self-update
  #    converges main, it never silently diverges further from a local-only
  #    commit that only exists on this clone.
  local ahead
  ahead="$(git rev-list --count origin/main..main)"
  [[ "$ahead" -eq 0 ]] \
    || die "Local main is $ahead commit(s) ahead of origin/main; self-update refuses to diverge further. Resolve manually (e.g. 'overlay apply --push')."

  # 5. Already up to date -> exit 0, no branch switch at all.
  local behind
  behind="$(git rev-list --count main..origin/main)"
  if [[ "$behind" -eq 0 ]]; then
    info "main is already up to date with origin/main"
    return
  fi

  # 6. Only now: converge main, always returning to the original branch.
  #    Expand the branch name NOW: an EXIT trap fires after the function's
  #    locals are gone, and referencing them there is an unbound variable
  #    under 'set -u' (the c891c94 lesson).
  local current_branch old_main new_main
  current_branch="$(git rev-parse --abbrev-ref HEAD)"
  old_main="$(git rev-parse main)"

  trap "git checkout '${current_branch}' >/dev/null 2>&1 || true" EXIT

  git checkout main
  git merge --ff-only origin/main
  new_main="$(git rev-parse main)"

  git checkout "$current_branch"
  trap - EXIT

  info "Updated main: ${old_main:0:12}..${new_main:0:12} (fast-forward)"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

cmd_status() {
  cd "$OVERLAY_DIR"

  local target_arg="all"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  echo "=== Branch ==="
  git rev-parse --abbrev-ref HEAD

  echo ""
  echo "=== Diff stat upstream..main ==="
  git diff --stat upstream..main || echo "(no diff)"

  for t in $(resolve_targets "$target_arg"); do
    local tpath="${TARGET_PATHS[$t]}"
    echo ""
    echo "=== Status: $t ==="

    while IFS= read -r rel_path; do
      local rr_line rr_src rr_targets rr_dest rr_pair
      rr_line="$(route_resolve "$rel_path")"
      rr_src="${rr_line#*$'\t'}"; rr_src="${rr_src%%$'\t'*}"
      rr_targets="${rr_line##*$'\t'}"
      # Find live_file for this target; skip if route not applicable
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$t" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      repo_file="$rr_src"
      live_file="$rr_dest"

      if [[ ! -f "$repo_file" ]]; then
        echo "  MISSING in repo: $rel_path"
      elif [[ ! -f "$live_file" ]]; then
        echo "  MISSING in target: $rel_path"
      else
        if diff --brief "$repo_file" "$live_file" > /dev/null 2>&1; then
          echo "  in sync  : $rel_path"
        else
          echo "  DIFFERS  : $rel_path"
        fi
      fi
    done < <(all_tracked_files)
  done
}

# ---------------------------------------------------------------------------
# sync-check
# ---------------------------------------------------------------------------

# Computes how many commits local main is behind this repo's own origin/main,
# repo-level (not target-scoped). Emits an integer count on stdout, or the
# literal token "NA" when the comparison is unavailable (no origin remote, no
# cached ref, or a requested live fetch failed).
#
# When check_origin is "true", runs `git fetch origin` first for a live
# comparison. Every new git invocation here is wrapped in the same
# `if <cmd> 2>/dev/null; then ... else ...NA...; fi` guard idiom already used
# elsewhere in this function (precedent: line ~854, `if git cat-file -e
# "main:${rr_repo_rel}" 2>/dev/null; then ...`), so a missing remote/ref or a
# failed fetch degrades to NA instead of aborting the script under
# `set -euo pipefail`.
#
# The fetch is best-effort time-bounded (wrapped in `timeout` when that
# coreutil is available -- not on stock macOS, so this degrades gracefully
# rather than being a hard new dependency) so a stalled network path (VPN
# half-up, black-holed proxy) cannot hang sync-check indefinitely; a
# `low-speed` git config guards the HTTPS-transport case the same way.
#
# Every NA-producing branch below writes a one-line explanation to stderr
# (not stdout, so it never contaminates the count/NA value captured by
# callers via command substitution) using the `SYNC_CHECK:(repo):` prefix --
# "(repo)" is a deliberate, documented repo-scope marker distinct from the
# `SYNC_CHECK:$t:` per-target prefix used elsewhere in this file (this
# comparison is repo-level, not target-scoped, and no real target name would
# fit here). The fetch-failure branch additionally includes the first line
# of git's own error text, so a security-relevant failure (e.g. a host-key
# mismatch or TLS verification error) is distinguishable from a benign
# offline failure instead of both collapsing into the same generic message.
compute_repo_behind_origin() {
  local check_origin="$1"

  if ! git remote get-url origin >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no 'origin' remote configured -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
    return
  fi

  if [[ "$check_origin" == true ]]; then
    local fetch_err="" fetch_ok=true
    if command -v timeout >/dev/null 2>&1; then
      fetch_err="$(timeout 10 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin 2>&1 >/dev/null)" || fetch_ok=false
    else
      fetch_err="$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch origin 2>&1 >/dev/null)" || fetch_ok=false
    fi
    if [[ "$fetch_ok" == false ]]; then
      local fetch_err_line="${fetch_err%%$'\n'*}"
      echo "SYNC_CHECK:(repo): git fetch origin failed -- degrading REPO_BEHIND_ORIGIN to NA (${fetch_err_line:-no error output})" >&2
      echo "NA"
      return
    fi
  fi

  if ! git rev-parse --verify -q refs/remotes/origin/main >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no cached refs/remotes/origin/main (never fetched) -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
    return
  fi

  # Compared against local 'main', never the checked-out branch (HEAD). This
  # must track the exact ref self-update converges: self-update fast-forwards
  # ONLY main and always returns to whatever branch was current (D1-D3), so a
  # HEAD-relative comparison stays nonzero forever when the current branch
  # isn't main -- the TUI's "Actualizar repositorio" button would fast-forward
  # main for real but its own banner would never report convergence. This is
  # also the same ref cmd_sync_check's own per-file comparisons already use
  # ("main:${rr_repo_rel}" below), so this makes the diagnostic agree with
  # both its producer (self-update) and its sibling check (per-file drift).
  if ! git rev-parse --verify -q refs/heads/main >/dev/null 2>&1; then
    echo "SYNC_CHECK:(repo): no local 'main' branch -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
    return
  fi

  local count
  if count="$(git rev-list main..origin/main --count 2>/dev/null)"; then
    echo "$count"
  else
    echo "SYNC_CHECK:(repo): git rev-list main..origin/main failed -- REPO_BEHIND_ORIGIN unavailable" >&2
    echo "NA"
  fi
}

cmd_sync_check() {
  cd "$OVERLAY_DIR"

  local target_arg="all"
  local check_origin=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        shift
        target_arg="${1:-}"
        [[ -n "$target_arg" ]] || die "--target requires an argument"
        ;;
      --check-origin|--fetch)
        check_origin=true
        ;;
      *) die "Unknown option: $1" ;;
    esac
    shift || true
  done

  local repo_behind_origin
  repo_behind_origin="$(compute_repo_behind_origin "$check_origin")"

  for t in $(resolve_targets "$target_arg"); do
    local tpath="${TARGET_PATHS[$t]}"
    echo ""
    echo "=== sync-check: $t ($tpath) ==="

    if [[ ! -d "$tpath" ]]; then
      echo "SYNC_CHECK:$t: target dir not found at $tpath -- skipping"
      continue
    fi

    local upstream_changed=0
    local overlay_not_deployed=0

    while IFS= read -r line; do
      local rel_path tag rr_line rr_route rr_src rr_rest rr_targets rr_dest rr_pair rr_repo_rel
      rel_path="$(echo "$line" | awk '{ print $1 }')"
      tag="$(echo "$line" | awk '{ print $2 }')"

      rr_line="$(route_resolve "$rel_path")"
      rr_route="${rr_line%%$'\t'*}"
      rr_rest="${rr_line#*$'\t'}"
      rr_src="${rr_rest%%$'\t'*}"
      rr_targets="${rr_rest#*$'\t'}"
      rr_repo_rel="$(route_repo_rel "$rr_route" "$rel_path")"

      # Find live_file for this target; skip row if route not applicable
      rr_dest=""
      for rr_pair in $rr_targets; do
        [[ "${rr_pair%%:*}" == "$t" ]] && rr_dest="${rr_pair#*:}" && break
      done
      [[ -z "$rr_dest" ]] && continue

      local live_file="$rr_dest"

      # Hash of live file (empty string if missing)
      local live_hash=""
      if [[ -f "$live_file" ]]; then
        live_hash="$(sha256sum "$live_file" | awk '{ print $1 }')"
      fi

      # Hash of main version in repo (CORRECTNESS-CRITICAL: use route subdir, not hardcoded skills/)
      local main_hash=""
      if git cat-file -e "main:${rr_repo_rel}" 2>/dev/null; then
        main_hash="$(git show "main:${rr_repo_rel}" 2>/dev/null | sha256sum | awk '{ print $1 }')"
      fi

      # PRIMARY check: live == main → IN SYNC, nothing to do
      if [[ -n "$live_hash" && "$live_hash" == "$main_hash" ]]; then
        echo "  IN_SYNC: ${rr_repo_rel}"
        continue
      fi

      # live != main (or live missing) — determine why
      if [[ -z "$live_hash" ]]; then
        # File missing at target
        overlay_not_deployed=$((overlay_not_deployed + 1))
        echo "  OVERLAY_NOT_DEPLOYED: ${rr_repo_rel} (live missing)"
        continue
      fi

      # Determine if this is a MANAGED file (exists on upstream branch)
      local is_managed=false
      if git cat-file -e "upstream:${rr_repo_rel}" 2>/dev/null; then
        is_managed=true
      fi

      if [[ "$is_managed" == true ]]; then
        # Compare live vs upstream to distinguish subtypes
        local upstream_hash
        upstream_hash="$(git show "upstream:${rr_repo_rel}" 2>/dev/null | sha256sum | awk '{ print $1 }')"

        if [[ "$live_hash" == "$upstream_hash" ]]; then
          # live == upstream but live != main → overlay not deployed (customization reverted)
          overlay_not_deployed=$((overlay_not_deployed + 1))
          echo "  OVERLAY_NOT_DEPLOYED: ${rr_repo_rel} (live matches upstream, customization not deployed)"
        else
          # live != upstream AND live != main → upstream has a new pristine version we haven't captured
          upstream_changed=$((upstream_changed + 1))
          echo "  UPSTREAM_CHANGED: ${rr_repo_rel}"
        fi
      else
        # CUSTOM file (no upstream counterpart): live != main → overlay not deployed
        overlay_not_deployed=$((overlay_not_deployed + 1))
        echo "  OVERLAY_NOT_DEPLOYED: ${rr_repo_rel} (custom file, not deployed)"
      fi

    done < <(parse_manifest)

    echo ""
    echo "VERDICT:$t:UPSTREAM_CHANGED=$upstream_changed OVERLAY_NOT_DEPLOYED=$overlay_not_deployed REPO_BEHIND_ORIGIN=$repo_behind_origin"

    if [[ "$upstream_changed" -gt 0 ]]; then
      echo "ACTION:$t: gentle-ai sync detected: run 'overlay capture --target $t' then 'overlay apply' to re-merge your customizations"
    elif [[ "$overlay_not_deployed" -gt 0 ]]; then
      echo "ACTION:$t: run 'overlay apply --target $t'"
    elif [[ "$repo_behind_origin" != "NA" && "$repo_behind_origin" -gt 0 ]]; then
      echo "ACTION:$t: run 'git pull' to update your local clone (behind origin/main by $repo_behind_origin commit(s))"
    else
      echo "ACTION:$t: in sync with gentle-ai (healthy)"
    fi
  done
}

# ---------------------------------------------------------------------------
# tui
# ---------------------------------------------------------------------------

cmd_tui() {
  command -v go >/dev/null 2>&1 || die "go is not installed; required to run the TUI"
  [[ -d "$OVERLAY_DIR/tui" ]] || die "tui/ not found at $OVERLAY_DIR/tui"
  # First-run convenience: a fresh clone only checks out `main`, but sync-check and
  # the dashboard need a local `upstream` ref. Materialize it from origin/upstream if
  # missing, so the user can go straight from `install-alias` to `tui` and do
  # everything else (capture / apply / install-hooks) from inside the dashboard.
  if ! git -C "$OVERLAY_DIR" show-ref --verify --quiet refs/heads/upstream \
     && git -C "$OVERLAY_DIR" show-ref --verify --quiet refs/remotes/origin/upstream; then
    git -C "$OVERLAY_DIR" branch --force upstream origin/upstream >/dev/null 2>&1 \
      && info "Materialized local 'upstream' branch from origin/upstream."
  fi
  # Export repo root so the Go program can locate bin/labdrian-overlay reliably.
  export OVERLAY_DIR
  # Run from inside the module dir (repo root is not a Go module).
  cd "$OVERLAY_DIR/tui"
  exec go run .
}

# ---------------------------------------------------------------------------
# Discovery tools — canonical list used by ensure_discovery_tools,
# recheck_discovery_tools, and cmd_doctor. Change once here to update all.
# ---------------------------------------------------------------------------

DISCOVERY_TOOLS=(bat rg fd sd eza)

# ---------------------------------------------------------------------------
# ensure_discovery_tools
# ---------------------------------------------------------------------------
#
# Best-effort, NON-FATAL, idempotent provisioner for the five CLI tools the
# persona rule mandates: bat rg fd sd eza.
#
# Contract:
#   - PORTABLE: uses only 'command -v' for detection; never calls fd/eza/bat
#     inside the helper itself.
#   - NON-FATAL: a provisioning failure MUST NOT abort the caller. All brew
#     invocations are guarded against 'set -e' via explicit if/then/else.
#   - TRANSPARENT: prints exactly what it will install and what succeeded/failed.
#   - IDEMPOTENT: skips tools already present; re-runs are safe.
#   - NO SIGPIPE: all output captured to vars before any comparison.
#
# Called by:
#   - cmd_install_hooks (best-effort, auto): runs after hooks are wired.
#   - cmd_doctor --fix (explicit opt-in): runs then re-checks tool status.

ensure_discovery_tools() {
  local -a missing=()

  # Probe each of the five mandated tools with 'command -v' — never assume
  # any are present, never use them for the probe itself.
  local t
  for t in "${DISCOVERY_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || missing+=("$t")
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    info "Discovery tools: all present (bat rg fd sd eza) — nothing to install."
    return 0
  fi

  if command -v brew >/dev/null 2>&1; then
    echo "==> Discovery tools missing: ${missing[*]}"
    echo "    Installing via Homebrew (best-effort)..."
    local -a succeeded=()
    local -a failed=()
    local tool
    for tool in "${missing[@]}"; do
      if brew install "$tool"; then
        # Re-probe after install to confirm it landed on PATH.
        if command -v "$tool" >/dev/null 2>&1; then
          succeeded+=("$tool")
        else
          # brew reported success but binary still not on PATH (e.g. PATH not
          # refreshed, cask install, prefix mismatch). Treat as non-fatal warn.
          warn "brew install $tool reported success but '$tool' is still not on PATH. You may need to reload your shell or adjust PATH."
          failed+=("$tool")
        fi
      else
        warn "brew install $tool failed — skipping (non-fatal)."
        failed+=("$tool")
      fi
    done
    if [[ ${#succeeded[@]} -gt 0 ]]; then
      info "Installed: ${succeeded[*]}"
    fi
    if [[ ${#failed[@]} -gt 0 ]]; then
      warn "Could not install: ${failed[*]}"
      warn "Install them manually so agents do not hit the silent-empty footgun."
      warn "The skill-discovery-safety guard remains the fallback for any session."
    fi
  else
    # No brew — warn loudly about the silent-empty trap but stay non-fatal.
    warn "Homebrew not found. The following discovery tools are missing: ${missing[*]}"
    warn "Without them, agents that run e.g. 'fd ... 2>/dev/null' get an empty"
    warn "result (command not found, swallowed) and may misread it as zero skills."
    warn "Install manually — typical options:"
    warn "  cargo install bat ripgrep fd-find sd eza   (Rust/cargo — most reliable)"
    warn "  Debian/Ubuntu (apt): 'bat' installs as 'batcat', 'fd' as 'fd-find' (binary:"
    warn "    'fdfind'); 'sd' and 'eza' are often absent or only in recent repos —"
    warn "    prefer cargo or a newer apt source for those."
    warn "  Fedora/RHEL (dnf): bat ripgrep fd-find eza  (sd may need cargo)"
    warn "  Arch (pacman): bat ripgrep fd sd eza"
    warn "The skill-discovery-safety guard is the fallback but not a substitute."
  fi

  return 0  # always non-fatal
}

# ---------------------------------------------------------------------------
# recheck_discovery_tools
# ---------------------------------------------------------------------------
#
# Re-probes DISCOVERY_TOOLS after a provisioning attempt and prints
# PASS or WARN. Single source of truth — used by both branches of cmd_doctor
# --fix (fail!=0 and fail==0). Always returns 0 (non-fatal).

recheck_discovery_tools() {
  local -a recheck_missing=()
  local t
  for t in "${DISCOVERY_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || recheck_missing+=("$t")
  done
  if [[ ${#recheck_missing[@]} -eq 0 ]]; then
    echo "PASS  ${DISCOVERY_TOOLS[*]} all present after provisioning."
  else
    echo "WARN  still missing after provisioning: ${recheck_missing[*]}"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# install-hooks
# ---------------------------------------------------------------------------
#
# Design decisions:
#   1. SEPARATE from 'overlay apply'. Skills deployment and hook wiring are
#      distinct operations — apply only copies files, never mutates
#      ~/.claude/settings.json. This keeps apply non-invasive.
#   2. DELIBERATE activation. The user must run 'overlay install-hooks'
#      intentionally. This satisfies the "INERT until user activates" contract.
#   3. MISSING-BINARY SAFETY. Hook commands emitted by the engine use the form:
#        command -v <binary> &>/dev/null && <binary> ... || true
#      This ensures any hook exits 0 even when the binary is absent, so no
#      Claude Code Task is ever blocked by a missing binary.
#   4. ATOMIC+BACKUP inside the engine. The engine's merge-settings subcommand
#      writes to a temp file and renames; it also copies the original to
#      settings.json.bak before overwriting.

cmd_install_hooks() {
  command -v go >/dev/null 2>&1 || die "go is not installed; required to build the engine"
  command -v gentle-ai >/dev/null 2>&1 || warn "gentle-ai not found on PATH — the overlay layers onto gentle-ai; hooks will install but skill propagation/scoping may be inert until gentle-ai is installed. Run 'overlay doctor' for a full preflight."
  [[ -d "$ENGINE_SRC" ]] || die "engine source not found at $ENGINE_SRC"

  info "Building engine binary..."
  mkdir -p "$(dirname "$ENGINE_BINARY")"
  (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/) \
    || die "go build failed; binary not deployed"
  info "Engine binary deployed to: $ENGINE_BINARY"

  local settings_path="$HOME/.claude/settings.json"
  info "Merging hooks into: $settings_path"
  "$ENGINE_BINARY" merge-settings \
    --settings "$settings_path" \
    --hook-command "$ENGINE_BINARY" \
    || die "merge-settings failed"

  echo ""
  echo "install-hooks complete."
  echo "  binary  : $ENGINE_BINARY"
  echo "  settings: $settings_path (backup at ${settings_path}.bak)"
  echo "  hooks   : four hook pairs (minimalism-contract + skill-discovery-safety"
  echo "            + anti-generic-design + review-projection-contract) wired"
  echo "            into UserPromptSubmit and PreToolUse/Agent (eight entries total)."
  echo ""
  echo "Deterministic scoping is now ACTIVE for Claude Code sessions."
  echo ""
  echo "Run 'overlay doctor' to verify the full installation."

  # Guard: if the standalone skill-discovery-safety.md has not been deployed yet
  # (user ran install-hooks but not 'overlay apply'), warn loudly so the safety
  # contract is not silently absent from the skill registry.
  local safety_path="$HOME/.claude/skills/_shared/skill-discovery-safety.md"
  if test -f "$safety_path"; then
    :
  else
    echo ""
    echo "WARNING: $safety_path not found."
    echo "  The safety contract is embedded in the engine binary and will propagate"
    echo "  via hooks, but the standalone copy has not been deployed yet."
    echo "  Run 'overlay apply' to deploy all skills, then 'overlay doctor' to verify."
  fi

  # Best-effort: provision discovery tools so agents don't hit the silent-empty
  # footgun on a fresh install. Non-fatal — a failure here must never abort
  # install-hooks. The skill-discovery-safety guard is the fallback.
  # Set OVERLAY_SKIP_TOOL_INSTALL=1 to opt out (e.g. in CI or managed hosts).
  if [[ -n "${OVERLAY_SKIP_TOOL_INSTALL:-}" ]]; then
    info "OVERLAY_SKIP_TOOL_INSTALL is set — skipping automatic discovery-tool installation."
    warn "Discovery tools (bat rg fd sd eza) were NOT auto-installed."
    warn "Run 'overlay doctor --fix' later to provision them when ready."
  else
    echo ""
    echo "==> Installing host packages via Homebrew: discovery tools (bat rg fd sd eza)."
    echo "    Set OVERLAY_SKIP_TOOL_INSTALL=1 to skip this step."
    ensure_discovery_tools
  fi
}

# ---------------------------------------------------------------------------
# status-hooks
# ---------------------------------------------------------------------------
#
# Read-only health check for overlay install status:
#   - Engine binary present + executable at $ENGINE_BINARY
#   - Hooks wired in ~/.claude/settings.json (UserPromptSubmit + PreToolUse/Agent)
#   - Contract readable with valid frontmatter
#   - (best-effort) Scoped block present in CWD's .atl/skill-registry.md
#
# Exits 0 if all checks pass, 1 otherwise.
# Read-only by design: no binary builds/writes.

cmd_status_hooks() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    die "engine binary not found at $ENGINE_BINARY; run 'overlay install-hooks' first"
  fi

  exec "$ENGINE_BINARY" status
}

# ---------------------------------------------------------------------------
# uninstall-hooks
# ---------------------------------------------------------------------------

cmd_uninstall_hooks() {
  local settings_path="$HOME/.claude/settings.json"

  if [[ ! -f "$ENGINE_BINARY" ]]; then
    # Binary absent: fall back to a fresh build to run uninstall.
    # If we cannot build, error out — we cannot safely remove entries.
    command -v go >/dev/null 2>&1 || die "engine binary not found at $ENGINE_BINARY and go is not installed; cannot uninstall"
    [[ -d "$ENGINE_SRC" ]] || die "engine source not found at $ENGINE_SRC; cannot build for uninstall"
    info "Engine binary not found; building to perform uninstall..."
    mkdir -p "$(dirname "$ENGINE_BINARY")"
    (cd "$ENGINE_SRC" && go build -o "$ENGINE_BINARY" ./cmd/) \
      || die "go build failed; cannot uninstall hooks"
  fi

  info "Removing hooks from: $settings_path"
  "$ENGINE_BINARY" uninstall-hooks \
    --settings "$settings_path" \
    --hook-command "$ENGINE_BINARY" \
    || die "uninstall-hooks failed"

  echo ""
  echo "uninstall-hooks complete."
  echo "  Our eight hook entries (four pairs: minimalism-contract + skill-discovery-safety"
  echo "  + anti-generic-design + review-projection-contract)"
  echo "  have been removed from $settings_path"
  echo "  (backup at ${settings_path}.bak if the file was modified)"
  echo ""
  echo "Run 'overlay doctor' to verify the installation state."
}

# ---------------------------------------------------------------------------
# install-alias
# ---------------------------------------------------------------------------

cmd_install_alias() {
  local name="${1:-labdrian}"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$OVERLAY_DIR/bin/labdrian-overlay" "$HOME/.local/bin/$name"
  echo "Linked '$name' -> overlay. Run '$name tui' (needs ~/.local/bin on PATH)."
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
#
# Read-only host-toolchain preflight. Prints PASS / WARN / FAIL per check and
# exits non-zero only on a hard FAIL (missing REQUIRED tool or empty registry).
#
# Honors the three robustness principles:
#   - PORTABLE DISCOVERY: every tool is probed with 'command -v'; the registry
#     check uses only POSIX 'test'. Never calls fd/eza/bat directly.
#   - FAIL-LOUD: no bare '2>/dev/null' on discovery; command-not-found stays
#     visible. A missing required tool or an empty registry is a hard FAIL with
#     an actionable message.
#   - REGISTRY-AUTHORITATIVE: the registry file is the source of truth. An empty
#     or whitespace-only registry is reported as FAIL ("inconclusive, not zero
#     skills"), never silently passed.
#
# Classification:
#   FAIL  -> registry empty/whitespace-only or unreadable; go absent
#   WARN  -> registry absent; gentle-ai absent; engine binary absent; fd/eza/bat absent
#   PASS  -> check satisfied

cmd_doctor() {
  local fail=0
  local fix=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix) fix=1 ;;
      *) die "Unknown option: $1. Usage: overlay doctor [--fix]" ;;
    esac
    shift || true
  done

  echo "overlay doctor — host-toolchain preflight"
  echo ""

  # (a) REQUIRED: go on PATH (needed to build the engine binary).
  if command -v go >/dev/null 2>&1; then
    echo "PASS  go on PATH"
  else
    echo "FAIL  go not found on PATH — required to build the engine binary (run 'overlay install-hooks')."
    fail=1
  fi

  # (b) REQUIRED-with-context: gentle-ai on PATH. The overlay layers onto
  #     gentle-ai; absence is a loud WARN, not a hard FAIL (overlay can still
  #     install and run, but propagation/scoping may be inert).
  if command -v gentle-ai >/dev/null 2>&1; then
    echo "PASS  gentle-ai on PATH"
  else
    echo "WARN  gentle-ai not found on PATH — the overlay layers onto gentle-ai; skill propagation/scoping may be inert until it is installed."
  fi

  # (c) bat / rg / fd / sd / eza — the full set the persona rule mandates.
  #     Absence is a WARN, never a hard FAIL: the safety guard is the fallback.
  #     Run 'overlay doctor --fix' to auto-install via Homebrew when available.
  local missing_discovery=()
  local t
  for t in "${DISCOVERY_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 || missing_discovery+=("$t")
  done
  if [[ ${#missing_discovery[@]} -eq 0 ]]; then
    echo "PASS  bat/rg/fd/sd/eza on PATH"
  else
    echo "WARN  not found: ${missing_discovery[*]}. Without these tools agents that run"
    echo "      e.g. 'fd ... 2>/dev/null' get empty output (command not found, swallowed)"
    echo "      and may misread it as zero skills — the silent-empty footgun."
    echo "      Run 'overlay doctor --fix' to auto-install via Homebrew (if available)."
    echo "      Skill discovery MUST use the registry (.atl/skill-registry.md or engram),"
    echo "      never a bare filesystem scan. An empty result is INCONCLUSIVE, not zero skills."
  fi

  # (d) Engine binary present + executable. Absent is a WARN with a hint.
  if [[ -x "$ENGINE_BINARY" ]]; then
    echo "PASS  engine binary present at $ENGINE_BINARY"
  else
    echo "WARN  engine binary not found at $ENGINE_BINARY — run 'overlay install-hooks' to build and deploy it."
  fi

  # (e) REGISTRY-AUTHORITATIVE + FAIL-LOUD: registry present AND non-empty.
  #     Resolve under OVERLAY_DIR first, then CWD. A missing or empty/
  #     whitespace-only registry is a hard FAIL.
  local registry=""
  if [[ -f "$OVERLAY_DIR/.atl/skill-registry.md" ]]; then
    registry="$OVERLAY_DIR/.atl/skill-registry.md"
  elif [[ -f "$PWD/.atl/skill-registry.md" ]]; then
    registry="$PWD/.atl/skill-registry.md"
  fi

  if [[ -z "$registry" ]]; then
    echo "WARN  skill-registry.md not found under $OVERLAY_DIR/.atl or $PWD/.atl — project may not use the overlay. Run skill-registry to generate it; do NOT conclude skills are absent."
  elif [[ ! -s "$registry" ]]; then
    echo "FAIL  registry empty (zero bytes): $registry — run skill-registry; do NOT conclude skills are absent."
    fail=1
  else
    # Reject a whitespace-only file too. Capture content to a var (no pipe)
    # to avoid SIGPIPE under 'set -euo pipefail'.
    local registry_content
    registry_content="$(tr -d '[:space:]' < "$registry")"
    if [[ -z "$registry_content" ]]; then
      echo "FAIL  registry whitespace-only: $registry — run skill-registry; an empty scan is INCONCLUSIVE, not zero skills."
      fail=1
    else
      echo "PASS  registry present and non-empty: $registry"
    fi
  fi

  echo ""
  if [[ "$fail" -ne 0 ]]; then
    echo "doctor: FAIL — one or more required checks did not pass (see above)." >&2
    # Still run --fix provisioning if requested, then re-check tools, but exit 1 after.
    if [[ "$fix" -eq 1 ]]; then
      echo ""
      echo "==> --fix: attempting to provision discovery tools despite FAIL above..."
      ensure_discovery_tools
      echo ""
      echo "==> Re-checking discovery tools after provisioning..."
      recheck_discovery_tools
    fi
    exit 1
  fi
  echo "doctor: OK — required checks passed (review any WARN above)."

  # --fix: explicit opt-in to provision missing discovery tools, then re-check.
  if [[ "$fix" -eq 1 ]]; then
    echo ""
    echo "==> --fix: provisioning discovery tools (${DISCOVERY_TOOLS[*]})..."
    ensure_discovery_tools
    echo ""
    echo "==> Re-checking discovery tools after provisioning..."
    recheck_discovery_tools
  fi
}

# ---------------------------------------------------------------------------
# repair-sdd-registry
# ---------------------------------------------------------------------------
#
# Gentle's default skill-registry intentionally skips sdd-* phase skills because
# they are executor contracts, not normal user-invocable skills. Codex/Gentle SDD
# delegation still needs their exact paths. This command makes the registry
# durable after `gentle-ai sync` / `gentle-ai skill-registry refresh` by
# refreshing first, then re-inserting installed sdd-* rows with Scope=executor.

cmd_repair_sdd_registry() {
  local cwd="$CALLER_CWD"
  local target="codex"
  local refresh=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        shift
        cwd="${1:-}"
        [[ -n "$cwd" ]] || die "--cwd requires an argument"
        ;;
      --target)
        shift
        target="${1:-}"
        [[ -n "$target" ]] || die "--target requires an argument"
        [[ -v TARGET_PATHS["$target"] ]] || die "Unknown target: $target. Valid: claude, opencode, codex"
        ;;
      --no-refresh)
        refresh=0
        ;;
      *) die "Unknown option: $1. Usage: overlay repair-sdd-registry [--cwd DIR] [--target claude|opencode|codex] [--no-refresh]" ;;
    esac
    shift || true
  done

  [[ -d "$cwd" ]] || die "--cwd is not a directory: $cwd"

  if [[ "$refresh" -eq 1 ]]; then
    command -v gentle-ai >/dev/null 2>&1 || die "gentle-ai not found on PATH; use --no-refresh to repair an existing registry only"
    gentle-ai skill-registry refresh --cwd "$cwd" --force --quiet --no-gitignore
  fi

  repair_sdd_registry_file "$cwd/.atl/skill-registry.md" "$target"
}

# ---------------------------------------------------------------------------
# skill-registry refresh
# ---------------------------------------------------------------------------
#
# Wrapper around `gentle-ai skill-registry refresh` that applies the overlay's
# SDD executor repair immediately after the generated registry is refreshed.
# This prevents the known Gentle default skip of sdd-* phase skills from
# reappearing every time users refresh the registry through the overlay.

cmd_skill_registry() {
  local verb="${1:-}"
  [[ "$verb" == "refresh" ]] || die "Usage: overlay skill-registry refresh [--cwd DIR] [--target claude|opencode|codex] [--no-repair] [--force] [--quiet] [--no-gitignore]"
  shift || true

  local cwd="$CALLER_CWD"
  local target="codex"
  local repair=1
  local saw_no_gitignore=0
  local -a gentle_args=("skill-registry" "refresh")

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd)
        shift
        cwd="${1:-}"
        [[ -n "$cwd" ]] || die "--cwd requires an argument"
        gentle_args+=("--cwd" "$cwd")
        ;;
      --target)
        shift
        target="${1:-}"
        [[ -n "$target" ]] || die "--target requires an argument"
        [[ -v TARGET_PATHS["$target"] ]] || die "Unknown target: $target. Valid: claude, opencode, codex"
        ;;
      --no-repair)
        repair=0
        ;;
      --no-gitignore)
        saw_no_gitignore=1
        gentle_args+=("$1")
        ;;
      --force|--quiet)
        gentle_args+=("$1")
        ;;
      *) die "Unknown option: $1. Usage: overlay skill-registry refresh [--cwd DIR] [--target claude|opencode|codex] [--no-repair] [--force] [--quiet] [--no-gitignore]" ;;
    esac
    shift || true
  done

  [[ -d "$cwd" ]] || die "--cwd is not a directory: $cwd"
  [[ "$saw_no_gitignore" -eq 1 ]] || gentle_args+=("--no-gitignore")

  command -v gentle-ai >/dev/null 2>&1 || die "gentle-ai not found on PATH"
  gentle-ai "${gentle_args[@]}"

  if [[ "$repair" -eq 1 ]]; then
    repair_sdd_registry_file "$cwd/.atl/skill-registry.md" "$target"
  fi
}

# cmd_prespec forwards to the engine binary's `prespec` subcommand, passing
# stdin/stdout/args straight through. This is the user-facing entry point the
# prespec-malandra skill calls (e.g. `labdrian prespec lint`).
cmd_prespec() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    die "engine binary not found at $ENGINE_BINARY; run 'overlay install-hooks' first"
  fi
  exec "$ENGINE_BINARY" prespec "$@"
}

# cmd_skills forwards to the engine binary's `skills` subcommand.
# Injects default --registry and --manifest paths from $OVERLAY_DIR so that
# `labdrian skills list` / `labdrian skills validate` work from any cwd.
# Flags already supplied by the caller are never overridden.
cmd_skills() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    die "engine binary not found at $ENGINE_BINARY; run 'overlay install-hooks' first"
  fi

  local has_registry=0 has_manifest=0 has_source_root=0
  for arg in "$@"; do
    [[ "$arg" == "--registry" ]] && has_registry=1
    [[ "$arg" == "--manifest" ]] && has_manifest=1
    [[ "$arg" == "--source-root" ]] && has_source_root=1
  done

  local -a defaults=()
  [[ "$has_registry" -eq 0 ]] && defaults+=("--registry" "$OVERLAY_DIR/skills.registry.yaml")
  [[ "$has_manifest" -eq 0 ]] && defaults+=("--manifest" "$OVERLAY_DIR/overlay.manifest")
  [[ "$has_source_root" -eq 0 ]] && defaults+=("--source-root" "$OVERLAY_DIR/skills")

  # Verb-first: "$@" carries the verb (and any user flags); injected defaults go
  # AFTER it so the engine's positional verb extraction is not shadowed by a flag value.
  exec "$ENGINE_BINARY" skills "$@" "${defaults[@]}"
}

# ---------------------------------------------------------------------------
# validate-entry-contract
# ---------------------------------------------------------------------------

cmd_validate_entry_contract() {
  local validator_src="$OVERLAY_DIR/tools/entry-contract-validator"
  if [[ ! -f "$validator_src/go.mod" || ! -f "$validator_src/main.go" ]]; then
    echo "error: entry-contract validator source is unavailable under $validator_src" >&2
    return 3
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is required to build the entry-contract validator" >&2
    return 3
  fi

  local -a normalized_args=()
  local flag value
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --schema|--instance)
        flag="$1"
        shift
        if [[ $# -eq 0 ]]; then
          normalized_args+=("$flag")
          break
        fi
        value="$1"
        [[ "$value" == /* ]] || value="$CALLER_CWD/$value"
        normalized_args+=("$flag" "$value")
        ;;
      --schema=*|--instance=*)
        flag="${1%%=*}"
        value="${1#*=}"
        [[ "$value" == /* ]] || value="$CALLER_CWD/$value"
        normalized_args+=("$flag=$value")
        ;;
      *)
        normalized_args+=("$1")
        ;;
    esac
    shift
  done

  local validator_binary
  if ! validator_binary="$(mktemp "${TMPDIR:-/tmp}/entry-contract-validator.XXXXXX")"; then
    echo "error: could not allocate a temporary entry-contract validator binary" >&2
    return 3
  fi
  rm -f "$validator_binary"

  if ! (cd "$validator_src" && go build -o "$validator_binary" .); then
    rm -f "$validator_binary"
    echo "error: could not build the entry-contract validator" >&2
    return 3
  fi

  local status=0
  "$validator_binary" "${normalized_args[@]}" || status=$?
  rm -f "$validator_binary"
  return "$status"
}

# ---------------------------------------------------------------------------
# deterministic-checks
# ---------------------------------------------------------------------------

cmd_deterministic_checks() {
  local runner_src="$OVERLAY_DIR/tools/deterministic-check-runner"
  if [[ ! -f "$runner_src/go.mod" || ! -f "$runner_src/main.go" ]]; then
    echo "error: deterministic-check-runner source is unavailable under $runner_src" >&2
    return 3
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is required to build the deterministic-check-runner" >&2
    return 3
  fi

  local runner_binary
  if ! runner_binary="$(mktemp "${TMPDIR:-/tmp}/deterministic-check-runner.XXXXXX")"; then
    echo "error: could not allocate a temporary deterministic-check-runner binary" >&2
    return 3
  fi
  rm -f "$runner_binary"

  if ! (cd "$runner_src" && go build -o "$runner_binary" .); then
    rm -f "$runner_binary"
    echo "error: could not build the deterministic-check-runner" >&2
    return 3
  fi

  local status=0
  (cd "$CALLER_CWD" && "$runner_binary" "$@") || status=$?
  if [[ "$status" -ne 0 && ! -d "$CALLER_CWD" ]]; then
    status=3
  fi
  rm -f "$runner_binary"
  return "$status"
}

# ---------------------------------------------------------------------------
# review-preflight
# ---------------------------------------------------------------------------

# Same shape as cmd_deterministic_checks above, deliberately: every failure to
# reach the guard is exit 3 ("could not determine"), never exit 0, so a missing
# source tree or a missing toolchain can never be read as "a review here is
# safe". The guard's own exit code is propagated verbatim - the wrapper never
# re-derives it, exactly as skills/sdd-verify/SKILL.md requires of the sibling
# runner.
cmd_review_preflight() {
  local guard_src="$OVERLAY_DIR/tools/review-preflight"
  if [[ ! -f "$guard_src/go.mod" || ! -f "$guard_src/main.go" ]]; then
    echo "error: review-preflight source is unavailable under $guard_src" >&2
    return 3
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "error: go is required to build the review-preflight guard" >&2
    return 3
  fi

  local guard_binary
  if ! guard_binary="$(mktemp "${TMPDIR:-/tmp}/review-preflight.XXXXXX")"; then
    echo "error: could not allocate a temporary review-preflight binary" >&2
    return 3
  fi
  rm -f "$guard_binary"

  if ! (cd "$guard_src" && go build -o "$guard_binary" .); then
    rm -f "$guard_binary"
    echo "error: could not build the review-preflight guard" >&2
    return 3
  fi

  local status=0
  (cd "$CALLER_CWD" && "$guard_binary" "$@") || status=$?
  # A CALLER_CWD that no longer exists makes the subshell's own `cd` fail with
  # exit 1, which for this guard would read as "EMPTY candidate" - a verdict
  # about a projection that was never observed. Remap that one case to 3.
  if [[ "$status" -ne 0 && ! -d "$CALLER_CWD" ]]; then
    status=3
  fi
  rm -f "$guard_binary"
  return "$status"
}

# ---------------------------------------------------------------------------
# gadu-generate
# ---------------------------------------------------------------------------

cmd_gadu_generate() {
  if [[ ! -x "$ENGINE_BINARY" ]]; then
    die "engine binary not found at $ENGINE_BINARY; run 'overlay install-hooks' first"
  fi
  exec env OVERLAY_DIR="$OVERLAY_DIR" "$ENGINE_BINARY" gadu-generate "$@"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
  bootstrap)       cmd_bootstrap "$@" ;;
  capture)         cmd_capture "$@" ;;
  apply)           cmd_apply "$@" ;;
  self-update)     cmd_self_update "$@" ;;
  status)          cmd_status "$@" ;;
  sync-check)      cmd_sync_check "$@" ;;
  install-hooks)   cmd_install_hooks "$@" ;;
  uninstall-hooks) cmd_uninstall_hooks "$@" ;;
  status-hooks)    cmd_status_hooks "$@" ;;
  doctor)          cmd_doctor "$@" ;;
  repair-sdd-registry) cmd_repair_sdd_registry "$@" ;;
  skill-registry)  cmd_skill_registry "$@" ;;
  tui)             cmd_tui "$@" ;;
  install-alias)   cmd_install_alias "$@" ;;
  prespec)         cmd_prespec "$@" ;;
  skills)          cmd_skills "$@" ;;
  validate-entry-contract) cmd_validate_entry_contract "$@" ;;
  deterministic-checks) cmd_deterministic_checks "$@" ;;
  review-preflight) cmd_review_preflight "$@" ;;
  gadu-generate)   cmd_gadu_generate "$@" ;;
  --help|-h)       usage; exit 0 ;;
  "")              usage >&2; exit 1 ;;
  *)               die "Unknown command: $COMMAND" ;;
esac
