# a commondir that names a directory that does not exist: the workflow records worktree_root="<CHECKOUT>" git_head=<40 of e>
$ workflow bind --project proj-1 --workflow wf-1
# a commondir that names a directory that does not exist: bind (in <CHECKOUT>)
--- exit ---
0
--- stdout ---
{
  "classification": "owned",
  "binding": {
    "version": 1,
    "repo_key": "<KEY of the path as written>",
    "project_id": "proj-1",
    "workflow_id": "wf-1",
    "bound_at": "<TIME>"
  }
}
--- stderr ---

$ workflow binding
