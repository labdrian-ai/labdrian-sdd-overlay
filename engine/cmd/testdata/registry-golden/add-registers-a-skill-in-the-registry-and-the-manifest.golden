# a custom skill
$ skills add gamma --source-root <WORLD>/skills
exit: 0
--- stdout ---
added: gamma
--- stderr ---

# an external skill, with its repository and its ref
$ skills add delta --repo https://example.test/org/delta --ref v2.0.1 --source-root <WORLD>/skills
exit: 0
--- stdout ---
added: delta
--- stderr ---

# an external skill with no ref
$ skills add epsilon --repo https://example.test/org/epsilon --source-root <WORLD>/skills
exit: 0
--- stdout ---
added: epsilon
--- stderr ---

# what the three left, the registry written in the one form the program writes
--- skills.registry.yaml ---
version: "1"
skills:
  - id: beta
    path: beta
    source:
      type: core
      upstream:
        owner: gentleman-programming
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
        - pi
    lifecycle:
      updateStrategy: vendor-merge
  - id: alpha
    path: alpha
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
    lifecycle:
      updateStrategy: overlay-only
  - id: ext-one
    path: ext-one
    source:
      type: external
      repo: https://example.test/org/ext-one
      ref: v1.2.0
    install:
      defaultScope: global
      targets:
        - claude
    lifecycle:
      updateStrategy: overlay-only
  - id: tidy-notes
    path: tidy-notes
    source:
      type: custom
    install:
      defaultScope: project
      targets:
        - claude
        - pi
      allowedProjects:
        - demo
        - other
    lifecycle:
      updateStrategy: overlay-only
  - id: gamma
    path: gamma
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
    lifecycle:
      updateStrategy: overlay-only
  - id: delta
    path: delta
    source:
      type: external
      repo: https://example.test/org/delta
      ref: v2.0.1
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
    lifecycle:
      updateStrategy: overlay-only
  - id: epsilon
    path: epsilon
    source:
      type: external
      repo: https://example.test/org/epsilon
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
    lifecycle:
      updateStrategy: overlay-only

--- overlay.manifest ---
# the overlay manifest
engine/go.mod managed
alpha/SKILL.md custom
beta/SKILL.md managed
ext-one/SKILL.md custom
tidy-notes/SKILL.md custom
gamma/SKILL.md custom
delta/SKILL.md custom
epsilon/SKILL.md custom

