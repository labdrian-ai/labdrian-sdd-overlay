# a registry that is not there
$ skills validate --registry <WORLD>/refused/a.yaml --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
error: reading registry "<WORLD>/refused/a.yaml": open <WORLD>/refused/a.yaml: no such file or directory

# a registry with a line the reader does not understand
$ skills validate --registry <WORLD>/refused/b.yaml --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
error: parsing registry: line 7: unknown key "mirror" in source

# a registry of a version it does not know
$ skills validate --registry <WORLD>/refused/c.yaml --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
error: parsing registry: skills: version "3" is not supported; only version "1" is valid

# a registry with a value outside its vocabulary
$ skills validate --registry <WORLD>/refused/d.yaml --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
error: parsing registry: skills: entry "alpha": install.targets contains invalid value "vim"; must be one of: claude, opencode, codex, pi

