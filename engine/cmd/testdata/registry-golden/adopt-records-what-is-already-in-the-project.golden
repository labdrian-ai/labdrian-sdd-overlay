$ skills install --registry <WORLD>/overlay/skills.registry.yaml --source-root <WORLD>/overlay/skills (in demo)
exit: 0
--- stdout ---
installed: tidy-notes
installed: only-demo
--- stderr ---

# a project whose lock is gone, with the files in place
$ skills adopt --registry <WORLD>/overlay/skills.registry.yaml --source-root <WORLD>/overlay/skills (in demo)
exit: 0
--- stdout ---
adopted: tidy-notes
adopted: only-demo
--- stderr ---

--- demo/.labdrian/procedural-skills.lock.json ---
{
  "version": 1,
  "skills": [],
  "installs": [
    {
      "id": "only-demo",
      "files": [
        {
          "path": "SKILL.md",
          "sha256": "a4d04cee6b49e8528a3f6a07f44a46e507f3bcedf89525cfbaed2a085276b879"
        }
      ]
    },
    {
      "id": "tidy-notes",
      "files": [
        {
          "path": "SKILL.md",
          "sha256": "46b5a07e78bd689a52161c9913b50f29efb56aa749f3e90f3d43397e511d0869"
        },
        {
          "path": "references/notes.md",
