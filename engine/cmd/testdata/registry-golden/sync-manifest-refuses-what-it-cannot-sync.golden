# a manifest that is not there
$ skills sync-manifest --manifest <WORLD>/none.manifest
exit: 1
--- stdout ---
--- stderr ---
error: reading manifest "<WORLD>/none.manifest": open <WORLD>/none.manifest: no such file or directory

# a registry that is not there
$ skills sync-manifest --registry <WORLD>/refused/a.yaml --manifest <WORLD>/overlay.manifest
exit: 1
--- stdout ---
--- stderr ---
error: skills sync-manifest: reading registry "<WORLD>/refused/a.yaml": stat <WORLD>/refused/a.yaml: no such file or directory; nothing was locked and nothing was changed

# a registry with a key the reader does not know
$ skills sync-manifest --registry <WORLD>/refused/b.yaml --manifest <WORLD>/overlay.manifest
exit: 0
--- stdout ---
sync-manifest: 0 added, 3 dropped, 0 retagged
--- stderr ---
warning: registry fields left unread: line 7: unknown key "mirror" in source

# a registry of a version it does not know
$ skills sync-manifest --registry <WORLD>/refused/c.yaml --manifest <WORLD>/overlay.manifest
exit: 1
--- stdout ---
--- stderr ---
error: parsing registry: skills: version "3" is not supported; only version "1" is valid

# a registry with a value outside its vocabulary
$ skills sync-manifest --registry <WORLD>/refused/d.yaml --manifest <WORLD>/overlay.manifest
exit: 1
--- stdout ---
--- stderr ---
error: parsing registry: skills: entry "alpha": install.targets contains invalid value "vim"; must be one of: claude, opencode, codex, pi

--- overlay.manifest ---
# the overlay manifest
engine/go.mod managed
alpha/SKILL.md custom

