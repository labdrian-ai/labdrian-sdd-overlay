# a registry that is not there
$ skills add gamma --registry <WORLD>/refused/a.yaml --manifest <WORLD>/overlay.manifest --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
error: skills add: reading registry "<WORLD>/refused/a.yaml": stat <WORLD>/refused/a.yaml: no such file or directory; nothing was locked and nothing was changed

# a registry with a key the reader does not know
$ skills add gamma --registry <WORLD>/refused/b.yaml --manifest <WORLD>/overlay.manifest --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
warning: registry fields left unread: line 7: unknown key "mirror" in source
error: skills: the registry has fields this program does not read, and rewriting it would drop them: line 7: unknown key "mirror" in source

# a registry of a version it does not know
$ skills add gamma --registry <WORLD>/refused/c.yaml --manifest <WORLD>/overlay.manifest --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
error: parsing registry: skills: version "3" is not supported; only version "1" is valid

# a registry with a value outside its vocabulary
$ skills add gamma --registry <WORLD>/refused/d.yaml --manifest <WORLD>/overlay.manifest --source-root <WORLD>/skills
exit: 1
--- stdout ---
--- stderr ---
error: parsing registry: skills: entry "alpha": install.targets contains invalid value "vim"; must be one of: claude, opencode, codex, pi

