# install over a directory it did not install names the id it would adopt under
$ skills install --registry <WORLD>/overlay/skills.registry.yaml --source-root <WORLD>/overlay/skills (in demo)
exit: 0
--- stdout ---
installed: by-origin
--- stderr ---

# adopt of a skill that is in one runtime only notes where it is not, under the id
$ skills adopt --registry <WORLD>/overlay/skills.registry.yaml --source-root <WORLD>/overlay/skills (in demo)
exit: 0
--- stdout ---
unchanged: by-origin
--- stderr ---

