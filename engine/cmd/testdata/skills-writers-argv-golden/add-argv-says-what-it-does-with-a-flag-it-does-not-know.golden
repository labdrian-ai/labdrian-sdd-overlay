# an unknown flag before the id
$ skills add --frobnicate foo
exit: 0
--- stdout ---
added: foo
--- stderr ---

--- skills.registry.yaml ---
version: "1"
skills:
  - id: alpha
    path: alpha
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
    lifecycle:
      updateStrategy: overlay-only
  - id: foo
    path: foo
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
    lifecycle:
      updateStrategy: overlay-only

# an unknown flag after the id
$ skills add foo --frobnicate
exit: 0
--- stdout ---
added: foo
--- stderr ---

--- skills.registry.yaml ---
version: "1"
skills:
  - id: alpha
    path: alpha
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
    lifecycle:
      updateStrategy: overlay-only
  - id: foo
    path: foo
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
    lifecycle:
      updateStrategy: overlay-only

# a short flag before the id
$ skills add -v foo
exit: 1
--- stdout ---
--- stderr ---
error: id "-v": invalid slug (must match ^[a-z0-9][a-z0-9-]*$)

# a short flag after the id
$ skills add foo -v
exit: 0
--- stdout ---
added: foo
--- stderr ---

--- skills.registry.yaml ---
version: "1"
skills:
  - id: alpha
    path: alpha
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
    lifecycle:
      updateStrategy: overlay-only
  - id: foo
    path: foo
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
    lifecycle:
      updateStrategy: overlay-only

# the equals form of a flag it reads
$ skills add --registry=<WORLD>/skills.registry.yaml foo
exit: 0
--- stdout ---
added: foo
--- stderr ---

--- skills.registry.yaml ---
version: "1"
skills:
  - id: alpha
    path: alpha
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
    lifecycle:
      updateStrategy: overlay-only
  - id: foo
    path: foo
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
        - opencode
        - codex
    lifecycle:
      updateStrategy: overlay-only

# a flag of install
$ skills add --project-id p foo
exit: 1
--- stdout ---
--- stderr ---
error: skill "p": SKILL.md not found at "skills/p/SKILL.md": stat skills/p/SKILL.md: no such file or directory

--- skills.registry.yaml ---
version: "1"
skills:
  - id: alpha
    path: alpha
    source:
      type: custom
    install:
      defaultScope: global
      targets:
        - claude
    lifecycle:
      updateStrategy: overlay-only

# an unknown flag and no id
$ skills add --frobnicate
exit: 1
--- stdout ---
--- stderr ---
error: skills add requires an <id> argument

