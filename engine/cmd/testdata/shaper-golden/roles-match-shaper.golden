{
  "handoff_version": 3,
  "matches": [
    {
      "role": "implementer",
      "responsibility": "Writes the code.",
      "matches_vocabulary": false
    },
    {
      "role": "reviewer",
      "responsibility": "Reviews the diff.",
      "matches_vocabulary": true
    }
  ],
  "authority": "Role data carries no execution authority; no roles command launches an agent or dispatches work."
}
--- stderr ---


