# install claude
$ runtime install --target claude
exit: 0
--- stdout ---
[claude] install: restart_required — Claude lifecycle hooks installed; restart Claude to load hook changes
--- stderr ---

# the complete install
$ runtime status --target claude
exit: 0
--- stdout ---
[claude] status: supported — Claude lifecycle hooks are installed and owned
--- stderr ---

# no SessionEnd entry
$ runtime status --target claude
exit: 1
--- stdout ---
[claude] status: partial — Claude lifecycle hooks are not fully owned/installed in <WORLD>/home/.claude/settings.json; run 'labdrian uninstall-hooks' then 'labdrian install-hooks'
--- stderr ---

