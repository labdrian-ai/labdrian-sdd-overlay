# a registry and a manifest in other directories
$ skills add --source-root <WORLD>/skills --registry <WORLD>/registries/other.yaml --manifest <WORLD>/manifests/other.manifest foo
exit: 0
--- stdout ---
added: foo
--- stderr ---

--- state of registries ---
.other.yaml.lock mask 0 e3b0c44298fc
other.yaml 0600 418 cc13be4b39bb

--- state of manifests ---
other.manifest 0600 42 a77145c1e8f8

# relative paths, from the directory the program runs in
$ skills remove --registry other.yaml --manifest ../manifests/other.manifest foo (in registries)
exit: 0
--- stdout ---
removed: foo
--- stderr ---

--- state of registries ---
.other.yaml.lock mask 0 e3b0c44298fc
other.yaml 0600 204 f4f6d939ffdf

--- state of manifests ---
other.manifest 0600 22 602f4f6fe352

# a manifest that does not exist
$ skills add --source-root <WORLD>/skills --manifest <WORLD>/missing.manifest foo
exit: 1
--- stdout ---
--- stderr ---
error: reading manifest "<WORLD>/missing.manifest": open <WORLD>/missing.manifest: no such file or directory

# a manifest that is a directory
$ skills add --source-root <WORLD>/skills --manifest <WORLD>/a-directory.manifest foo
exit: 1
--- stdout ---
--- stderr ---
error: reading manifest "<WORLD>/a-directory.manifest": read <WORLD>/a-directory.manifest: is a directory

