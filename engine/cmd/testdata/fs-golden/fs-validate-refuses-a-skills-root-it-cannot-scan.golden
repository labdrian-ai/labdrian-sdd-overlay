# a root that does not exist
$ skills validate --source-root <WORLD>/missing
exit: 1
--- stdout ---
--- stderr ---
error: scanning skills directory "<WORLD>/missing": ondisk: stat skills dir <WORLD>/missing: stat <WORLD>/missing: no such file or directory

# a root that is a file
$ skills validate --source-root <WORLD>/a-file
exit: 1
--- stdout ---
--- stderr ---
error: scanning skills directory "<WORLD>/a-file": ondisk: <WORLD>/a-file is not a directory

# a root that is an empty directory
$ skills validate --source-root <WORLD>/empty
exit: 1
