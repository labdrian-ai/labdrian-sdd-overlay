# no registry in the working directory
$ skills status
exit: 1
--- stdout ---
--- stderr ---
error: reading registry "skills.registry.yaml": open skills.registry.yaml: no such file or directory

# a registry that is not there
$ skills status --registry <WORLD>/absent.yaml
exit: 1
--- stdout ---
--- stderr ---
error: reading registry "<WORLD>/absent.yaml": open <WORLD>/absent.yaml: no such file or directory

