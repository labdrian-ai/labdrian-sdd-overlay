# a word after the verb
$ skills list extra
exit: 0
--- stdout ---
alpha	custom	overlay-only	claude,opencode
beta	core	vendor-merge	claude,opencode,codex,pi
ext-one	external	overlay-only	claude
tidy-notes	custom	overlay-only	claude,pi
--- stderr ---

# two words
$ skills list extra more
exit: 0
--- stdout ---
alpha	custom	overlay-only	claude,opencode
beta	core	vendor-merge	claude,opencode,codex,pi
ext-one	external	overlay-only	claude
tidy-notes	custom	overlay-only	claude,pi
--- stderr ---

# a word after the registry
$ skills list --registry <WORLD>/skills.registry.yaml extra
exit: 0
--- stdout ---
alpha	custom	overlay-only	claude,opencode
beta	core	vendor-merge	claude,opencode,codex,pi
ext-one	external	overlay-only	claude
tidy-notes	custom	overlay-only	claude,pi
--- stderr ---

