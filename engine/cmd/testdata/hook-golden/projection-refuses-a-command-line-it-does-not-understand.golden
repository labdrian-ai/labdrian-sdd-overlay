$ projection 
# no action at all
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection requires an action: hook

$ projection --event UserPromptSubmit
# an event flag with no action
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection requires an action: hook

$ projection status
# an action that is not hook
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection: unknown action "status" (expected hook)

$ projection hook
# the action with no event
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection hook: --event is required (supported: UserPromptSubmit, PreToolUse)

$ projection hook --event
# an event flag with no value
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection hook: --event requires a value

$ projection hook --event Stop
# an event the hook does not handle
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection hook: unsupported --event "Stop" (supported: UserPromptSubmit, PreToolUse)

$ projection hook --event userpromptsubmit
# an event written in lower case
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection hook: unsupported --event "userpromptsubmit" (supported: UserPromptSubmit, PreToolUse)

$ projection hook --bogus
# a flag the hook does not know
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection hook: unknown flag "--bogus"

$ projection hook extra
# a word after the action
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection hook: unexpected argument "extra"

$ projection hook --event UserPromptSubmit extra
# a word after the event
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"UserPromptSubmit","prompt":"a prompt"}
--- exit ---
1
--- stdout ---
--- stderr ---
error: projection hook: unexpected argument "extra"

$ projection hook --event UserPromptSubmit --event PreToolUse
# the last of a repeated event flag decides
--- stdin ---
{"session_id":"s1","transcript_path":"/t.jsonl","cwd":"<REPO>","permission_mode":"default","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{},"tool_use_id":"toolu_01"}
