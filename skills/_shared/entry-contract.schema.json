{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdrian.ai/schemas/pre-sdd-entry-contract/2.0.0",
  "title": "Pre-SDD Entry Contract v2",
  "description": "Closed, versioned handoff from inception-pipeline to the native SDD dispatcher. Artifact references identify persisted records without embedding their content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "change_name",
    "project",
    "tier",
    "interaction_mode",
    "artifact_store_mode",
    "artifact_refs",
    "estimate",
    "requested_pr_strategy",
    "delivery_strategy",
    "chaining_required",
    "chain_strategy",
    "review_budget",
    "strict_tdd",
    "review_slices",
    "expected_native_next_recommendation"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0",
      "description": "Must match the inception-pipeline, shared authority, schemas, and deterministic validator bundle version."
    },
    "change_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable kebab-case slug derived once by requirements-from-transcripts."
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Stable project identifier used in artifact references."
    },
    "tier": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "Evidence-selected inception tier."
    },
    "interaction_mode": {
      "type": "string",
      "enum": ["interactive", "auto"],
      "description": "Whether required human decisions may be requested interactively or must use already-authorized defaults."
    },
    "artifact_store_mode": {
      "type": "string",
      "enum": ["engram", "openspec", "hybrid", "none"],
      "description": "Persistence mode selected for this change. OpenSpec paths are truthful references only, never synthetic placeholders."
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "requirements",
        "manifest",
        "architecture",
        "roadmap",
        "estimate",
        "sdd_init",
        "pipeline_state",
        "delivery"
      ],
      "properties": {
        "entry": { "$ref": "#/$defs/artifact_ref" },
        "requirements": { "$ref": "#/$defs/artifact_ref" },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "mission", "rules"],
          "properties": {
            "context": { "$ref": "#/$defs/artifact_ref" },
            "mission": { "$ref": "#/$defs/artifact_ref" },
            "rules": { "$ref": "#/$defs/artifact_ref" }
          }
        },
        "architecture": { "$ref": "#/$defs/artifact_ref" },
        "roadmap": { "$ref": "#/$defs/artifact_ref" },
        "estimate": { "$ref": "#/$defs/artifact_ref" },
        "sdd_init": { "$ref": "#/$defs/artifact_ref" },
        "pipeline_state": { "$ref": "#/$defs/artifact_ref" },
        "delivery": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_range_hours",
        "complexity",
        "confidence",
        "human_review_included"
      ],
      "properties": {
        "planned_range_hours": { "$ref": "#/$defs/nonnegative_number_range" },
        "complexity": {
          "type": "string",
          "enum": ["low", "medium", "high", "very-high"]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "human_review_included": {
          "const": true,
          "description": "The planned range includes human review and gate effort."
        }
      }
    },
    "requested_pr_strategy": {
      "type": "string",
      "enum": ["auto", "force-single", "force-chained"],
      "description": "Caller intent before review-budget normalization."
    },
    "delivery_strategy": {
      "type": "string",
      "enum": ["single-pr", "auto-chain", "exception-ok"],
      "description": "Resolved delivery strategy forwarded to implementation and review."
    },
    "chaining_required": {
      "type": "boolean"
    },
    "chain_strategy": {
      "type": "string",
      "enum": ["none", "feature-branch-chain", "stacked-pr-chain"],
      "description": "Concrete topology when chaining is required; none otherwise."
    },
    "review_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_changed_lines_per_slice",
        "counting_method",
        "size_exception"
      ],
      "properties": {
        "max_changed_lines_per_slice": {
          "type": "integer",
          "minimum": 1
        },
        "counting_method": {
          "const": "authored-additions-and-deletions"
        },
        "size_exception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["not-needed", "approved"]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "approved_by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "strict_tdd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "test_commands"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "test_commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focused", "broad"],
          "properties": {
            "focused": { "$ref": "#/$defs/command_list" },
            "broad": { "$ref": "#/$defs/command_list" }
          }
        }
      }
    },
    "review_slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "id",
          "title",
          "requirements",
          "dependencies",
          "estimated_changed_lines"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^R-[0-9]{3,}$"
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "estimated_changed_lines": { "$ref": "#/$defs/nonnegative_integer_range" }
        }
      }
    },
    "expected_native_next_recommendation": {
      "type": "string",
      "enum": ["sdd-new", "sdd-explore", "sdd-propose", "sdd-spec", "sdd-design", "sdd-tasks", "sdd-apply", "sdd-verify", "sdd-archive"],
      "description": "Expected nextRecommended value from the native dispatcher immediately after the validated handoff is persisted."
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_key"],
      "properties": {
        "topic_key": {
          "type": "string",
          "minLength": 1
        },
        "openspec_path": {
          "type": "string",
          "pattern": "^openspec/",
          "description": "Normalized repository-relative path. Omit unless the artifact really exists in OpenSpec."
        }
      }
    },
    "nonnegative_number_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      }
    },
    "nonnegative_integer_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 }
      }
    },
    "command_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
