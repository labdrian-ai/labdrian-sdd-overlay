            "findings": [
              {
                "id": "R3-staged-recovery-gap",
                "lens": "reliability",
                "location": "openspec/changes/procedural-memory-lifecycle/design.md:229",
                "severity": "WARNING",
                "claim": "The rewritten recovery rule says the new SKILL.md files are 'always untracked' and restores the lock with `git restore --source=HEAD -- \u003clock path\u003e`, which restores only the worktree. The window 'after step 6 and before the commit' includes the time after `git add -- \u003cwrote paths\u003e`. At that point the SKILL.md files show as staged additions, not `??`. The crash-window deletion rule only accepts `??` paths, so it refuses them. The lock restore also leaves the new lock bytes staged in the index, and a later commit could pick up a partial registration. The rule needs `--staged --worktree` for the lock, like the revision path, plus an explicit unstage step for staged new files.",
                "proof_refs": [
                  "openspec/changes/procedural-memory-lifecycle/design.md:229",
                  "openspec/changes/procedural-memory-lifecycle/design.md:145",
                  "openspec/changes/procedural-memory-lifecycle/tasks.md:98"
                ],
                "evidence_class": "inferential",
                "causal_disposition": "introduced"
              },
              {
                "id": "R3-lock-restore-untested",
                "lens": "reliability",
                "location": "openspec/changes/procedural-memory-lifecycle/design.md:144",
                "severity": "WARNING",
                "claim": "Engine rollback now has a separate branch: it restores a lock file that already existed and carries other skills' entries from its backup bytes, instead of removing it. No changed task adds a RED case for this. The rollback tests added in 3b.5a and 7a.1 cover rollback-of-rollback and retirement, not a second registration over an existing multi-entry lock. So nothing proves that a failed second registration keeps the prior skills' lock entries byte-identical.",
                "proof_refs": [
                  "openspec/changes/procedural-memory-lifecycle/design.md:144",
                  "openspec/changes/procedural-memory-lifecycle/tasks.md:83",
                  "openspec/changes/procedural-memory-lifecycle/tasks.md:12"
                ],
                "evidence_class": "inferential",
                "causal_disposition": "introduced"
              },
              {
                "id": "R3-promoted-retire-contradiction",
                "lens": "reliability",
                "location": "openspec/changes/procedural-memory-lifecycle/design.md:254",
                "severity": "WARNING",
                "claim": "The new post-promotion `project-retire --reason promoted` path ends with Status still at `promoted`. That contradicts the unchanged design statement that every project-tier procedure ends at `registered` or `retired`. The new registration-spec scenario (Status stays `promoted`, History gets a `promoted -\u003e promoted` line) has no matching test or acceptance-checklist item: the updated 7a.1 covers only ordinary retirement and rollback. This leaves open whether the contract procedure wrongly writes `retired`.",
                "proof_refs": [
                  "openspec/changes/procedural-memory-lifecycle/design.md:254",
                  "openspec/changes/procedural-memory-lifecycle/specs/procedural-skill-registration/spec.md:200-208",
                  "openspec/changes/procedural-memory-lifecycle/tasks.md:125"
                ],
                "evidence_class": "inferential",
                "causal_disposition": "introduced"
              },
              {
                "id": "R3-exit-code-level",
                "lens": "reliability",
                "location": "openspec/changes/procedural-memory-lifecycle/tasks.md:83",
                "severity": "SUGGESTION",
                "claim": "Task 3b.5a asserts 'exits 1' from a test in the engine-level ExecuteProjectPlan test file, but that function returns an error and writes to stderr. It does not own the process exit code. Either assert the returned error plus the stderr line at this level, or add the exit-code assertion to the CLI test. Otherwise the stated observable is not directly checkable at the test level the task names.",
                "proof_refs": [
                  "openspec/changes/procedural-memory-lifecycle/tasks.md:83",
                  "openspec/changes/procedural-memory-lifecycle/tasks.md:82"
                ]
              },
              {
                "id": "R3-lintskillfile-coverage",
                "lens": "reliability",
                "location": "openspec/changes/procedural-memory-lifecycle/specs/skill-lint/spec.md:87-102",
                "severity": "SUGGESTION",
                "claim": "The missing-fence scenario moved from LintSkill to a new LintSkillFile requirement, but none of the changed task lines adds a RED test for it. If the existing task list still maps the old LintSkill fence scenario, that test would now contradict the spec, and the new LintSkillFile scenario (split failure surfaced as a hard error, LintSkill not called) would go unproved. Re-map the task explicitly.",
                "proof_refs": [
                  "openspec/changes/procedural-memory-lifecycle/specs/skill-lint/spec.md:39-45",
                  "openspec/changes/procedural-memory-lifecycle/specs/skill-lint/spec.md:87-102"
                ]
              }
            ],
