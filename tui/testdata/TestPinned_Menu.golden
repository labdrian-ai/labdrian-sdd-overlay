Name="Memoria: estado" Command="longterm-mem" Args=["status"]
  Mutating=false SupportsAll=true TargetAgnostic=false CopyTargetsOnly=false
  Hint="Registro MCP de longterm-mem por runtime"
  ConfirmMessage=""
Name="Memoria: instalar" Command="longterm-mem" Args=["install"]
  Mutating=true SupportsAll=true TargetAgnostic=false CopyTargetsOnly=false
  Hint="Compila, despliega y registra el MCP en cada runtime"
  ConfirmMessage="Compila el binario de longterm-mem, lo despliega en el directorio de estado del overlay\ny escribe una entrada MCP con marca de propiedad en la configuración propia de cada\nruntime seleccionado (Claude Code, opencode, codex). Antes de modificar cualquier\nconfiguración se escribe un respaldo .bak junto al archivo."
Name="Memoria: desinstalar" Command="longterm-mem" Args=["uninstall"]
  Mutating=true SupportsAll=true TargetAgnostic=false CopyTargetsOnly=false
  Hint="Quita la entrada MCP propia de cada runtime"
  ConfirmMessage="Elimina únicamente la entrada MCP con marca de propiedad de cada runtime seleccionado.\nUna entrada que longterm-mem no posee se deja intacta y se reporta como no gestionada.\nEl binario compartido sobrevive a una desinstalación parcial: solo se elimina al\ndesinstalar todos los runtimes, o con --purge desde la CLI (no disponible aquí)."
