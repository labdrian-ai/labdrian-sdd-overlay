            "index_stale_detail": {
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      },
      {
        "description": "Search a project's Engram observations and vault pages, merged by source and never re-ranked (D8).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string",
              "description": "the project to search"
            },
            "query": {
              "type": "string",
              "description": "the query text"
            },
            "top": {
              "type": "integer",
              "description": "results per source (default 5 when omitted or 0)"
            },
            "exclude_types": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "Engram observation types to leave out, e.g. session_summary (default: none excluded)"
            },
            "sources": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "sources to query: engram-fts, engram-embed, vault (default: engram-fts plus engram-embed once the project's embedding index exists, else engram-fts only; vault is not queried unless named)"
            },
            "goal": {
              "type": "string",
              "description": "a goal id: return that goal's records (an Engram topic beginning goal:\u003cid\u003e/, a vault page tagged goal:\u003cid\u003e) and the records of no goal, leaving out other goals' (default: every record)"
            }
          },
